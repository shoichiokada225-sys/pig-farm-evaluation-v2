const CATALOG = {"works":[{"id":"feeding-daily","no":"No.11","name":"給餌","cat":"飼養管理","aspects":[{"id":"amount","name":"給与量の管理と個体・季節調整","kanten":"決められた給与量（不断給餌ではエサ箱の出量）を守りつつ、豚の状態や季節に応じて過不足なく調整できるか。","levels":["決められた量を守らず目分量で与え、豚の状態や季節の違いを考えずに一律に給餌する。","指示があれば決められた量を与えられるが、季節や個体差に応じた調整は他者まかせで、過不足が出やすい。","指示があれば決められた量を守り、暑い時期や豚の状態に応じてある程度の増減ができる。","指示がなくても食い込みや季節を見て量を細かく加減し、食下量の低下があれば原因を探って対応する。","給与量が発育・体調に与える影響を理解し、食い込み・季節・ステージに合わせて最適化し、調整の考え方を新人に指導できる。"]},{"id":"residue-water","name":"残餌と給水の確認","kanten":"残餌の有無・変質と、給水器の流量を毎回確認し、飲水不足や飼料ロスを防げるか。","levels":["残餌や給水器の不具合を確認せず、飼料ロスや飲水不足を放置する。高温期の変質・カビにも気づかない。","指示があれば残餌を片づけるが、給水器の流量確認や槽内飼料の傷みの点検に漏れが多い。","指示があれば残餌を確認して片づけ、給水器から水が出ているかを確かめられる。","指示がなくても毎回残餌の量と傷みを確かめ、給水器の流量を点検し、飲水不足による食い込み低下を防ぐ。","残餌量・飲水量を給餌量の見直しに結びつけ、高温期の変質対策まで判断し、確認の要点を新人に指導できる。"]},{"id":"feed-label","name":"飼料の種類・状態の確認と報告","kanten":"袋やタンクのラベルで飼料の種類を毎回確かめ、カビ・固まり・変なにおいと残量を点検して報告できるか。","levels":["ラベルを見ずに給餌し、カビや変なにおいのする飼料にも気づかず与えてしまう。","指示があればラベルを見るが、タンク内の変質や残量の点検に漏れが多い。","指示があればラベルで種類を確かめ、カビ・固まり・においの異常を見つけたら使わずにおける。","指示がなくても毎回ラベルと飼料の状態・タンク残量を確かめ、異常や残量不足をすぐ上司に報告する。","飼料の間違い・変質が発育不良や下痢につながることを理解し、確認の要点を新人に指導できる。"]},{"id":"intake-watch","name":"給餌後の食い込み観察","kanten":"配り終えた後5〜10分は食い込みを観察し、食べに来ない豚を耳標番号または豚房番号・マーキングで特定して報告できるか。","levels":["配り終えるとすぐ立ち去り、食べに来ない豚や動きのおかしい豚がいても気づかない。","指示されれば観察するが、時間が短く、個体の特定やメモをしないことが多い。","指示があれば給餌後5〜10分観察し、食べに来ない豚・元気のない豚に気づける。","指示がなくても毎回観察し、異常な個体を耳標番号または豚房番号・マーキングで特定してメモし、上司に報告する。","給餌が豚の体調を見る一番良い機会であることを理解し、観察の着眼点を新人に指導できる。"]},{"id":"record-biosec","name":"日報記入と豚舎間の防疫","kanten":"与えた量・残餌・異常を日報に記入し、豚舎を移る時は踏込消毒槽で長靴を消毒できるか。","levels":["日報を書かず、踏込消毒もせずに豚舎間を行き来する。","指示されれば記入・消毒するが、書き漏れや消毒の飛ばしが多い。","指示があれば与えた量・残餌・異常を日報に記入し、豚舎の出入りで踏込消毒ができる。","指示がなくても毎回もれなく記録し、こぼれた飼料の掃除と豚舎ごとの消毒・履き替えルールを守る。","エサ運びの移動が病気を運ぶ経路になることを理解し、記録と防疫の習慣を新人に指導できる。"]}]},{"id":"feed-adjust","no":"No.02","name":"エサ調整","cat":"飼養管理","aspects":[{"id":"stage-timing","name":"ステージ・時期に合わせた調整","kanten":"妊娠・泌乳などの生理ステージと正しい時期を見て、適切な段階で給与を変えられるか。","levels":["ステージや時期を考えず、いつも同じ与え方をする。切り替えの時期を外しても気にしない。","指示があれば切り替えられるが、ステージ移行の時期が遅れがちで、判断は他者まかせ。","指示があれば生理ステージに応じた時期にエサ量を切り替えられる。","指示がなくてもステージの移行を見越して適切な時期に調整し、増量中は餌残しに注意する。","不適切な時期の調整が逆効果になることを理解し、ステージごとに最適な時期と量を判断し、新人に指導できる。"]},{"id":"individual","name":"個体ごとの採食・残飼の確認","kanten":"給餌後に個体ごとの食べ方と残飼を確かめ、群飼で食べ負ける個体や量の過不足に気づけるか。","levels":["給餌後の食べ方を見ず、残飼があっても放置し、群飼で食べられていない母豚に気づかない。","指示があれば残飼を見るが、残飼をすぐ捨てず、群飼の順位の低い母豚の採食確認に漏れが多い。","指示があれば給餌後に食べ方を見回り、残飼を確認してすぐ捨てられる。","指示がなくても個体ごとの採食を確かめ、残す個体は体調不良・発情・量過多を疑い、すぐ完食して隣のエサを狙う個体は量不足を疑って報告する。","残飼が示すサインと群飼で食べ負ける母豚のリスクを理解し、採食確認の要点を新人に指導できる。"]},{"id":"gradual","name":"段階的な増減","kanten":"エサ量を急に変えず少しずつ増減し、急な変化による食欲低下を防げるか。","levels":["エサ量を一気に増減し、食欲低下を招いても気にしない。","指示があれば増減するが、変化幅が大きく食欲を落とすことがある。","指示があればエサ量を少しずつ増減できる。","指示がなくても食い込みを見ながら段階的に増減し、急な変化を避ける。","急な増減が消化器や食欲に与える影響を理解し、段階的な調整幅を判断して新人に指導できる。"]},{"id":"parity-season","name":"産次・季節への配慮","kanten":"産次の違いや夏季の食い込み低下を考え、量だけでなく回数や時間帯でも対応できるか。","levels":["産次の違いや季節を無視して与え、夏季の食い込み低下を量の増加だけで対応し残餌を増やす。","指示があれば産次や季節をある程度考えるが、多産系母豚の泌乳量増大への対応に漏れが多い。","指示があれば産次や季節を考えて量を調整できる。","指示がなくても産次差・多産系の泌乳量を考え、夏季は給与時間や回数を工夫して食下量を確保する。","産次・泌乳量・季節を総合して給与設計を最適化し、残餌を抑える工夫を新人に指導できる。"]},{"id":"bcs-palpation","name":"BCS触診と即時記録","kanten":"背骨に手を当てて押しBCSを触って判定し、結果と変更した量をその場で記録できるか。","levels":["目で見ただけで判断し、判定結果も給餌量の変更も記録に残さない。","指示があれば触って判定するが、採点にばらつきがあり、記録を後回しにして忘れる。","指示があれば背骨に沿って触ってBCSを1〜5で判定し、その場で記録できる。","指示がなくても触診で判定してBCS1などの深刻な個体をすぐ報告し、次にエサをやる人が同じ量を与えられる形で記録する。","被毛の厚い冬でも触診が必要な理由を理解し、判定の基準と記録の残し方を新人に指導できる。"]}]},{"id":"feed-recovery","no":"No.16","name":"エサ回収","cat":"飼養管理","aspects":[{"id":"spoilage","name":"変質餌の見分けと短時間回収","kanten":"カビ・腐敗した残餌を再利用せず、回収・保管を短時間で行い変質を防げるか。","levels":["カビや腐敗した残餌を再利用し、回収後も常温で長時間放置して変質させる。","指示があれば回収するが、変質の見分けが甘く、放置時間が長くなりがち。","指示があればカビ・腐敗した残餌を見分けて分け、短時間で回収できる。","指示がなくても変質を見分けて再利用せず、回収・保管を短時間で済ませる。","変質が病気・腐敗リスクにつながることを理解し、回収の手順を最適化して新人に指導できる。"]},{"id":"dedicated-tools","name":"専用容器・器具の管理","kanten":"回収用の容器・器具を専用にして洗い、他用途転用や豚房間共用による交差汚染を防げるか。","levels":["他用途のバケツを転用し、器具を豚房間で使い回して交差汚染・病原伝播を招く。","指示があれば専用容器を使うが、洗浄や豚房ごとの使い分けに漏れがある。","指示があれば回収用の専用容器・器具を使い、使用後に洗える。","指示がなくても専用容器を清潔に保ち、豚房間の共用を避けて交差汚染を防ぐ。","交差汚染・病原伝播の仕組みを理解し、容器・器具の管理ルールを新人に指導できる。"]},{"id":"trough-clean","name":"エサ箱の点検と毎日の清掃","kanten":"エサ箱の底が見えるかで残餌を判断し、すみに固まったエサをかき出して毎日きれいにできるか。","levels":["エサ箱の中を見ず、すみに固まったエサを残したまま放置する。","指示があれば清掃するが、すみや角の固まりのかき出しに取り残しが多い。","指示があれば底が見えるかで残餌の有無を判断し、固まりをブラシでかき出して清掃できる。","指示がなくても毎日エサ箱を点検・清掃し、水がかかって濡れ固まったエサを見つけたら取り除いて報告する。","取り残しがカビ・細菌のもとになり豚が食べなくなることを理解し、清掃の要点を新人に指導できる。"]},{"id":"residue-report","name":"残餌量の記録と給餌量への反映","kanten":"房番号と残餌量を記録して給餌担当に伝え、次回の給餌量見直しにつなげられるか。","levels":["残餌の量を記録せずただ捨てるだけで、給餌担当にも伝えない。","指示されれば記録するが、房番号や量があいまいで給餌量の見直しに使えない。","指示があれば房番号とおおよその量を記録し、給餌担当に伝えられる。","指示がなくても記録・報告し、残る房は次回10〜20%減の目安を踏まえて「残餌ゼロ」に近づける。","残餌が飼料コストと給餌設計を見直す情報であることを理解し、記録と伝え方を新人に指導できる。"]},{"id":"pig-sign","name":"残餌からの体調サイン察知","kanten":"残餌のある房の豚のようすを合わせて見て、体調不良やエサ不足のサインに気づけるか。","levels":["残餌を片づけるだけで、その房の豚のようすをまったく見ない。","指示されれば豚を見るが、体調不良とエサ不足の見分けは他者まかせ。","指示があれば残餌のある房の豚のようすを確かめ、気づいたことを伝えられる。","指示がなくても残る房は体調不良を、すぐ完食して隣のエサを狙う豚はエサ不足を疑って報告する。","「残餌は情報」という考え方を理解し、体調サインの読み方を新人に指導できる。"]}]},{"id":"nursing-feed","no":"No.43","name":"えつけ（哺乳期給餌）","cat":"飼養管理","aspects":[{"id":"gradual-lactation","name":"分娩後の段階的増給と暑熱対応","kanten":"分娩後は少量から段階的に増やし、暑熱時は回数を増やして食下量を確保できるか。","levels":["分娩後にいきなり多く与える、または暑熱時に回数を増やさず食下量を落とす。","指示があれば段階的に増やすが、暑熱時の回数調整や水の確保に漏れがある。","指示があれば分娩後は少量から段階的に増やし、水が飲める状態を保てる。","指示がなくても食い込みを見て段階的に増やし、暑熱時は回数を増やして食下量を確保する。","泌乳量と母豚の削痩・次回繁殖の関係を理解し、給餌設計を最適化して新人に指導できる。"]},{"id":"colostrum-balance","name":"産子数と乳頭数のバランス管理","kanten":"産子数と乳頭数の差を確認し、初乳未摂取子豚や泌乳不全乳頭を見落とさず対応できるか。","levels":["産子数と乳頭数の差を確認せず、初乳を飲めない子豚や泌乳不全の乳頭を放置する。","指示があれば確認するが、分割授乳や弱い子豚の固定に漏れが多い。","指示があれば産子数と乳頭数の差を確かめ、初乳を飲めていない子豚に気づける。","指示がなくても分割授乳を行い、泌乳不全乳頭や発育格差に気づいて弱い子豚を手当てする。","初乳・泌乳と発育格差の関係を理解し、里子や分割授乳の判断を最適化して新人に指導できる。"]},{"id":"water-first","name":"「エサの前に水」の飲水確認","kanten":"給餌前に必ずニップルを押して水を確かめ、週1回はカップで流量テストができるか。","levels":["飲水を確認せずにエサだけ与え、水が出ていなくても気づかない。","指示があれば確認するが、目視だけで済ませ、流量テストはしない。","指示があれば給餌前にニップルを指で押して水が出るか確かめられる。","指示がなくても「エサの前に水」を守り、週1回カップで流量（2L/分以上）を測って不足があれば報告する。","泌乳中の母豚は1日25〜30L飲み、水不足が泌乳量激減につながることを理解し、確認の習慣を新人に指導できる。"]},{"id":"residue-decide","name":"残飯チェックと給餌量の決定","kanten":"残飯を見てから今日の量を決める順番を守り、全く食べない母豚は検温して報告できるか。","levels":["残飯を見ずに惰性で同じ量を入れ、食べない母豚がいても放置する。","指示があれば残飯を見るが、古い残飯の上に新しいエサを足してしまうことがある。","指示があれば古い残飯を取り除いてから量を決め、給餌量と残飯を記録用紙に記入できる。","指示がなくても完食・残飯あり・食欲廃絶を見分けて量を加減し、食べない母豚は体温を測って39.5℃以上ならすぐ報告する。","「残飯チェック→給餌量決定」の順番の意味を理解し、量の決め方と報告の判断を新人に指導できる。"]},{"id":"creep-feed","name":"クリープフィードの管理","kanten":"生後5〜7日からひとつまみを与え、毎日全て交換して子豚の興味のようすを確かめられるか。","levels":["フィーダーに大量に入れっぱなしにし、カビたエサも交換しない。","指示があれば入れ替えるが、量が多すぎたり毎日の交換を忘れたりする。","指示があれば古いエサを全部出してフィーダーをきれいにし、新しいクリープフィードをひとつまみ入れられる。","指示がなくても毎日交換し、子豚が鼻でつつくかなど興味のようすを確かめて次の対応につなげる。","ひとつまみが「固形のエサも食べ物」と教えるための量だと理解し、えつけの進め方を新人に指導できる。"]}]},{"id":"grow-handover","no":"No.27","name":"育成受け","cat":"飼養管理","aspects":[{"id":"info-handover","name":"個体情報の引き継ぎ","kanten":"離乳日齢・頭数・処置やワクチンの記録・注意個体を、引き継ぎシートの書面で残して伝えられるか。","levels":["口頭だけで済ませて書面に残さず、注意個体の伝達漏れがあっても気にしない。","指示されれば伝えるが、処置記録や注意個体の項目が抜け、その場の読み合わせをしない。","指示があれば離乳日齢・頭数・処置やワクチンの記録・注意個体を引き継ぎシートに書いて伝えられる。","指示がなくても書面で引き継いでその場で読み合わせ、小さい子・下痢をしていた子・足を引きずる子を必ず書面に残す。","引き継ぎで漏れやすい情報を把握し、書面と読み合わせによる確実な引き継ぎの方法を新人に指導できる。"]},{"id":"receiving-env","name":"受入れ環境の事前確認と初期観察","kanten":"受入れ先の水・エサ・温度・群密度を事前に整え、受入後数日の採食・飲水を確認できるか。","levels":["洗浄・消毒や空舎期間を省き、前ロットのままの温度・換気で受け入れ、群密度過多も見落とす。","指示があれば環境を確認するが、受入後の採食・飲水の確認に漏れが多い。","指示があれば受入れ先の水・エサ・温度を事前に確かめられる。","指示がなくても洗浄・消毒・空舎期間をとり、群密度と受入後3日間の採食・飲水を確認する。","病原体持ち越しや群密度過多のリスクを理解し、受入れ環境づくりを最適化して新人に指導できる。"]},{"id":"grouping","name":"体重別グルーピングと弱小豚の別管理","kanten":"子豚を大・中・小に分け、群平均の70%以下の極端に小さい子豚を別管理にできるか。","levels":["体重差を見ずに全頭を同じ房に入れ、小さい子豚が衰弱しても気づかない。","指示があれば分けるが、基準があいまいで極端に小さい子豚を普通の群に入れてしまう。","指示があれば体重や目視で大・中・小に分け、極端に小さい子豚を見分けられる。","指示がなくてもグルーピングを行い、群平均の70%以下の子豚は別管理にして衰弱を防ぐ。","弱い子豚が普通の群ではエサにありつけない仕組みを理解し、分け方の基準を新人に指導できる。"]},{"id":"move-count","name":"安全な移動と頭数照合","kanten":"カートで無理のない頭数を安全に運び、入舎後に頭数を数えて引き継ぎ情報と照合できるか。","levels":["一度に大量に運んで落とす・挟むの危険を招き、入舎後の頭数も数えない。","指示があれば運べるが、頭数の照合やプレートへの記入に漏れが多い。","指示があれば無理のない頭数で運び、入舎後に頭数を数えてプレートに記入できる。","指示がなくても季節に応じた時間帯・経路で安全に移動し、数が合わなければその場で分娩舎に確認する。","移動時の事故と頭数の食い違いが後の管理を狂わせることを理解し、移動と照合の段取りを新人に指導できる。"]},{"id":"teach-water-feed","name":"飲水・エサの教え込み","kanten":"全頭が水を飲めるか1頭ずつ確かめ、少量のスターターでエサの場所を教えられるか。","levels":["水を飲めない子豚を放置し、エサを一度に大量に入れて腐らせる。","指示があれば確認するが、1頭ずつの飲水確認や食べやすくする工夫に漏れがある。","指示があれば1頭ずつ飲水を確かめ、エサ箱に少量のスターターを入れて場所を教えられる。","指示がなくても飲めない子豚にはニップルを押して水を出して見せ、初日はおかゆ状にするなど食べやすく整える。","入舎直後の脱水と食べ残しの腐敗が下痢につながることを理解し、教え込みのコツを新人に指導できる。"]}]},{"id":"castration","no":"No.34","name":"去勢","cat":"飼養管理","aspects":[{"id":"age-method","name":"日齢・方法の遵守と短時間実施","kanten":"決められた日齢・方法で、子豚に無理をさせず短時間で去勢できるか。","levels":["日齢や方法を守らず、生後7日を過ぎてから雑に行い、子豚に長く無理をさせる。","指示があれば実施できるが、日齢の判断や手早さに欠け、ストレスをかけがち。","指示があれば決められた日齢・方法でひと通り去勢できる。","指示がなくても適期を見て短時間で行い、子豚への負担を抑える。","日齢超過がストレス・出血を増やすことを理解し、適期と手技を新人に指導できる。"]},{"id":"asepsis-aftercare","name":"清潔な器具と術後の確認","kanten":"器具を1頭ごとに消毒し、術後の切り口の処置と出血・腫れ・元気の確認ができるか。","levels":["器具を1頭ごとに消毒せず使い回し、術後の切り口処置や観察を怠り腹膜炎・感染を招く。","指示があれば消毒するが、術後の消毒薬塗布や観察に漏れが多い。","指示があれば清潔な器具を使い、術後の出血・腫れ・元気をひと通り確認できる。","指示がなくても1頭ごとに器具を消毒し、切り口を処置して術後の観察頻度を増やす。","感染・合併症の仕組みを理解し、無菌操作と術後管理を新人に指導できる。"]},{"id":"restraint-safety","name":"保定と刃物の安全","kanten":"子豚を仰向けにしっかり保定し、刃を人に向けず、暴れたら保定し直してから切れるか。","levels":["保定が不十分なまま切ろうとし、刃の向きや使い終わった刃の処理も気にしない。","指示があれば保定できるが、固定が甘く、子豚が暴れても無理に続けることがある。","指示があれば仰向けにしっかり保定し、暴れたら切らずに保定し直せる。","指示がなくても刃を自分や補助者に向けない・使い終わった刃は医療ゴミへ、などの安全を守って補助者と連携する。","保定のコツと刃物事故の防ぎ方を理解し、見学・保定係から段階を踏ませて新人に指導できる。"]},{"id":"complete-check","name":"左右摘出の確認とヘルニア対応","kanten":"左右2つの精巣を取り出せたか必ず確かめ、陰嚢がふくらんだ子豚は切らずに報告できるか。","levels":["摘出の確認をせず、陰嚢が大きくふくらんだ子豚もそのまま切ってしまう。","指示があれば確認するが、取り残しやヘルニア疑いの見分けが不確実。","指示があれば左右2つとも取り出せたことを確認し、陰嚢のふくらみに気づける。","指示がなくても毎頭確認し、ヘルニア疑いの子豚は自分で切らず必ず指導係に報告する。","取り残しが腫れ・雄臭の原因になることを理解し、確認とヘルニアの見分け方を新人に指導できる。"]},{"id":"season-record","name":"季節への配慮と処置記録","kanten":"夏は早朝に行いハエに注意し、冬は処置後すぐ保温灯へ戻し、処置の記録と片づけができるか。","levels":["暑い時間帯に行って子豚に負担をかけ、処置の記録も片づけもしない。","指示があれば対応するが、保温灯へ戻すのが遅れたり記録に漏れが多い。","指示があれば季節の注意を守って実施し、処置の記録と医療ゴミの片づけができる。","指示がなくても夏は早朝の段取りを組み、冬は道具を先にそろえて保温灯から離す時間を最短にし、記録を残す。","季節ごとのリスク（ハエ・ウジ・凍傷）を理解し、段取りと記録の残し方を新人に指導できる。"]}]},{"id":"additive","no":"No.18","name":"添加剤準備","cat":"飼養管理","aspects":[{"id":"dosage-mix","name":"正確な計量と混合","kanten":"ラベルの対象・添加量を守り、正確に計量してムラなく混合できるか。","levels":["計量器を確かめず目分量で入れ、混合手順を省いてムラを出す。","指示があれば計量するが、秤のゼロ調整（風袋引き）や量った数値の声出し確認に漏れがある。","指示があればラベルの添加量に従って計量し、ひと通り混合できる。","指示がなくても計量器を確かめて正確に計り、指示された方法でムラなく混合し、計量後すぐ容器にラベルを貼る。","計量誤差・混合ムラが成績に与える影響を理解し、正確な準備手順を新人に指導できる。"]},{"id":"antibacterial","name":"抗菌性添加物の休薬管理","kanten":"休薬期間のある添加剤について、投与開始日・終了日を記録し、出荷予定日と照らして休薬を管理できるか。","levels":["休薬期間のある添加剤の投与開始日・終了日を記録せず、出荷予定日とも照らさず、残留リスクを招く。","指示があれば注意するが、投与開始日・終了日の記録や出荷予定日との照合に漏れが多い。","指示があれば休薬期間のある添加剤の投与開始日・終了日を記録できる。","指示がなくても投与開始日・終了日を記録し、出荷予定日と照らして休薬を管理する。","残留リスクと休薬の意味を理解し、抗菌性添加物の管理ルールを新人に指導できる。"]},{"id":"instruction-verify","name":"指示・ラベル・状態の照合","kanten":"「どの豚群に・何を・どれだけ」の3点と対象家畜・有効期限・中身の状態を確かめてから始められるか。","levels":["指示書やラベルを確かめずに始め、期限切れや固まった添加剤も使ってしまう。","指示があれば確認するが、対象ステージや有効期限の見落としが多い。","指示があれば3点とラベルの対象家畜・添加量を照合し、異常品を使わずにおける。","指示がなくても毎回照合し、1つでも分からなければ始めずに責任者に聞き、異常品は分けて報告する。","対象家畜違い・変質品を使うリスクを理解し、作業前の照合手順を新人に指導できる。"]},{"id":"ppe-dust","name":"防護具と粉のあつかい","kanten":"マスク・手袋（必要なら防護メガネ）を着け、こぼした粉をすぐ片づけ、作業後に手を洗えるか。","levels":["防護具を着けずに粉を吸い込み、こぼした粉も放置する。","指示があれば着けるが、防護メガネの使い分けや作業後の手洗いを忘れがち。","指示があればマスク・手袋を着けて作業し、こぼした粉を片づけられる。","指示がなくても薬剤に応じて防護具を選び、粉を舞わせない扱いと石けんでの手洗いを徹底する。","粉じんの吸入や薬剤付着のリスクを理解し、防護のルールを新人に指導できる。"]},{"id":"mixup-storage","name":"取り違え防止と保管・器具清掃","kanten":"計量した容器に豚群名・剤名・量のメモをはり、計量後すぐラベルを貼って保管し、器具に粉を残さないか。","levels":["表示のない粉を平気で使い、袋を開けっぱなしにし、器具に粉が残ったまま次に使う。","指示があればメモをはるが、ラベル貼りや保管場所への戻しに漏れが多い。","指示があればメモをはって管理し、袋の口を閉じて決められた場所に戻し、器具を掃除できる。","指示がなくても書いていない粉は使わず、直射日光と湿気を避けて保管し、器具の粉残りをゼロにする。","白い粉の取り違えと前の添加剤の混入リスクを理解し、表示・保管・清掃のルールを新人に指導できる。"]}]},{"id":"feed-adjust-fin","no":"","name":"エサ調整（肥育）","cat":"飼養管理","aspects":[{"id":"feeder-spill","name":"エサ箱の出量調整とこぼれの確認","kanten":"エサ箱の飼料の出量を見て、床へのこぼれや詰まりがないように、多すぎず少なすぎない量へ調整できるか。","levels":["エサ箱を見ず、飼料が床にこぼれていても、詰まっていても放置する。","指示があればエサ箱を見るが、こぼれや詰まりに気づくのが遅く、調整は他者まかせ。","指示があればエサ箱の出量を調整し、床へのこぼれや詰まりがないか確認できる。","指示がなくても毎回の給餌でこぼれ・詰まり・出量不足（空腹）を見つけ、その場で出量を調整する。","こぼれが飼料のムダと飼料効率の悪化につながることを理解し、エサ箱の調整の要点を新人に指導できる。"]},{"id":"feed-switch","name":"飼料の切り替えと段階的な混合","kanten":"体重帯に合った飼料を間違えずに使い、切り替えを5〜7日かけて旧飼料と新飼料を混ぜて進め、その間の糞を確かめられるか。","levels":["飼料の種類や体重帯を確かめず、急に切り替えて、糞の状態も見ない。","指示があれば飼料を切り替えるが、混ぜる割合や日数を守れず、糞の確認も漏れる。","指示があれば飼料を間違えずに使い、5〜7日かけて旧飼料の割合を減らしながら切り替えられる。","指示がなくても体重帯に合った飼料かを確かめ、段階的に混ぜて切り替え、下痢が出たら切り替えを遅くして報告する。","急な切り替えが消化不良と下痢につながることを理解し、体重帯ごとの飼料と混合の手順を新人に指導できる。"]},{"id":"feeder-line","name":"自動給餌器・配管・飼料タンクの点検","kanten":"自動給餌器の出量とセンサー、配管の詰まり、飼料タンクの残量とブリッジ、飼料の変色・カビ・異臭を確かめられるか。","levels":["自動給餌器・配管・タンクを見ず、詰まりや飼料切れ、カビが出ても気づかない。","指示があれば点検するが、タンクの残量確認やブリッジの見落としが多く、異常は他者に見つけてもらう。","指示があれば自動給餌器の出量とセンサー、配管の詰まり、タンクの残量を確認できる。","指示がなくても毎日、出量・センサー・配管・タンク残量を確かめ、飼料が出ない時はブリッジを疑い、変色・カビ・異臭を見つけて報告する。","飼料切れが成長停止や尾かじりにつながることを理解し、残量が農場で決めた発注点になったら発注するなど、点検の要点を新人に指導できる。"]},{"id":"eating-observe","name":"食い込みの観察と環境要因の確認","kanten":"給餌のたびに豚の集まりとエサ箱の食べ残しを見て、特定の豚房だけ食い込みが悪い時に温度・飲水・密度を確かめられるか。","levels":["給餌しても豚の集まりや食べ残しを見ず、食い込みが悪い豚房があっても気づかない。","指示があれば食べ残しを見るが、豚房ごとの違いに気づくのが遅く、原因の確認は他者まかせ。","指示があれば豚がエサ箱に集まるか、底が見えるまで食べているかを確認できる。","指示がなくても豚房ごとの食い込みを見分け、悪い豚房では温度・飲水・密度を確かめて、気づいたことを報告する。","暑さや水不足、過密が食欲を落とすことを理解し、食い込みから群の異常を早く見つける見方を新人に指導できる。"]},{"id":"adjust-record","name":"調整の記録と休薬期間の確認・報告","kanten":"飼料の切り替えや出量の調整を記録し、休薬期間のある飼料は分からない時に確認して、異常を上長に報告できるか。","levels":["調整や切り替えを記録せず、休薬期間が分からなくても確認しないまま与える。","指示があれば記録するが、記録が抜けやすく、休薬期間の確認や異常の報告は他者まかせ。","指示があれば切り替えと出量の調整を記録し、休薬期間は飼料のラベルや添付文書で確認できる。","指示がなくても切り替え日・飼料の種類・タンク在庫を記録し、休薬期間が不明な時は必ず確認してから与え、異常はすぐ報告する。","休薬期間を守ることが法的義務であり、出荷停止につながることを理解し、記録と確認の手順を新人に指導できる。"]}]},{"id":"dung-removal","no":"No.12","name":"除フン","cat":"衛生管理","aspects":[{"id":"order","name":"除糞→洗浄→消毒の順序","kanten":"先に糞を取り除いてから洗浄・消毒する順序を守り、汚れの上から消毒しないか。","levels":["汚れが残ったまま消毒し、順序を守らず効果を半減させても気にしない。","指示があれば糞を取るが、洗浄・消毒の順序や仕上がりの確認に漏れが多い。","指示があれば先に糞を取り、その後に洗浄・消毒する順序をひと通り守れる。","指示がなくても順序を守り、汚れが残ると消毒が効かないことを踏まえて確実に除糞する。","汚れと消毒効果の関係を理解し、決められた頻度・タイミングと順序を新人に指導できる。"]},{"id":"underfloor","name":"床下・ピット・残渣の確認","kanten":"床下やピットまで定期的に確認し、スクレーパー動作後の残渣を目視で確かめられるか。","levels":["床下・ピットを確認せず、スクレーパー後の残渣も見ずに次工程へ進む。","指示があれば見えるところは確認するが、床下・ピットの点検に漏れが多い。","指示があれば床下やピットをひと通り確認できる。","指示がなくても床下・ピットを定期的に確認し、スクレーパー後の残渣を目視で確かめる。","残渣滞留のリスクを理解し、見落としやすい箇所の点検を新人に指導できる。"]},{"id":"dung-observation","name":"糞の観察と異常便の即報告","kanten":"糞の色・かたさを見て、血便・水様下痢・黒色便などを豚房番号つきですぐ報告できるか。","levels":["糞を見ずに掃除だけで終わらせ、血便や下痢があっても気づかず放置する。","指示されれば糞を見るが、異常便の見分けや豚房番号の記録に漏れが多い。","指示があれば糞の色・かたさを確認し、異常便を見つけたら豚房番号を控えて報告できる。","指示がなくても除フンを健康チェックととらえ、血便・水様下痢・黒色便を早期に見つけて即報告する。","正常便と異常便の見分けと報告の優先度を理解し、「迷ったら報告」の姿勢を新人に指導できる。"]},{"id":"pit-scraper-safety","name":"ピット・除糞機の安全確保","kanten":"ピットをのぞきこまず、自動スクレーパーには電源を切り周囲へ声かけしてから近づけるか。","levels":["動いているスクレーパーに近づき、ピットの中をのぞきこむなど危険な行動を平気でする。","指示があれば注意するが、電源の切り忘れや周囲への声かけを忘れることが多い。","指示があれば電源を切ってから点検し、ピットに入らない決まりをひと通り守れる。","指示がなくても電源を切って周囲に声をかけ、ピットの有害ガスを踏まえて絶対に立ち入らない。","巻き込まれ事故と有害ガス・救助の二次被害の危険を理解し、安全手順を新人に指導できる。"]},{"id":"tool-dedicated","name":"豚舎専用道具の管理","kanten":"道具をその豚舎専用で使い、作業後に洗って同じ豚舎の置き場へ戻し、持ち出さないか。","levels":["道具を洗わず放置し、他の豚舎へ平気で持ち出して病原体を運ぶ危険を作る。","指示があれば片づけるが、道具の洗浄や専用ルールの徹底に漏れが多い。","指示があれば道具を洗い、同じ豚舎の置き場にひと通り戻せる。","指示がなくても専用道具のルールを守り、洗浄して定位置に戻し、破損に気づけば報告する。","道具の共用が病原体を運ぶ仕組みを理解し、豚舎専用管理の徹底を新人に指導できる。"]}]},{"id":"five-s","no":"No.31","name":"5S清掃","cat":"衛生管理","aspects":[{"id":"fixed-place","name":"定位置管理の徹底","kanten":"物の置き場所を決めて守り、使った物を元の場所に戻せるか。","levels":["置き場所を決めず、使った物を元に戻さないまま放置する。","指示があれば片づけるが、元の場所に戻さないことが多い。","指示があれば決められた置き場所に物を戻せる。","指示がなくても定位置を守り、乱れがあれば自分で整える。","定位置管理がミス削減につながることを理解し、置き場所のルールづくりを新人に指導できる。"]},{"id":"standard-abnormal","name":"きれいさの基準共有と異常発見","kanten":"「基準のきれいさ」を共有し、清掃を形式で終わらせず設備の異常発見につなげられるか。","levels":["基準があいまいで人により差が出て、チェックリストを形式的に埋めるだけで異常に気づかない。","指示があれば清掃するが、基準の共有や異常発見への意識が薄い。","指示があれば仕上がりを基準の写真と見比べ、決めた基準に沿ってひと通り清掃できる。","指示がなくても基準のきれいさを意識し、清掃しながら設備トラブルの兆候に気づく。","5Sを異常の早期発見に結びつけ、基準の共有と継続の仕組みを新人に指導できる。"]},{"id":"sort-discard","name":"整理（不要物の処分判断）","kanten":"不要物を見つけて処分し、捨てていいか迷う物は自己判断せず先輩に確認できるか。","levels":["不要物が放置されていても気にせず、必要な物を自己判断で勝手に捨てることもある。","指示があれば不要物を捨てるが、見て回りに漏れが多く、迷う物の確認をしない。","指示があれば通路や豚舎を見て回って不要物を処分し、迷う物は先輩に確認できる。","指示がなくても不要物に気づいて処分し、判断に迷う物は必ず確認してから捨てる。","整理が作業性と衛生の土台になることを理解し、要・不要の判断基準を新人に指導できる。"]},{"id":"priority-spots","name":"汚れやすい場所の重点清掃","kanten":"排水口・餌箱の裏・飲水器の下を重点的に清掃し、排水口の詰まりを取り除けるか。","levels":["見えやすい所だけ掃き、排水口や餌箱の裏の飼料カス・糞を残したまま終える。","指示があれば掃除するが、餌箱の裏側や排水口の詰まり確認に漏れが多い。","指示があれば排水口・餌箱まわり・飲水器の下をひと通り重点清掃できる。","指示がなくても汚れやすい場所を重点的に清掃し、排水口の詰まりを見つけて取り除く。","飼料カスがハエの発生源、詰まりが病原体の温床になることを理解し、重点箇所を新人に指導できる。"]},{"id":"honest-checklist","name":"チェックリストの正直な記録","kanten":"実際に清掃した場所だけをチェックリストに記録し、やっていない所にチェックを入れないか。","levels":["やっていない場所にもチェックを入れ、記録上「完了」でも実態が伴わない。","指示されれば記録するが、記入漏れや実施とのずれが多い。","指示があれば実際にやった場所だけをチェックリストにひと通り記録できる。","指示がなくても実施内容を正確に記録し、できなかった場所は理由とあわせて引き継ぐ。","形式的なチェックが問題の見逃しを生むことを理解し、正直な記録の意味を新人に指導できる。"]}]},{"id":"treatment","no":"No.04","name":"治療","cat":"衛生管理","aspects":[{"id":"withdrawal","name":"休薬期間の確認と治療豚の識別","kanten":"使用薬剤の休薬期間を確認し、治療豚を確実に識別して出荷から除外できるか。","levels":["休薬期間を確認せず、治療豚の識別もあいまいで、休薬中の豚を誤って出荷する危険がある。","指示があれば休薬を確認するが、治療豚の識別や記録に漏れが多い。","指示があれば休薬期間を確認し、治療豚を識別してひと通り管理できる。","指示がなくても休薬期間を必ず確認し、治療豚を明確に識別して出荷から除外する。","残留違反の重大さを理解し、休薬管理と個体識別の仕組みを新人に指導できる。"]},{"id":"protocol","name":"指示・用法の遵守と針の本数管理","kanten":"決められたやり方・指示を守り、注射針の本数を管理して紛失・混入を防げるか。","levels":["自己判断でやり方を変え、注射針の本数管理もせず紛失・混入の危険を放置する。","指示があれば従うが、用法の徹底や針の本数確認に漏れがある。","指示があれば決められたやり方・指示に従い、針の本数をひと通り確認できる。","指示がなくても用法を守り、注射針の本数管理を徹底して紛失・混入を防ぐ。","自己判断で薬ややり方を変える危険と針混入の重大さを理解し、正しい治療手順を新人に指導できる。"]},{"id":"identify-track","name":"治療記録のその場記入","kanten":"「いつ・どの豚に・何の薬を・どれだけ・誰が」を後回しにせず、その場で記録簿に書けるか。","levels":["治療しても記録を書かず、後から投薬経過を追えない状態にする。","指示されれば記録するが、後回しにして薬剤名・投与量・日付の記入漏れが多い。","指示があれば「いつ・どの豚に・何の薬を・どれだけ・誰が」をひと通り記録できる。","指示がなくても治療したその場で漏れなく記録し、記入漏れに気づけば自分で確かめて直す。","後書きが記入漏れを生み休薬管理・治療評価を狂わせることを理解し、その場記録を新人に指導できる。"]},{"id":"early-detect","name":"体調不良豚の発見と報告","kanten":"食欲・耳の垂れ・動き・呼吸・糞のサインで不調豚を見つけ、耳標番号を控えて報告できるか。","levels":["体調不良のサインに気づかず見過ごし、見つけても報告せず自分の判断で薬を使おうとする。","指示されれば豚を見るが、サインの見落としが多く、耳標番号の控えや報告が不確実。","指示があれば不調のサインを確認し、迷ったら体温を測って耳標番号とともに報告できる。","指示がなくても見回りで不調豚を早期に見つけ、耳標番号・症状を控えて報告し治療指示を受ける。","早期発見が治療成績を左右することを理解し、体調不良のサインの見方を新人に指導できる。"]},{"id":"isolation-order","name":"隔離と感染拡大防止の作業順","kanten":"重症・下痢の豚を隔離し、世話は健康豚の後に回し、病豚に触れた後は手指消毒できるか。","levels":["病豚と健康豚を区別せずに触り、隔離もせず感染を広げる危険を放置する。","指示があれば隔離するが、作業順や手指消毒の徹底に漏れが多い。","指示があれば病豚を隔離ペンに移し、健康豚の後に世話をする順序をひと通り守れる。","指示がなくても隔離と作業順を守り、病豚に触れた後は手指消毒してから健康豚に触る。","作業順と手指消毒が感染拡大を防ぐ理由を理解し、病豚の扱い方を新人に指導できる。"]}]},{"id":"sow-vaccine","no":"No.06","name":"母豚ワクチン接種","cat":"衛生管理","aspects":[{"id":"schedule","name":"日齢・スケジュールの遵守","kanten":"決められた日齢・スケジュールで確実に接種し、打ち漏れを作らないか。","levels":["スケジュールを守らず、自分の判断で接種日を前後させて免疫を不十分にする。","指示があれば接種するが、対象や時期の確認に漏れがある。","指示があれば決められた日齢・スケジュールでひと通り接種できる。","指示がなくてもスケジュール表で対象と時期を確認して接種し、打ち漏れを防ぐ。","早すぎても遅すぎても効かないことを理解し、スケジュール管理を新人に指導できる。"]},{"id":"vaccine-handling","name":"ワクチンの取り扱いと針交換","kanten":"生ワクチンは溶解後すぐ使い切り、不活化は当日中に使い、針を頭ごとに交換できるか。","levels":["溶解後の保管時間を超過し、注射針を使い回して感染リスクを高める。","指示があれば取り扱うが、使い切りの時間管理や針交換に漏れがある。","指示があれば生ワクチンを溶解後すぐ使い、針をひと通り交換できる。","指示がなくても溶解後の時間を守って使い切り、針を頭ごとに交換する。","ワクチンの失活や針使い回しのリスクを理解し、正しい取り扱いを新人に指導できる。"]},{"id":"condition-check","name":"対象母豚の体調確認と接種可否","kanten":"接種前に1頭ずつ体調を見て、発熱・食欲不振・下痢の母豚はリストから外して報告できるか。","levels":["体調を見ずに全頭へ打ち、明らかに具合の悪い母豚にも接種してしまう。","指示があれば体調を見るが、確認が形式的でリストから外す判断や報告を他者まかせにする。","指示があれば対象を1頭ずつ確認し、体調不良の母豚を外して上長に報告できる。","指示がなくても接種前の体調確認を欠かさず、外した母豚の回復後の接種まで気を配る。","体調不良時の接種が免疫と母豚に及ぼす影響を理解し、接種可否の見極めを新人に指導できる。"]},{"id":"injection-site","name":"接種部位と保定・注入手技","kanten":"耳の付け根の後ろの首の筋肉へ90度で素早く刺してゆっくり注入し、無理な保定をしないか。","levels":["腰やお尻に打つ・浅く刺すなど部位と手技が不正確で、動く母豚に無理をして危険を作る。","指示があれば打てるが、刺す角度や部位が安定せず、母豚が動いた時の対応が不確実。","指示があれば首の筋肉に90度で刺してゆっくり注入し、落ち着いた時をねらってひと通り接種できる。","指示がなくても正しい部位・角度を守り、母豚が動いたら手を止め、危ない時は2人や保定具で安全に行う。","浅打ちで効果が落ちる理由と針刺し事故の危険を理解し、部位と保定のコツを新人に指導できる。"]},{"id":"record-observe","name":"その場での記録と接種後の観察","kanten":"個体番号・ワクチン名・ロット・量をその場で記録し、接種後30分〜1時間の異常を観察できるか。","levels":["記録を後回しにして漏らし、接種後の豚も見ずに立ち去る。","指示されれば記録するが、ロット番号などの記入漏れが多く、接種後の観察も不十分。","指示があれば打ったその場で記録し、接種後のぐったり・呼吸困難がないかひと通り観察できる。","指示がなくてもその場で漏れなく記録し、アナフィラキシーの兆候や40℃以上の高熱を見つけたらすぐ連絡する。","後書きが二重接種・打ち漏れを生むことと副反応の見分けを理解し、記録と観察を新人に指導できる。"]}]},{"id":"csf-vaccine","no":"No.41","name":"CSF（豚熱）子ワクチン接種","cat":"衛生管理","aspects":[{"id":"maternal-antibody","name":"移行抗体を考えた接種日齢","kanten":"移行抗体を考慮し、決められた日齢で接種して免疫獲得の失敗を防げるか。","levels":["移行抗体を考えず、抗体の高い時期に接種して免疫獲得を失敗させる。","指示があれば接種するが、対象の日齢確認に漏れがあり、日をずらすことの影響を知らない。","指示があれば決められた日齢でひと通り接種できる。","指示がなくても移行抗体を考えた日齢で接種し、確実な免疫獲得を意識する。","移行抗体が残るうちに打つと効かないことを理解し、決められた日齢を守る理由を新人に指導できる。"]},{"id":"no-miss","name":"全頭接種と記録","kanten":"「寄せる→打つ→印→反対側→頭数照合」を守り、打ち漏れなく全頭接種して記録を残せるか。","levels":["子豚を寄せずに打ち始め、マーキングも頭数照合もせず「たぶん打った」で先に進む。","指示があれば接種するが、マーキングや豚房ごとの頭数照合に漏れが多い。","指示があれば寄せる→打つ→印→反対側→照合の流れをひと通り守り、記録できる。","指示がなくても毎豚房で流れを徹底し、数が合わなければ全頭を見直して印のない豚を探して打つ。","打ち漏れが防疫上の穴になることを理解し、全頭接種の流れと記録の徹底を新人に指導できる。"]},{"id":"restraint-team","name":"保定・連携と確実な筋注","kanten":"両後脚で保定し、2人1組の声かけで連携して、首の筋肉へ90度で確実に接種できるか。","levels":["片脚で持ち上げる・無理に押さえて暴れさせるなど危険な保定をし、浅く刺して筋肉に届かない。","指示があれば保定・接種するが、声かけや役割分担が不十分で、部位や角度が安定しない。","指示があれば両後脚で頭を下に保定し、耳の付け根の後ろの首の筋肉へ90度でひと通り接種できる。","指示がなくても保定係・接種係で声をかけ合い、豚が暴れたら仕切り直して安全・確実に筋注する。","片脚保定が関節を痛めることと浅打ちのリスクを理解し、保定と連携のコツを新人に指導できる。"]},{"id":"needle-mgmt","name":"針の本数照合・交換・針刺し対応","kanten":"針の本数を作業前後で照合し、1腹ごとに交換し、針折れ・針刺し時に正しく対応できるか。","levels":["本数を数えず古い針を使い続け、リキャップするなど針折れ・針刺しの危険を放置する。","指示があれば数えるが、照合や1腹ごとの交換、シャープスコンテナへの廃棄に漏れがある。","指示があれば本数を記録・照合し、1腹ごとに交換してシャープスコンテナにひと通り廃棄できる。","指示がなくても本数管理を徹底し、針折れ疑いはその豚に印をつけて即報告、針刺し時は流水で洗って報告する。","針残留が食肉混入の重大事故になることを理解し、本数管理と事故対応を新人に指導できる。"]},{"id":"cold-chain","name":"ワクチンの冷蔵管理と品質確認","kanten":"2〜8℃の冷蔵保管を守り、期限切れ・変色・沈殿のあるワクチンは使わず報告できるか。","levels":["常温に放置したり期限や外観を見ずに使い、効かないワクチンを打つ危険を作る。","指示があれば冷蔵庫から出し入れするが、期限・変色・沈殿の確認に漏れが多い。","指示があれば使用直前に取り出し、薬品名・期限・外観をひと通り確認して使える。","指示がなくても冷蔵管理を守り、異常のあるワクチンは使わずに報告して交換する。","温度逸脱で失活する仕組みを理解し、冷蔵管理と品質確認の要点を新人に指導できる。"]}]},{"id":"washing","no":"No.40","name":"洗浄（離乳後）","cat":"衛生管理","aspects":[{"id":"wash-order","name":"除糞→洗浄→乾燥→消毒の順序","kanten":"除糞→洗浄→乾燥→消毒の決められた順序を守り、有機物を残したまま消毒しないか。","levels":["有機物が残った状態で消毒薬を散布し、乾燥不十分のまま次ロットを入れる。","指示があれば洗浄するが、順序や乾燥の徹底に漏れが多い。","指示があれば除糞→洗浄→乾燥→消毒の順序をひと通り守れる。","指示がなくても順序を守り、有機物を落としてから消毒し、十分に乾燥させる。","有機物残存が消毒を無効化することを理解し、洗浄・乾燥の徹底を新人に指導できる。"]},{"id":"hidden-spots","name":"隅・溝・裏側の重点洗浄","kanten":"隅・溝・エサ箱・スノコ裏など汚れが溜まりやすい見えにくい場所を重点的に洗えるか。","levels":["見えやすい所だけ洗い、隅・溝・スノコ裏などの汚れを残す。","指示があれば洗うが、見えにくい場所の洗浄に漏れが多い。","指示があれば汚れが溜まりやすい場所をひと通り洗える。","指示がなくても隅・溝・スノコ裏まで重点的に洗い、汚れを残さない。","見えにくい場所の病原残存リスクを理解し、重点洗浄の着眼点を新人に指導できる。"]},{"id":"allout-safety","name":"オールアウト確認と洗浄時の安全","kanten":"豚が1頭も残っていないことを記録と突き合わせ、電源を切りノズルを人に向けず作業できるか。","levels":["豚の残留を確かめずに洗い始め、回っているファンに水をかけたりノズルを人に向けたりする。","指示があれば確認するが、記録との突き合わせや電源の切り忘れが多い。","指示があれば全豚房を歩いて残留ゼロを確かめ、電源を切り防護具を着けてひと通り作業できる。","指示がなくてもオールアウトを記録と照合してから始め、感電・高圧水の危険を避けて安全に洗う。","高圧水が皮膚を切る力を持つことと感電の危険を理解し、洗浄の安全手順を新人に指導できる。"]},{"id":"soak-rinse","name":"洗浄剤の浸漬と完全すすぎ","kanten":"洗浄剤を規定濃度で20〜30分浸漬させ、すすぎ後に白い紙で汚れ残りを確認できるか。","levels":["浸漬を待たずに洗い始め、すすぎも不十分で洗剤や汚れを残したまま終える。","指示があれば洗浄剤を使うが、浸漬時間の確保やすすぎの徹底に漏れが多い。","指示があれば規定濃度で浸漬させ、すすいだ後に白い紙でひと通り確認できる。","指示がなくても浸漬時間を確保して効率よく洗い、紙に汚れが付けばもう一度洗い直す。","浸漬が汚れを浮かせる仕組みと残留洗剤が子豚に害になることを理解し、確認法を新人に指導できる。"]},{"id":"dry-next-lot","name":"乾燥時間の確保と次ロット準備","kanten":"洗浄後・消毒後の乾燥時間を確保し、温度設定・飲水器・保温灯を確認して受け入れ準備できるか。","levels":["乾燥を待たずに次工程へ進み、次ロットの準備もせずに子豚を迎えさせる。","指示があれば乾燥させるが、時間の確保や飲水器・保温灯の確認に漏れが多い。","指示があれば決められた乾燥時間を確保し、温度・飲水・保温灯をひと通り確認できる。","指示がなくても季節に応じて乾燥時間を延ばし、換気で乾燥を早め、受け入れ準備の不備を直す。","湿ったままの消毒が効かない理由と空舎期間の意味を理解し、乾燥と準備の要点を新人に指導できる。"]}]},{"id":"disinfect","no":"No.15","name":"消毒","cat":"衛生管理","aspects":[{"id":"concentration","name":"濃度・量・接触時間の遵守","kanten":"決められた濃度・量・接触時間を守り、目分量の希釈をしないか。","levels":["希釈濃度を目分量で調整し、接触時間も守らず規定を外す。","指示があれば希釈するが、濃度や接触時間の管理に漏れが多い。","指示があれば決められた濃度・量・接触時間をひと通り守れる。","指示がなくても正確に希釈し、接触時間を確保してから乾燥させる。","薬剤ごとの特性と濃度・接触時間の意味を理解し、正しい消毒を新人に指導できる。"]},{"id":"clean-first-ppe","name":"汚れ除去の徹底と防護具着用","kanten":"汚れを先に落としてから消毒し、防護マスク・ゴーグルを着けて曝露を防げるか。","levels":["有機物が残った面に散布して消毒剤を不活化させ、防護具も着けず薬剤に曝露する。","指示があれば汚れを落とすが、防護具の着用や汚れ除去の徹底に漏れがある。","指示があれば汚れを落としてから消毒し、防護具をひと通り着用できる。","指示がなくても汚れを確実に落としてから消毒し、防護具を着けて安全に作業する。","有機物による不活化と薬剤曝露の危険を理解し、汚れ除去と防護の徹底を新人に指導できる。"]},{"id":"dry-both","name":"洗浄後・消毒後の乾燥徹底","kanten":"ぬれた面に消毒せず洗浄後にしっかり乾かし、消毒後も乾いてから豚を入れられるか。","levels":["ぬれたままの面に消毒液をまき、湿ったままの豚房に豚を入れても気にしない。","指示があれば乾かすが、乾燥時間の確保や乾き具合の確認に漏れが多い。","指示があれば洗浄後・消毒後それぞれの乾燥をひと通り確保できる。","指示がなくても換気扇を使って乾燥を早め、完全に乾いたのを確かめてから豚を入れる。","ぬれた面では薬剤が薄まり湿気で病原体が増えることを理解し、乾燥の要点を新人に指導できる。"]},{"id":"no-mix-accident","name":"消毒剤の混合禁止と事故時対応","kanten":"消毒剤を絶対に混ぜず1種類ずつ使い、目に入ったら流水15分以上洗って報告できるか。","levels":["消毒剤を混ぜたり、薬液が目や皮膚についても洗わず放置したりする。","指示があれば守るが、混合禁止の理由を知らず、事故時の対応も不確実。","指示があれば1種類ずつ使い、目に入った時は流水で15分以上洗って報告する対応をひと通りできる。","指示がなくても混合禁止を徹底し、はね防止に水を先に入れるなど安全に扱い、事故時は即対応・報告する。","混合で危険なガスが出る仕組みを理解し、薬剤の安全な扱いと事故対応を新人に指導できる。"]},{"id":"footbath-record","name":"踏み込み消毒槽の管理と実施記録","kanten":"出入口の消毒槽の薬液を確認して汚れ・不足なら交換・補充し、実施場所と薬剤を記録できるか。","levels":["消毒槽が汚れていても放置し、どこに何をまいたかの記録も残さない。","指示されれば交換・記録するが、確認の頻度や記入内容に漏れが多い。","指示があれば消毒槽の薬液をひと通り確認・交換し、実施場所と消毒剤を記録できる。","指示がなくても消毒槽を日常的に点検して汚れたら交換し、実施内容を漏れなく記録する。","汚れた薬液は効果が落ちることを理解し、消毒槽の管理と記録の習慣を新人に指導できる。"]}]},{"id":"lime","no":"No.44","name":"石灰散布","cat":"衛生管理","aspects":[{"id":"moisture","name":"水分と散布量の管理","kanten":"地面が白く見える量を目安に、乾いた地面には先に水をまいてから散布できるか。","levels":["乾いた地面にそのまま散布し、量の目安も守らず消毒効果を出せない。","指示があれば散布するが、地面を湿らせることや量の管理に漏れがある。","指示があれば地面が白く見える量を目安にひと通り散布できる。","指示がなくても乾いた地面には先に水をまいてから散布し、白さの劣化を見て定期的に補充する。","石灰は水分がないと効かないことを理解し、散布量と補充の管理を新人に指導できる。"]},{"id":"wind-safety","name":"風向き確認と防護","kanten":"風向きを確認して粉末飛散を防ぎ、人・豚にかからないよう防護具を着けて散布できるか。","levels":["風向きを確認せず粉末を飛散させ、防護具も着けず呼吸器障害や周辺苦情を招く。","指示があれば注意するが、風向き確認や防護具着用に漏れがある。","指示があれば人・豚に直接かからないようひと通り注意して散布できる。","指示がなくても風向きを確認して飛散を防ぎ、防護具を着けて安全に散布する。","飛散による健康被害・苦情のリスクを理解し、安全な散布方法を新人に指導できる。"]},{"id":"weather-stock","name":"天候と在庫の事前確認","kanten":"天気予報を見て雨の近い時間帯を避け、袋の残量を確認して不足を事前に報告できるか。","levels":["天気も在庫も確認せず、雨の直前にまいて流したり、石灰切れで作業を止めたりする。","指示があれば確認するが、天候の判断や残量の見方が不確実で報告も遅れがち。","指示があれば天気予報と袋の残量をひと通り確認してから作業に入れる。","指示がなくても雨の近い散布を避けて時間帯を選び、在庫不足に気づいたら作業前に報告する。","雨で流れると効果が薄れることを理解し、天候判断と在庫管理の段取りを新人に指導できる。"]},{"id":"even-spread","name":"均一散布と仕上がり確認","kanten":"山にせずうすく広くまき、散布後に見回って白く均一か・通行の支障がないか確認できるか。","levels":["一か所に山盛りにするなどムラだらけにまき、仕上がりを見ずに終える。","指示があればまくが、まきムラが多く、散布後の見回りをしない。","指示があればうすく広くまき、散布後に全体をひと通り見回って確認できる。","指示がなくても均一に散布し、まきムラを見つけてまき足し、石灰乳はよくかくはんして詰まりを防ぐ。","白さが効果の目安になることを理解し、均一にまくコツと確認の仕方を新人に指導できる。"]},{"id":"skin-storage","name":"皮膚付着時の対応と石灰の保管","kanten":"皮膚についたらすぐ大量の水で洗い流し、残った石灰は袋を閉じて湿気を避けて保管できるか。","levels":["皮膚についても洗わず放置し、袋を開けたまま雨ざらしにして石灰を劣化させる。","指示があれば対応するが、洗い流しが不十分で、袋の閉め忘れや保管場所のミスが多い。","指示があれば付着時に大量の水で洗い、袋の口を閉じて湿気のない場所にひと通り保管できる。","指示がなくても付着時は即座に洗って赤み・痛みがあれば報告し、保管状態まで自分で確かめる。","消石灰の強アルカリ性による化学熱傷の危険を理解し、応急対応と保管を新人に指導できる。"]}]},{"id":"carcass","no":"No.37","name":"死獣回収","cat":"衛生管理","aspects":[{"id":"prompt-storage","name":"速やかな回収と専用保管","kanten":"死亡確認後すぐに回収し、豚房内に放置せず専用の保管場所へ入れられるか。","levels":["死体を豚房内に放置し、他の豚が接触して感染源になっても気にしない。","指示があれば回収するが、回収の遅れや保管場所の管理に漏れがある。","指示があれば死亡確認後にひと通り回収し、専用保管場所へ入れられる。","指示がなくても速やかに回収して専用場所へ入れ、感染源化を防ぐ。","死体放置の感染リスクを理解し、速やかな回収・保管の手順を新人に指導できる。"]},{"id":"law-record","name":"法令遵守と死亡記録","kanten":"堆肥混入などの違法処理を避け、感染症疑いは自己判断せず、死亡状況を記録できるか。","levels":["死亡子豚を堆肥に混入するなど違法な処理をし、記録も残さない。","指示されれば記録するが、法令の理解が浅く記録に漏れが多い。","指示があれば専用処理へ回し、死亡状況をひと通り記録できる。","指示がなくても法令に沿って処理し、感染症疑いは自己判断せず、死亡日・頭数・原因を記録する。","化製場法・廃棄物処理法の要点を理解し、正しい処理と記録を新人に指導できる。"]},{"id":"infect-signs","name":"感染症サインの察知と作業停止","kanten":"短期間の複数死・紫黒斑・血便・血泡を見たら死体を動かさず作業を止めて即報告できるか。","levels":["感染症のサインを見ずに死体を動かし、疑わしい状況でも自己判断で処理を進める。","指示があればサインを見るが、見分けが不確実で報告の判断を他者まかせにする。","指示があれば感染症のサインをひと通り確認し、見つけたら動かさず上司と獣医に報告できる。","指示がなくても回収前に必ずサインを確認し、疑いがあれば作業を止めて即報告し指示を待つ。","法定伝染病疑い時の届出や剖検の必要性を理解し、止めるべき状況の見極めを新人に指導できる。"]},{"id":"ppe-disinfect","name":"防護具着用と回収後の消毒","kanten":"厚手手袋・マスクを着け素手で触らず、死体のあった場所・道具を消毒し手洗いできるか。","levels":["素手で死体にさわり、跡地や道具も消毒せずそのまま他の豚の作業に移る。","指示があれば手袋を着けるが、跡地の消毒や道具の洗浄・手指消毒に漏れが多い。","指示があれば防護具を着けて回収し、跡地・道具の消毒と手洗い・手指消毒をひと通りできる。","指示がなくても防護具と消毒を徹底し、手指消毒を終えてから他の豚にさわる。","豚丹毒など人にうつる病気の危険を理解し、防護と消毒の手順を新人に指導できる。"]},{"id":"confirm-herdwatch","name":"死亡確認と同居豚の観察","kanten":"呼吸・反応を見て死亡を確かめ、同じ豚房の豚の元気・食欲・呼吸・皮膚色を観察できるか。","levels":["動かない＝死亡と決めつけて弱った豚を運ぼうとし、同居豚の様子も見ない。","指示があれば確認するが、死亡確認が不確実で、同居豚の観察も形だけになる。","指示があれば呼吸と反応で死亡をひと通り確かめ、同居豚の様子を見て回れる。","指示がなくても死亡を慎重に確かめ、同居豚の異常の兆候を早期に見つけて報告する。","突然死の病気が群れに広がりやすいことを理解し、確認と観察の着眼点を新人に指導できる。"]}]},{"id":"patrol-check","no":"","name":"見回り・健康チェック","cat":"衛生管理","aspects":[{"id":"route-cover","name":"豚房の巡回手順","kanten":"全豚房の中まで入り、入口で全体を見てから、立つ豚・寝ている豚・エサ箱・飲水器・排泄エリア・奥の順に見て回れるか。","levels":["遠くから見ただけで大丈夫と済ませ、豚房の中に入らず、寝ている豚が起き上がるかも確かめない。","指示があれば豚房に入るが、エサ箱や排泄エリアの確認が抜け、寝ている豚の確認は他者まかせ。","指示があれば入口で全体を見て、立つ豚・寝ている豚・エサ箱・飲水器・排泄エリア・奥の順に確認し、寝ている豚が起き上がるかも確かめられる。","指示がなくても全豚房を漏れなく回り、寝ている豚が全頭起き上がるかまで確かめる。","遠くから見て済ませる危うさと、異常をひとつ見つけて他が雑になる危うさを理解し、新人の見回りに同行して抜けをひとつ指摘し直させるなど、新人に指導できる。"]},{"id":"urgency-judge","name":"異常サインの緊急度判定","kanten":"開口呼吸や突然死は緊急、血便や黒いタール便・下痢・起立不能・湿った咳と鼻水・40℃以上の発熱などは高、跛行・乾いた咳・食欲低下は中と見分け、迷ったら即報告すると口頭で説明できるか。","levels":["異常に気づいても緊急かどうか分けず、様子を見ようと報告を後回しにする。","指示があれば報告するが、緊急の異常も他と同じ速さで報告するなど、急ぐ異常の区別があいまいで場当たり的。","指示があれば、観点の区分どおりに異常の緊急度（緊急・高・中）を判断して報告できる。","指示がなくても緊急度を判断して、緊急と高に加えて中（跛行・乾いた咳・食欲低下）も報告し、迷う時も報告する。","緊急度の区分と、迷ったら即報告する理由を理解し、新人の見回りに同行して報告の遅れや区分の誤りをひとつ指摘し直させるなど、新人に指導できる。"]},{"id":"report-template","name":"異常報告の中身","kanten":"異常を見つけたら、日時・発見者・棟/列/豚房番号・対象の豚（マーキング色など）・症状・いつから・同房の状況・連絡済みか未連絡かを整理して第一報として伝えられるか（異常豚がいない日は想定事例を口頭で聞く）。","levels":["口頭で「なんか変です」と伝えるだけで、場所も個体も言えず、聞き返されて初めて答える。","指示があれば報告するが、豚房番号やどの豚か、症状の具体性、いつからかが抜け、同房の状況は伝えない。","指示があれば、日時・発見者・棟/列/豚房番号・対象の豚（マーキング色など）・症状・いつから・同房の状況・連絡済みか未連絡かを整理して第一報を伝えられる。","指示がなくても症状を見たまま具体的に述べ、同房の他の豚の様子を自分から見て添えて第一報を伝え、連絡済みか未連絡かも添える。","報告の項目が獣医師の判断を助ける理由を理解し、新人の第一報を聞いて抜けた項目をひとつ指摘し言い直させるなど、新人に指導できる。"]},{"id":"mark-followup","name":"マーキングと翌日の追跡","kanten":"異常な豚にスプレーで印を付け、翌日同じ豚を確かめて変化を報告する段取りを言えるか。","levels":["マーキングスプレーを持たず、異常な豚に印を付けないため、翌日に同じ豚を見つけられない。","指示があれば異常な豚に印は付けるが、翌日同じ豚を確かめる段取りが言えず、他者まかせにする。","指示があれば、異常な豚の体にスプレーで見分けやすい印を付け、翌日同じ豚を確かめる段取りを言える。","指示がなくてもスプレーを常に携帯して印を付け、翌日同じ豚を確かめて変化を報告する段取りを自分から述べる。","印がないと翌日に同じ豚を見つけられない理由と、変化を追う意味を理解し、新人が印を付ける場面に同行して付け忘れをひとつ指摘するなど、新人に指導できる。"]},{"id":"safe-quiet","name":"静かな巡回と人の安全","kanten":"声をかけながら静かに近づき、視界の外から急に近づかず、逃げ道を確保して壁際に追い込まれない位置で見回れるか。","levels":["急ぎ足で視界の外から近づいて豚を驚かせ、声もかけず、逃げ道も考えず、壁際で観察する。","指示があれば静かに歩くが、背後から近づいたり壁際で観察したりして、逃げ道の確保が抜ける。","指示があれば、声をかけながらゆっくり近づき、豚の視界に入る位置から、逃げ道を確保して観察できる。","指示がなくても静かに声をかけて近づき、壁際に追い込まれない位置を選び、豚房内でも通路でも常に逃げ道を確保して見回る。","驚かせると突進される理由と、静かな巡回が正常な状態を見るために必要な理由を理解し、新人の見回りに同行して近づき方の危ない点をひとつ指摘し直させるなど、新人に指導できる。"]}]},{"id":"ai-insem","no":"No.14","name":"AI（人工授精）注入作業","cat":"繁殖管理","aspects":[{"id":"prep-activity","name":"事前準備と精子活性の確認","kanten":"産歴・AI回数・本数を確認して器具をそろえ、注入前に顕微鏡で精子の活性を確認できるか。","levels":["母豚や本数を確かめず器具も不足したまま始め、活性確認を省いて悪い精液を使う。","指示があれば準備するが、本数の確認や活性チェックに抜けが多い。","指示があれば産歴・回数・本数を確認し、顕微鏡で活性を見てから注入に入れる。","指示がなくても対象母豚と必要本数を自分で確かめ、活性確認と保冷まで整えてから始める。","準備不足が受胎率と精液のムダに直結することを理解し、準備と活性確認の手順を新人に指導できる。"]},{"id":"acceptance","name":"許容確認と挿入の判断","kanten":"許容を確認してから無理なく挿入し、排卵タイミングに合った適期に注入できるか。","levels":["許容を確かめず無理に挿入し、排卵タイミングを無視して受胎率を落とす。","指示があれば実施するが、許容確認が不十分で適期を外すことが多い。","指示があれば許容を確認し、指示された適期にひと通り注入できる。","指示がなくても許容を確かめてから適期に注入し、無理な挿入を避ける。","許容開始からの排卵時間を理解し、適期の判断と丁寧な注入を新人に指導できる。"]},{"id":"hygiene-temp","name":"器具・外陰部の清潔と精液の温度管理","kanten":"器具・外陰部を清潔に保ち、精液をゆっくり入れ、急激な加温を避けて温度管理できるか。","levels":["器具・外陰部を清潔にせず、精液を急激に加温してカテーテル汚染や高温障害を招く。","指示があれば清潔にするが、温度管理や注入速度に漏れがある。","指示があれば器具・外陰部を清潔に保ち、精液をひと通りゆっくり入れられる。","指示がなくても清潔を徹底し、精液を急激に加温せずゆっくり注入する。","子宮炎・高温障害の仕組みを理解し、清潔操作と温度管理を新人に指導できる。"]},{"id":"natural-inflow","name":"自然流入での注入とカテーテル対応","kanten":"精液を無理に押し込まず自然に流し、注入後2〜3分さわらず、排尿・汚染時にカテーテルを正しく対応できるか。","levels":["精液を無理に押し込み、注入直後にカテーテルをさわり、汚れたカテーテルもそのまま使う。","指示があれば注入できるが、押し込みや注入後の放置時間にムラがあり、排尿時の対応は他者まかせ。","指示があれば自然流入で注入し、注入後2〜3分さわらずに待てる。","指示がなくても排尿時はカテーテルを上げ、汚れたら新品に交換し、自然流入を守って抜去まで丁寧に行う。","母豚が吸い込む仕組みと逆流・汚染の原因を理解し、注入とカテーテル対応のコツを新人に指導できる。"]},{"id":"record-restock","name":"記録・医療ゴミ処理と資材補充","kanten":"母豚カード・野帳をその場で記入し、医療ゴミを片付け、アル綿・ペーパー等を補充できるか。","levels":["記録をせず、医療ゴミや余ったカテーテルも放置し、資材が切れても補充しない。","指示されれば記入・片付けするが、記載漏れや補充忘れが多い。","指示があれば母豚カード・野帳を記入し、ゴミの片付けと補充までひと通りできる。","指示がなくても作業後すぐ記録し、医療ゴミを正しく処理して次回分の資材を補充しておく。","記録と資材管理が交配計画の土台であることを理解し、記入と片付けの型を新人に指導できる。"]}]},{"id":"standing-check","no":"No.33","name":"許容確認","cat":"繁殖管理","aspects":[{"id":"target-list","name":"対象母豚の絞り込み","kanten":"前日の記録から離乳後3〜7日と交配後約21日の母豚を抜き出し、重点的に確認できるか。","levels":["記録を見ずに手当たり次第に見て、発情の来やすい母豚を確認し忘れる。","指示があれば対象を見るが、離乳日・前回交配日の確認に抜けが多い。","指示があれば前日の記録から対象母豚をひと通り抜き出して確認できる。","指示がなくても離乳後3〜7日・交配後約21日の母豚を自分でリストアップし、重点的に見る。","発情周期と発情が来やすい時期の理由を理解し、対象の絞り込み方を新人に指導できる。"]},{"id":"boar-backpressure","name":"雄豚接触＋背圧での確認","kanten":"雄豚を接触させ、背圧をかけて強く押しても動かず立つかを確かめられるか。","levels":["雄豚を近づけず外陰部の腫れだけで判断し、偽陰性・適期外授精を招く。","指示があれば背圧を確かめるが、雄豚接触が不十分で判断が甘い。","指示があれば雄豚接触＋背圧で許容をひと通り確認できる。","指示がなくても雄豚を接触させて背圧をかけ、静止するかを確実に確かめる。","許容反応の仕組みを理解し、確実な確認方法と適期の見極めを新人に指導できる。"]},{"id":"sign-composite","name":"外陰部・粘液・行動の複合判断","kanten":"外陰部の色・腫れ、粘液の状態、行動の変化を合わせて見て、発情の時期を総合判断できるか。","levels":["外陰部の見た目だけで授精を決め、粘液や行動のサインを見ない。","指示があればサインを見るが、透明で糸を引く粘液と白くにごった粘液の区別など判断が曖昧。","指示があれば外陰部・粘液・行動をひと通り観察して判断材料にできる。","指示がなくても複数のサインを合わせて時期を判断し、見た目だけで早すぎる授精をしない。","各サインが発情のどの段階を示すかを理解し、複合判断の見方を新人に指導できる。"]},{"id":"quiet-timing","name":"静かな母豚・夜間発情の見落とし防止","kanten":"静かな母豚は外見・行動も合わせて見て、夜間・早朝発情を見落とさず確認できるか。","levels":["1日1回の確認だけで、夜間・早朝発情や静かな母豚の発情を見落とす。","指示があれば確認するが、静かな母豚や時間帯による見落としが多い。","指示があれば静かな母豚も外見・行動を合わせてひと通り確認できる。","指示がなくても確認回数を工夫し、静かな母豚も排尿等の行動から発情を捉える。","夜間発情や微弱発情の見落としリスクを理解し、確認のタイミングを新人に指導できる。"]},{"id":"time-record-report","name":"時刻の即時記録と未発情の報告","kanten":"許容確認した時刻をその場で記録・マーキングし、判定に迷う母豚と離乳後8日以上未発情の母豚を報告できるか。","levels":["時刻を記録せずマーキングもせず、発情が来ない母豚も報告せず放置する。","指示されれば記録するが、あとでまとめて書いて時刻が曖昧になり、報告漏れも多い。","指示があればその場で個体番号・日付・時刻を記録し、迷った母豚を報告できる。","指示がなくても許容ごとに即時記録・マーキングし、8日以上未発情の母豚をリスト化して報告する。","時刻がAIタイミングの基準になることを理解し、記録と報告の型を新人に指導できる。"]}]},{"id":"semen-check","no":"No.03","name":"精液検査・反転","cat":"繁殖管理","aspects":[{"id":"temp-control","name":"17℃保管と温度変化の抑制","kanten":"精液を17℃前後で保管し、検査前の温度を均一にして温度変化を最小限にできるか。","levels":["保管温度を気にせず、検査前の温度も不均一なまま評価して誤判定する。","指示があれば温度を確認するが、変化の抑制や均一化に漏れがある。","指示があれば17℃前後で保管し、ひと通り温度に配慮できる。","指示がなくても温度変化を最小限に抑え、検査前に温度を均一にする。","温度が精子品質に与える影響を理解し、保管・検査時の温度管理を新人に指導できる。"]},{"id":"activity-mix","name":"精子活力確認と穏やかな反転","kanten":"顕微鏡で精子活力を確認し、反転を穏やかに行って精子へのダメージを防げるか。","levels":["活力確認を省き、新鮮精液を激しく振盪して精子を傷める。","指示があれば確認するが、反転の強さやタイミングに漏れがある。","指示があれば顕微鏡で活力を確認し、ひと通り穏やかに反転できる。","指示がなくても活力を確認し、反転を穏やかに行ってダメージを防ぐ。","精子活力と反転操作の関係を理解し、検査と反転の手技を新人に指導できる。"]},{"id":"reject-report","name":"不良精液の除外と報告","kanten":"運動率・凝集・色の異常から使えない精液を見分け、戻さず分けて上長へ報告できるか。","levels":["動きの悪い精液や色のおかしい精液も「もったいない」とそのまま使う。","指示があれば見るが、振動運動や凝集の見分けが曖昧で、報告は他者まかせ。","指示があれば運動率の基準に沿って判定し、問題のあるロットを分けて報告できる。","指示がなくても不良精液をインキュベーターに戻さず分け、すぐ上長に報告して使用を止める。","受胎しない損が精液1本より大きいことを理解し、判定基準と除外・報告の判断を新人に指導できる。"]},{"id":"expiry-fifo","name":"使用期限の管理（先入れ先出し）","kanten":"ラベルの使用期限を確認して期限が近いものを手前に置き、期限切れを絶対に使わず廃棄・記録できるか。","levels":["期限を見ずに使い、期限切れの精液も気づかずに使う。","指示があれば期限を見るが、置き直しや廃棄の記録に抜けが多い。","指示があれば期限を確認し、先入れ先出しでひと通り並べ替えられる。","指示がなくても期限の近いものを手前に置き、期限切れは廃棄して記録に残す。","使用期限と精子品質の関係を理解し、先入れ先出しの管理を新人に指導できる。"]},{"id":"record-equip","name":"検査記録と機器の点検","kanten":"温度・ロット別の検査結果を毎回記録し、レンズ清掃・扉閉め・電源プラグの確認まで行えるか。","levels":["温度も検査結果も記録せず、扉の閉め忘れやプラグ抜けにも気づかない。","指示されれば記録するが、ロット番号や判定の記載漏れが多く、片付けも不十分。","指示があれば温度と検査結果をロットごとに記録し、レンズ清掃・扉・プラグの確認までできる。","指示がなくても毎朝の温度記録と検査記録を続け、「昨日より悪い」変化に気づいて相談する。","プラグ抜け等が精液全損につながることを理解し、記録と機器点検の習慣を新人に指導できる。"]}]},{"id":"semen-mix","no":"No.17","name":"精液攪拌","cat":"繁殖管理","aspects":[{"id":"temp-check","name":"保管温度の確認と逸脱時の対応","kanten":"攪拌前にインキュベーターが17℃前後にあるか確認・記録し、範囲を外れていたら使う前に上長へ報告できるか。","levels":["温度計を見ずに攪拌を始め、温度が外れていても気にせず使わせてしまう。","指示があれば温度を見るが、記録や逸脱時の報告に抜けがある。","指示があれば温度を確認・記録し、範囲外のときは報告してから進められる。","指示がなくても毎回温度を確かめ、逸脱時は精液を使う前に必ず報告して対応につなげる。","温度逸脱が精子に与えるダメージを理解し、確認と報告の判断基準を新人に指導できる。"]},{"id":"gentle-mix","name":"穏やかな攪拌と温度・浸透圧の配慮","kanten":"強く振らず穏やかに攪拌し、希釈液との温度差や気泡混入を避けられるか。","levels":["強く振って気泡を混入させ、希釈液との温度差で浸透圧ショックを招く。","指示があれば攪拌するが、強さや温度差への配慮に漏れがある。","指示があれば穏やかにひと通り攪拌できる。","指示がなくても温度差を抑えて穏やかに攪拌し、気泡混入を避ける。","浸透圧ショックや酸化ストレスの仕組みを理解し、攪拌のコツを新人に指導できる。"]},{"id":"visual-inspect","name":"沈殿・結露・色の点検","kanten":"攪拌時に底の沈み・固まりが消えたか、結露や色の変化がないかを目で確かめ、異常ロットを報告できるか。","levels":["ひっくり返すだけで底や色を見ず、大きな固まりのあるロットも気づかず戻す。","指示があれば見るが、結露や色の変化の意味が分からず見過ごしが多い。","指示があれば沈殿・結露・色をひと通り点検し、気づいたことを伝えられる。","指示がなくても毎回点検し、大きな固まりや色の変化があるロットは使わずに報告する。","結露＝温度差・色の変化＝品質低下のサインであることを理解し、点検の着眼点を新人に指導できる。"]},{"id":"light-shield","name":"遮光の徹底","kanten":"インキュベーターを直射日光の当たる場所に置かず、攪拌のときも精液を強い光に当てないようにできるか。","levels":["直射日光の当たる場所で作業し、精液を光にさらしたまま精子を傷める。","指示があれば光を避けるが、置き場所や扱いの徹底に漏れがある。","指示があれば直射日光を避け、ひと通り光に当てずに扱える。","指示がなくても置き場所と扱いの両方で強い光を避け、光線ダメージを防ぐ。","強い光が精子を弱らせることを理解し、遮光管理を新人に指導できる。"]},{"id":"fifo-record","name":"短時間の取り扱いと先入れ先出し・記録","kanten":"外に出す時間を1〜2分以内にし、期限の近いものを手前に置き直し、攪拌と温度を記録できるか。","levels":["外に出したまま長く握り、期限も並び順も気にせず、記録も残さない。","指示があれば戻すが、出す時間が長引きがちで、置き直しや記録に抜けが多い。","指示があれば1〜2分以内に戻し、先入れ先出しの置き直しと記録までできる。","指示がなくても素手で長く握らず短時間で戻し、期限順に整えて攪拌・温度を毎回記録する。","手の体温と時間経過が精子を弱らせることを理解し、扱いの型と記録を新人に指導できる。"]}]},{"id":"preg-check","no":"No.09","name":"妊娠鑑定","cat":"繁殖管理","aspects":[{"id":"timing-recheck","name":"鑑定時期の厳守と再確認","kanten":"交配後21〜28日に鑑定し、1回で判断せず35日頃の第2回エコーで必ず再確認できるか。","levels":["1回の確認だけで妊娠を確定し、胚が吸収されて消えた空胎を見落とす。","指示があれば鑑定するが、時期の厳守や再確認に漏れが多い。","指示があれば決められた時期に鑑定し、ひと通り実施できる。","指示がなくても21〜28日に鑑定し、35日頃の再確認を省略しない。","早すぎると妊娠嚢が見えないことや陽性後の胚吸収を理解し、鑑定時期と再確認の重要性を新人に指導できる。"]},{"id":"echo-reading","name":"エコー画像の正しい読み取り","kanten":"膀胱・腸内容物と胎胞を混同せず、エコー画像を正しく読み取れるか。","levels":["膀胱や腸内容物を妊娠と誤読し、判定を誤る。","指示があれば当てるが、画像の読み取りに誤りが多い。","指示があればひと通りエコーを当てて胎胞を確認できる。","指示がなくても膀胱・腸内容物と胎胞を見分けて正しく判定する。","エコー画像の見分け方を理解し、誤読を避ける読み取りを新人に指導できる。"]},{"id":"hold-judgment","name":"迷ったときの保留判断と再検査設定","kanten":"判定に迷ったら無理に決めず保留とし、排尿後の再確認や5〜7日後の再検査日を決めて対応できるか。","levels":["あいまいな画像でも陽性・陰性を確定してしまい、誤判定を招く。","指示があれば保留にするが、排尿させての再確認や再検査日の設定に漏れがある。","指示があれば迷った個体を保留にし、5〜7日後の再検査日を決めて記録できる。","指示がなくても排尿させて当て直し、それでも不明なら保留として再検査日を設定し、2回目も不明なら獣医師に相談する。","保留を恥ずかしがらない判断の価値を理解し、迷ったときの決め方を新人に指導できる。"]},{"id":"recheck-return","name":"鑑定後の再発情チェック","kanten":"鑑定後も再発情チェックを続け、空胎の長期化を防げるか。","levels":["鑑定後の再発情チェックを中断し、空胎を長期化させる。","指示があれば確認するが、継続に漏れが多い。","指示があれば鑑定後の再発情をひと通り確認できる。","指示がなくても再発情チェックを続け、空胎の母豚を早く見つける。","再発情チェックの意義を理解し、空胎長期化を防ぐ管理を新人に指導できる。"]},{"id":"onsite-record-probe","name":"その場での記録とプローブ消毒","kanten":"結果を1頭ごとにその場でプレート・記録用紙に記入し、プローブを毎回清拭・消毒して片付けられるか。","levels":["「覚えているから後で」と記録を後回しにし、プローブも汚れたまま次に使う。","指示されれば記入・消毒するが、まとめ書きによる間違いや消毒忘れが多い。","指示があれば1頭ごとに結果をその場で記入し、使用後のプローブ清拭・消毒までできる。","指示がなくても即時記入を徹底して陰性・保留には次回検査日を書き、プローブ消毒と機器の片付けを毎回行う。","伝達漏れ・重複検査・病気の持ち運びを防ぐ意味を理解し、即時記録と消毒の型を新人に指導できる。"]}]},{"id":"pms","no":"No.08","name":"PMS投与","cat":"繁殖管理","aspects":[{"id":"timing-judge","name":"投与時期と黄体確認","kanten":"基本は離乳翌日に指示された量を投与し、黄体遺残をエコー確認せずに重複投与しないか。","levels":["黄体遺残を確認せず重複投与し、投与時期も守らない。","指示があれば投与するが、時期や黄体確認に漏れがある。","指示があれば決められた時期に用量を守ってひと通り投与できる。","指示がなくても離乳翌日のタイミングを守って投与し、再投与は獣医師の判断を仰いで重複を避ける。","黄体とホルモン誘起の関係を理解し、投与時期と適応の判断を新人に指導できる。"]},{"id":"no-self-judge","name":"自己判断の回避と対象母豚の確認","kanten":"使いすぎず上長・獣医師と相談し、未経産・経産の量の違いに注意し、妊娠の可能性がある母豚を対象から外せるか。","levels":["自己判断で使い、妊娠しているかもしれない母豚にも打って流産の危険を招く。","指示があれば投与するが、相談や対象母豚の確認に漏れがある。","指示があれば上長・獣医師と相談し、対象リストの母豚だけにひと通り投与できる。","指示がなくても使いすぎを避けて相談し、妊娠の可能性がある母豚は対象から外して確かめる。","ホルモン剤の使いすぎが卵巣の機能低下を招くことを理解し、相談と対象確認の要点を新人に指導できる。"]},{"id":"drug-label-check","name":"薬剤のラベル確認と温度管理","kanten":"冷蔵2〜8℃保管の薬剤を出してラベルの名前・量・期限・保管状態・変色沈殿を確認し、少し室温に戻して使えるか。","levels":["ラベルを見ずに吸い、期限切れや変色した薬でも気づかず使う。","指示があれば確認するが、5つの確認項目に抜けがあり、冷たいまま打って母豚を暴れさせる。","指示があればラベルの確認項目をひと通りチェックし、室温に戻してから使える。","指示がなくても毎回声に出して確認し、異常のある薬は使わずに報告する。","保管温度と薬効の関係を理解し、ラベル確認と温度管理の手順を新人に指導できる。"]},{"id":"injection-safety","name":"確実な筋肉注射と針の安全管理","kanten":"首の正しい部位に90度で刺し、血の逆流を確認してからゆっくり注入し、針は1頭ごと交換して専用容器に捨てられるか。","levels":["部位を選ばず浅く刺し、逆流確認もせず、使った針にキャップをはめ直して自分を刺しかける。","指示があれば打てるが、消毒・逆流確認・針交換に抜けが多い。","指示があれば首の部位を消毒して90度で刺し、逆流確認と針の専用容器への廃棄までできる。","指示がなくても保定から廃棄まで一連を確実に行い、血が引けたら刺し直して全量を入れる。","首に打つ理由と針刺し事故の危険を理解し、注射手技と針の安全管理を新人に指導できる。"]},{"id":"record-followup","name":"投与記録と発情観察の予定管理","kanten":"投与日・個体番号・量・実施者を記録し、投与後3〜5日の発情観察を続け、7日来なければ獣医師に相談できるか。","levels":["記録を残さず、「打ったから来るだろう」と観察もせず、効かなくても勝手にもう1回打つ。","指示されれば記録するが、観察予定のメモや毎日の雄豚当てに抜けが多い。","指示があれば投与記録と発情確認の予定日を書き、投与後の観察をひと通り続けられる。","指示がなくても毎日観察して発情のサインを捉え、7日過ぎても来ないときは自分で判断せず獣医師相談につなげる。","投与後の観察がチャンスを逃さない鍵であることを理解し、記録と予定管理の型を新人に指導できる。"]}]},{"id":"pg","no":"No.36","name":"PG（プロスタグランジン）接種","cat":"繁殖管理","aspects":[{"id":"gestation-day","name":"妊娠日数の確認と適期投与","kanten":"妊娠日数を交配日の記録から正しく数え、114日未満への投与を避けて決められた日齢・対象に接種できるか。","levels":["妊娠日数を誤算して早すぎる時期に投与し、早産と未熟な子豚の死亡を招く。","指示があれば接種するが、日数確認や対象確認に漏れがある。","指示があれば決められた日齢・対象にひと通り接種できる。","指示がなくても妊娠日数を確認し、対象母豚を確かめて適期に接種する。","早期投与の禁忌と黄体の関係を理解し、適期投与の判断を新人に指導できる。"]},{"id":"id-doublecheck","name":"個体番号の照合とダブルチェック","kanten":"接種前に個体番号をプレートと照合して先輩とダブルチェックし、接種済みマーキングを付けられるか。","levels":["照合せずに打ち、間違った母豚への接種やマーキング忘れによる二重接種を招く。","指示があれば照合するが、ダブルチェックの依頼やマーキングに抜けが多い。","指示があればプレート照合とダブルチェックを行い、接種後のマーキングまでできる。","指示がなくても不安な個体はもう一度見てもらい、接種済みがひと目で分かる状態を保つ。","打ち間違いが流産につながる重大さを理解し、照合とマーキングの型を新人に指導できる。"]},{"id":"injection-obs","name":"確実な注射と分娩受け入れ準備","kanten":"浅い注射で脂肪層に入るのを避けて確実に筋肉注射し、翌日の分娩に備えて立ち会い道具と子豚の保温を整えられるか。","levels":["針が浅く脂肪層に入って効果を弱め、分娩に備えた道具・保温の準備もしない。","指示があれば接種するが、注射の深さや分娩準備に漏れがある。","指示があれば十分な深さで筋肉注射し、立ち会いの道具をひと通りそろえられる。","指示がなくても確実に筋注し、保温灯でクリープエリアを32〜35℃に温めて分娩を受け入れる準備を整える。","浅い注射で効きが弱くなる理由を理解し、注射手技と分娩準備の段取りを新人に指導できる。"]},{"id":"human-safety","name":"人への安全と針・医療ゴミの処理","kanten":"PGが人にも効く薬と理解して必ず手袋を着け、皮膚に付いたらすぐ洗い流し、針はキャップをせず廃棄容器へ捨てられるか。","levels":["素手で薬を扱い、皮膚に付いても洗わず、使った針にキャップをはめ直して危険な捨て方をする。","指示があれば手袋を着けるが、廃棄の仕方や皮膚に付いたときの対応が不確実。","指示があれば手袋を着けて扱い、針・注射器を医療ゴミとしてひと通り処理できる。","指示がなくても手袋と廃棄ルールを徹底し、皮膚に付いたらすぐ洗い流して周囲にも注意を促す。","妊娠中の女性が扱ってはいけない理由を含めて危険性を理解し、安全な取り扱いを新人に指導できる。"]},{"id":"record-timing","name":"接種記録と観察予定の管理","kanten":"個体番号・接種日時を必ず記録し、接種後12時間からの兆候確認と48時間の報告基準を守れるか。","levels":["だれに打ったかを記録せず、接種後の見回り予定も立てない。","指示されれば記録するが、日時の記載や観察予定に抜けが多い。","指示があれば個体番号・接種日時を記録し、翌日の見回り予定までひと通り立てられる。","指示がなくても記録を確実に残し、48時間たっても産まないときは油断せず必ず報告する。","分娩が接種後24〜36時間に集中する流れを理解し、記録と観察予定の組み方を新人に指導できる。"]}]},{"id":"uterine-wash","no":"No.42","name":"子宮内洗浄","cat":"繁殖管理","aspects":[{"id":"target-select","name":"対象選定と獣医師指示の遵守","kanten":"全頭には行わず対象を選定し、薬剤の濃度・量を守って獣医師の指示に従えるか。","levels":["全頭にルーチンで行い、薬剤の濃度・量も守らず自然回復を妨げる。","指示があれば実施するが、対象選定や濃度管理に漏れがある。","指示があれば対象を選び、決められた濃度・量でひと通り実施できる。","指示がなくても手入れした母豚等に絞り、濃度・量を守って獣医師の指示に従う。","予防的ルーチン洗浄の弊害を理解し、対象選定と適正実施を新人に指導できる。"]},{"id":"solution-warm","name":"洗浄液の調製と加温","kanten":"洗浄液を処方どおりに用意し、体温程度（38〜39℃）に温め、濃度が分からないときは作業を止めて確認できるか。","levels":["冷たい液をそのまま使い、濃度が分からなくても適当に薄めて進めてしまう。","指示があれば用意するが、温度の確認や処方どおりの調製に抜けがある。","指示があれば処方どおりに調製し、体温程度に温めてから使える。","指示がなくても直前に液温を確かめ、不明点があれば作業を止めて確認してから進める。","冷たい液が子宮収縮・泌乳低下を招く仕組みを理解し、調製と加温の要点を新人に指導できる。"]},{"id":"aseptic-gentle","name":"滅菌器具と外陰部消毒・穏やかな操作","kanten":"滅菌した器具・洗浄液を使い、外陰部を清拭・消毒してから、強くこすらず穏やかに操作できるか。","levels":["非滅菌の器具を使い、外陰部も汚れたまま挿入して新しいばい菌を子宮に入れてしまう。","指示があれば実施するが、滅菌や外陰部の消毒に漏れがある。","指示があれば滅菌器具を使い、外陰部を消毒してからひと通り実施できる。","指示がなくても外陰部の清拭消毒と滅菌器具の使用を徹底し、強くこすらず穏やかに操作する。","非滅菌器具による二次感染と強い操作で子宮を傷めるリスクを理解し、清潔な手順を新人に指導できる。"]},{"id":"stop-on-resistance","name":"抵抗・暴れ時の中断判断","kanten":"カテーテルに抵抗を感じたらすぐ止めて獣医師に相談し、母豚が暴れたら無理をせずいったん抜いて仕切り直せるか。","levels":["抵抗があっても力で押し込み、母豚が暴れても押さえつけて続ける。","指示があれば止まるが、無理をしがちで中断の判断が遅れる。","指示があれば抵抗を感じた時点で止め、報告してから次の対応に移れる。","指示がなくても抵抗や暴れの時点でそっと引き抜き、落ち着いてからやり直すか獣医師に相談する。","無理な操作が子宮穿孔・腹膜炎につながる危険を理解し、止める判断の基準を新人に指導できる。"]},{"id":"effluent-record","name":"体温・排出液の記録と休薬管理","kanten":"処置前後の体温を測って比べ、排出液の色・におい・混入物を記録し、抗菌薬使用の記録と休薬の指示に従えるか。","levels":["体温も排出液も見ず、処置した母豚と日付の記録も残さない。","指示されれば記録するが、色・においなど獣医師の判断材料になる情報に抜けが多い。","指示があれば処置前の体温と排出液の状態を記録し、処置した母豚と日付を残せる。","指示がなくても翌日まで体温・食欲・悪露を毎日記録し、良くならないときは獣医師に伝える。","記録が次の処置判断と休薬管理の根拠になることを理解し、観察と記録の型を新人に指導できる。"]}]},{"id":"gilt-intake","no":"","name":"育成豚の受け入れ","cat":"繁殖管理","aspects":[{"id":"arrival-check","name":"到着時の個体確認と状態チェック","kanten":"到着した候補豚の頭数と個体番号を確かめ、肢蹄・乳頭数（14個以上）・背線・体重を見て受け入れの可否を確認できるか。","levels":["頭数や個体番号を確かめずに降ろし、肢蹄や乳頭を見ないまま、跛行や基準外の豚も他の豚と同じ豚房に入れる。","指示があれば頭数と個体番号を確認するが、肢蹄や乳頭数の見落としが多く、体重確認は他者まかせ。","指示があれば頭数と個体番号を確かめ、肢蹄・乳頭数（14個以上）・背線を確認し、体重を測って記録できる。","指示がなくても到着時に頭数と個体番号を確かめ、肢蹄・乳頭・背線の基準外の豚に気づけばその場で上長に伝える。","到着時の見落としが数か月後の母豚の成績や淘汰に響くことを理解し、確認の見方を新人に指導できる。"]},{"id":"isolation-bio","name":"持ち込み防止と着替え・消毒","kanten":"外から来た豚と車・人から病原体を持ち込まないよう、農場の決まりに従って着替え・消毒をし、長靴・道具を他の群と分けて使えるか。","levels":["作業着や長靴を替えず、届いた豚を他の群の豚房に入れ、道具も共用して病原体を広げる。","指示があれば着替えや消毒をするが、長靴の履き替えや道具の分け方に抜けが多い。","指示があれば農場の決まりに従って着替え・消毒をし、長靴・道具を他の群と分けて使える。","指示がなくても受け入れ前後に着替え・消毒を行い、移動の順序を守って他の群に病原体を持ち込まない。","病気を入れない・広げない・持ち出さないの3原則を理解し、受け入れ時の分け方と消毒の理由を新人に指導できる。"]},{"id":"acclimation","name":"馴致（環境と雄豚に慣らす）","kanten":"候補豚を急に驚かせずゆっくり近づけ、24〜26週齢から柵越しの雄豚当てを毎日10〜15分行って、環境と雄豚に慣らせるか。","levels":["急に近づいて追い回し、雄豚当ての時間も決めず、環境が急に変わってもそのままにする。","指示があれば雄豚当てをするが、時間や回数にムラがあり、豚を驚かせる近づき方が残る。","指示があれば柵越しで毎日10〜15分雄豚に触れさせ、ゆっくり近づいて落ち着かせられる。","指示がなくても決めた週齢から毎日雄豚当てを行い、環境の急な変化を避けて豚の様子を見ながら進める。","フェロモン刺激で性成熟が進むことと、若い豚はストレスに弱いことを理解し、馴致の進め方を新人に指導できる。"]},{"id":"health-observe","name":"健康・脚・群内の様子の観察","kanten":"届いた候補豚の食欲・歩様・体型の変化と、群内でいじめられていないか、エサを食べられているかを毎日見て異常に気づけるか。","levels":["観察せず、食べていない豚やいじめられている豚、脚を引きずる豚がいても気づかない。","指示があれば見回るが、食欲や歩様の変化の見落としが多く、気づいても伝えない。","指示があれば食欲・歩様・体型を見て、群内でいじめられて食べられない豚を見つけて報告できる。","指示がなくても毎日の見回りで食欲・脚・太りすぎ痩せすぎを確認し、導入時に問題がなくても後から出る関節の異常に気づいて報告する。","若い豚は環境の変化に弱いことや脚の問題が長期の使用に響くことを理解し、観察の見どころを新人に指導できる。"]},{"id":"record-merge","name":"記録と群への合流前の最終確認","kanten":"個体番号・体重・乳頭数・発情日を記録用紙に残し、合流前に体重・BCS・肢蹄・健康を確認して、基準外の豚は上長に伝えられるか。","levels":["記録を残さず、確認もせずに群へ入れ、基準に満たない豚も黙って混ぜる。","指示があれば記録するが、個体番号や体重の記入漏れが多く、合流前の確認も抜けがち。","指示があれば個体番号・体重・乳頭数・発情日を記入し、体重・BCS・肢蹄・健康をひと通り確認して合流できる。","指示がなくても初回発情と2回目以降の発情を区別して記録し、合流前に最終確認して、基準外の豚は早めに上長へ伝えて判断をあおぐ。","記録と最終確認が将来の初産成績を左右することを理解し、記入と合流前確認の型を新人に指導できる。"]}]},{"id":"farrow-entry","no":"No.26","name":"入室（分娩舎）","cat":"分娩管理","aspects":[{"id":"prep-before","name":"入室前の舎内準備","kanten":"入室前に床・温度・水・エサと分娩クレートの洗浄・乾燥を整えられるか。","levels":["分娩舎の温度・保温灯を確認せず、クレート洗浄・乾燥も未完了のまま入室させ、子豚低体温死を招く。","指示があれば準備するが、温度設定やクレート乾燥の確認に漏れがある。","指示があれば床・温度・水・エサをひと通り整えられる。","指示がなくても入室前に温度・保温灯・水・エサとクレートの洗浄・乾燥を確認する。","入室前準備が子豚の生存に直結すると理解し、準備の要点を新人に指導できる。"]},{"id":"batch-entry","name":"適期の一斉入室と入室後観察","kanten":"分娩が近い母豚をロットごとに一斉入室させ、途中追加を避け、入室後の体調・行動を観察できるか。","levels":["入室タイミングが遅れて妊娠舎で分娩させ、入室後の観察も怠る。","指示があれば入室させるが、タイミングや一斉入室の管理に漏れがある。","指示があればロットごとに一斉入室させ、ひと通り観察できる。","指示がなくても適期にロット単位で入室させ、途中追加を避けて入室後を観察する。","オールイン・オールアウトの意義を理解し、適期入室と観察を新人に指導できる。"]},{"id":"calm-move","name":"静かな誘導と人の安全","kanten":"走らせない・たたかないで静かに誘導し、母豚の真後ろに立たず仕切り板を正しく使えるか。","levels":["母豚を走らせたり大声・たたく扱いをし、真後ろに立つなど危険な位置取りをしても気にしない。","指示があれば静かに誘導しようとするが、仕切り板の使い方や立ち位置にムラがあり、慌てると乱暴になる。","指示があれば通路の逃げ道をふさぎ、仕切り板で方向をつくって静かにゆっくり誘導できる。","指示がなくても事前に通路を整え、真後ろを避けた位置取りで安全に誘導し、興奮した母豚には無理をしない。","驚かせるストレスが流産や事故につながる原理を理解し、安全な誘導のやり方と立ち位置を新人に指導できる。"]},{"id":"id-check","name":"個体番号の照合と記入","kanten":"入室時に個体番号とストール番号をその場で照合し、プレート・記録に正しく残せるか。","levels":["番号を照合せずに母豚を入れ、プレートの記入漏れ・書きちがいがあっても放置する。","指示があれば記入するが、照合があいまいで確認は他者まかせ。","指示があれば個体番号とストール番号をその場で照合し、プレートに正しく記入できる。","指示がなくても全頭を照合・記入し、リストと合わない個体に気づけばその場で確かめて報告する。","番号ちがいが後の記録全部をくるわせることを理解し、照合と記入のやり方を新人に指導できる。"]},{"id":"after-entry","name":"入室直後の飲水・初回給餌","kanten":"入室直後に全頭が水を飲めるか実際に確かめ、最初のエサを農場の指示どおり少量から与えられるか。","levels":["入室後の飲水確認をせず、最初から多量のエサを与えても気にしない。","指示があれば確認するが、実際に飲む様子まで見ず、給餌量にもムラがある。","指示があれば全頭が実際に水を飲む様子を確かめ、最初のエサを指示どおり少量から与えられる。","指示がなくても全頭の飲水と採食を確かめ、飲めない・食べない個体に気づけばニップルの詰まりなどを調べて報告する。","急な多給や飲水不足が母豚の体調をくずすことを理解し、入室直後の確認のやり方を新人に指導できる。"]}]},{"id":"farrow-assist","no":"No.35","name":"分娩介助","cat":"分娩管理","aspects":[{"id":"timing","name":"介助タイミングの見極めと難産の報告","kanten":"分娩間隔を計り、前の子豚から1時間以上出ない時だけ介助に入り、難産のサインをすぐ報告できるか。","levels":["分娩間隔を見ずに放置するか、逆にむやみに手を入れ、難産のサインがあっても報告しない。","指示があれば介助するが、分娩間隔の見極めが甘く、介助に入るかの判断は他者まかせ。","指示があれば見回りで分娩間隔を計り、前の子豚から1時間以上出ない時に手順どおり介助へ移れる。","指示がなくても最低30分おきの見回りで間隔を把握し、迷えば手を入れる前に報告し、難産のサインに気づけばすぐ先輩・獣医へ連絡する。","介助の遅れが低酸素・死産につながる原理を理解し、介助に入る見極めと難産サインの見分け方を新人に指導できる。"]},{"id":"clean-assist","name":"清潔と潤滑の徹底","kanten":"介助前に肘まで洗浄・消毒し、長手袋と潤滑剤を使って清潔に産道へ手を入れられるか。","levels":["手洗い・消毒をせず素手や汚れた手袋のまま介助し、潤滑剤も使わない。","指示があれば手袋を着けるが、肘までの洗浄・消毒や潤滑剤の塗り方に抜けがある。","指示があれば石けんで肘まで洗って消毒し、長手袋の上から潤滑剤を塗って手順どおり介助できる。","指示がなくても毎回清潔と潤滑を徹底し、母豚の力みに合わせて引き出し、産道に別の子豚が残っていないかも確かめる。","不潔な介助が子宮炎から無乳・子豚の飢餓につながる流れを理解し、清潔操作を新人に指導できる。"]},{"id":"newborn-care","name":"新生子豚の乾燥・保温・蘇生","kanten":"生まれた子豚をすぐ乾かし温め、呼吸を確認し、仮死子豚を蘇生できるか。","levels":["子豚を乾かさず温めず、仮死子豚を死産と誤判断して蘇生処置を省く。","指示があれば処置するが、呼吸確認や蘇生の判断に漏れがある。","指示があれば子豚を乾かし温め、呼吸をひと通り確認できる。","指示がなくてもすぐ乾かして温め、仮死子豚を見分けて蘇生処置を行う。","仮死と死産の見分けや蘇生の意義を理解し、新生子豚の初期処置を新人に指導できる。"]},{"id":"colostrum","name":"初乳の早期摂取","kanten":"生まれた子豚に遅くとも生後6時間以内に初乳を飲ませ、吸えない子豚にも手を打てるか。","levels":["初乳を飲めているか気にせず放置し、吸えない子豚がいても何もしない。","指示があれば乳頭にあてがうが、実際に飲めたかの確認までせずムラがある。","指示があれば乳頭に子豚の口をあてがい、吸わない子豚には乳を搾って口にたらして飲ませられる。","指示がなくても全頭の初乳摂取を6時間以内に確かめ、弱い子豚を優先して確実に飲ませる。","生後24時間を過ぎると腸が閉じて免疫を吸収できなくなる原理を理解し、初乳管理を新人に指導できる。"]},{"id":"post-record","name":"分娩後の確認・記録・片付け","kanten":"胎盤の排出を確認し、分娩時刻・産子数・死産数・処置を記録し、胎盤やタオルを決められた場所へ片付けられるか。","levels":["胎盤の確認や記録をせず、使ったタオル・胎盤も片付けずに放置する。","指示があれば記録・片付けをするが、記入項目や処理場所に抜け漏れが多い。","指示があれば分娩後4時間以内に胎盤の排出を確かめ、記録用紙に分娩時刻・産子数・死産数・処置を記入して片付けられる。","指示がなくても胎盤残留やMMAが疑われる発熱・乳房の異常に気づいてすぐ報告し、汚物を舎外に持ち出さず決められた場所で処理する。","胎盤残留が子宮炎につながることを理解し、分娩後の確認・記録・防疫を意識した片付けを新人に指導できる。"]}]},{"id":"cross-foster","no":"No.39","name":"送り里子","cat":"分娩管理","aspects":[{"id":"colostrum-first","name":"初乳摂取後の里子と対象選び","kanten":"初乳を飲ませてから、日齢・体重が近い健康な子豚を組み合わせ、乳頭数を超えないよう里子に出せるか。","levels":["初乳摂取が不十分なまま移動させ、体重差の大きい子豚を混ぜ、乳頭数を超える頭数でも気にしない。","指示があれば里子に出すが、初乳確認や対象選びに漏れが多い。","指示があれば初乳を飲ませてから日齢・体重の近い子豚をひと通り組める。","指示がなくても初乳摂取後の生後12〜24時間に里子を実施し、体重差を抑えて乳頭数内に収める。","初乳と免疫獲得の関係を理解し、里子の対象選びと頭数管理を新人に指導できる。"]},{"id":"health-exclude","name":"病気の子豚の除外と手指衛生","kanten":"下痢・呼吸異常のある子豚を里子に出さず、疑わしい子豚に触れたあと手袋交換・手指消毒ができるか。","levels":["健康チェックをせず病気の子豚も移し、疑わしい子豚に触れた手のまま健康な子豚を扱う。","指示があればチェックするが見落としが多く、手袋交換や手指消毒も抜けがち。","指示があれば移す前に下痢・呼吸の異常を確かめ、疑わしい子豚に触れたあとは手袋を替えるか消毒できる。","指示がなくても健康チェックと手指衛生を徹底し、判断に迷う子豚は移さず報告して指示をあおぐ。","里子が感染を広げる経路になることを理解し、健康チェックと衛生手順を新人に指導できる。"]},{"id":"move-handle","name":"静かな移動と受け入れ確認","kanten":"子豚を静かに抱えて1回で移し、母豚が受け入れるか見守り、拒否された時は無理をせず相談できるか。","levels":["子豚を乱暴に扱って何度も動かし、母豚が噛む・踏むなど拒否しても放置する。","指示があれば移せるが扱いが雑で、受け入れの見守りは他者まかせ。","指示があれば子豚を静かに抱えて1回で移し、移した直後の母豚の様子を見守れる。","指示がなくても冬は移動先の保温を先に確かめて短時間で移し、拒否されたら無理に押し付けず先輩に相談して別の母豚を検討する。","移動のくり返しがストレスで発育を止めることと母豚の咬みつきの危険を理解し、安全な移し方を新人に指導できる。"]},{"id":"follow-up","name":"里子後の飲乳確認と経過観察","kanten":"里子後24時間以内に乳頭への吸い付きとおなかのふくらみを確かめ、その後2〜3日観察を続けられるか。","levels":["移したあとの確認をせず、飲めていない子豚ややせ・下痢があっても気づかない。","指示があれば見るが確認が一度きりで、その後の観察は続かない。","指示があれば24時間以内に乳頭への吸い付きとおなかのふくらみを確かめられる。","指示がなくても2〜3日観察を続け、母豚の拒否・子豚のやせ・下痢に気づけばすぐ報告する。","飲めているかをおなかのふくらみで見分けるなど観察の要点を理解し、里子後のフォローを新人に指導できる。"]},{"id":"record-match","name":"マッチングシートと記録","kanten":"組み合わせをマッチングシートに書き、移した子豚に印をつけ、母豚番号・移した頭数を記録に残せるか。","levels":["シートも印も記録も残さず、どの子豚をどこへ移したか分からなくなる。","指示があれば書くが、記入漏れや印のつけ忘れが多い。","指示があればマッチングシートに組み合わせを書き、移した子豚に印をつけて母豚番号・頭数を記録できる。","指示がなくても移動のたびに記録し、移動後の頭数が乳頭数を超えていないかシートで確かめてズレがあれば報告する。","記録がその後の管理と個体追跡の土台になることを理解し、シートの書き方と印のつけ方を新人に指導できる。"]}]},{"id":"sow-lineup","no":"No.13","name":"母豚の並びの整理","cat":"施設管理","aspects":[{"id":"schedule-order","name":"分娩予定日順の整列と台帳反映","kanten":"交配日・分娩予定日のズレを抑えて整列させ、並び情報を台帳に反映できるか。","levels":["分娩予定日順に整列させず、並び情報も台帳に反映せず認識齟齬を招く。","指示があれば整列させるが、予定日順の徹底や台帳反映に漏れがある。","指示があれば分娩予定日順にひと通り整列できる。","指示がなくても予定日のズレを抑えて整列させ、並び情報を台帳に反映する。","整列と移動指示の連動を理解し、並び管理と台帳反映を新人に指導できる。"]},{"id":"early-preg-hold","name":"妊娠初期（35日以内）の移動除外","kanten":"交配日を確認して授精後35日以内の母豚をリストから外し、動かす場合は上司の許可を得られるか。","levels":["交配日を確認せず妊娠初期の母豚も動かし、胚死亡・流産のリスクを招く。","指示があれば外すが、交配日の確認漏れで妊娠初期の個体が混ざることがある。","指示があれば交配日を確認し、35日以内の母豚をひと通りリストから外せる。","指示がなくても交配日を必ず確認して外し、動かす必要があれば上司の許可を得る。","着床期の移動と流産の関係を理解し、リスト作成時の確認を新人に指導できる。"]},{"id":"compatibility","name":"体格差・攻撃性への配慮","kanten":"極端に弱い・大きい母豚や攻撃的な個体を同じ並びに入れず、負傷を防げるか。","levels":["体格差・攻撃性を考えず収容し、負傷が出ても気にしない。","指示があれば配慮するが、体格差や攻撃性の見極めに漏れがある。","指示があれば極端に弱い・大きい母豚を分けてひと通り配置できる。","指示がなくても体格差や初産・経産を見て収容し、血が出るひどいケンカは隔離して報告する。","収容と負傷・ストレスの関係を理解し、相性を考えた配置を新人に指導できる。"]},{"id":"calm-drive-safety","name":"追い板誘導と自分の安全確保","kanten":"追い板で1頭ずつ静かに誘導し、叩かず、壁との間に挟まれない位置と逃げ場を確保できるか。","levels":["複数頭を一度に追って叩き、壁との間に挟まれる危険な位置で作業する。","指示があれば追い板を使うが、急かしたり退避スペースの確保に漏れがある。","指示があれば追い板で1頭ずつひと通り静かに誘導できる。","指示がなくても叩かず豚のペースで誘導し、逃げ場を確保して挟まれを避ける。","豚の視界と動きの習性を理解し、安全な誘導と立ち位置を新人に指導できる。"]},{"id":"after-care","name":"移動後の水・エサ・カード確認","kanten":"収容後に飲水・エサ箱への到達を見届け、母豚カードを同時に移し、当日と翌日に見回れるか。","levels":["入れたら終わりにし、水・エサもカード移動も確認せず取り違えを招く。","指示があれば確認するが、カードの移し忘れや翌日の見回りに漏れがある。","指示があれば飲水・エサの確認とカードの移動をひと通りできる。","指示がなくても水・エサを見届けてカードを同時に移し、当日・翌日もケンカや食欲を見回る。","カード忘れが給餌ミスにつながることを理解し、移動後の確認を新人に指導できる。"]}]},{"id":"move-order","no":"No.10","name":"移動指示","cat":"施設管理","aspects":[{"id":"count-handover","name":"移動指示の復唱確認と頭数照合","kanten":"どのグループを・何頭・どこからどこへを復唱して確認し、移動元と移動先で頭数を数えて一致を確かめられるか。","levels":["指示を確認せず「たぶんこれ」で動かし、頭数も数えず誤移動を招く。","指示があれば確認するが、復唱やあいまいな点の確認、頭数照合に漏れが多い。","指示があれば移動頭数・グループを確認し、移動元でひと通り頭数を数えられる。","指示がなくても復唱して確認し、移動先でも数えて照合、合わなければ探して報告する。","数が合うまで終わりにしない意味を理解し、指示確認と頭数照合を新人に指導できる。"]},{"id":"route-biosec","name":"通路確認と移動先の清浄性","kanten":"通路の段差・滑り・障害物を先に確認し、移動先の清掃・消毒完了を確かめて汚染搬入を防げるか。","levels":["通路を確認せず、清掃・消毒完了前の汚染豚舎に搬入する。","指示があれば通路を見るが、移動先の清浄性確認に漏れがある。","指示があれば通路の危険をひと通り確認できる。","指示がなくても通路を先に点検し、移動先の清掃・消毒完了を確かめてから移動する。","移動と防疫の関係を理解し、通路点検と清浄性確認を新人に指導できる。"]},{"id":"sick-hold","name":"病豚・起立不能豚の移動中止","kanten":"立てない豚・明らかに具合の悪い豚を無理に動かさず、その場で指導係に報告できるか。","levels":["立てない豚も無理に追って動かし、悪化させても報告しない。","指示があれば止めるが、具合の悪い豚の見極めに漏れがある。","指示があれば病豚を移動から外し、ひと通り報告できる。","指示がなくても移動前に豚を見て病豚を外し、その場で指導係に報告する。","無理な移動が悪化を招くことを理解し、移動可否の判断を新人に指導できる。"]},{"id":"calm-drive","name":"少頭数ずつの静かな誘導","kanten":"3〜5頭ずつ叩かず急かさず豚のペースで誘導し、止まったら離れて落ち着きを待てるか。","levels":["一度に大量に出して叩き・大声で追い、豚をパニックにさせる。","指示があれば少頭数で追うが、急かしたり無理に押すことがある。","指示があれば少頭数ずつ静かにひと通り誘導できる。","指示がなくても豚のペースで誘導し、止まったら少し離れて落ち着いてから再開する。","豚の視界と習性を理解し、パネルで一本道を作る静かな追い方を新人に指導できる。"]},{"id":"mix-watch","name":"混群後のケンカ観察と後始末","kanten":"混群後しばらくケンカを観察して血の出る咬傷を報告し、道具の洗浄・消毒と踏込消毒を守れるか。","levels":["混ぜたまま立ち去り、ケンカも見ず道具の消毒もしない。","指示があれば観察するが、咬傷の報告や道具の消毒に漏れがある。","指示があれば混群後の観察と道具の洗浄・消毒をひと通りできる。","指示がなくてもしばらく観察して血の出る咬傷を報告し、区域をまたげば長靴を消毒する。","咬傷が病気の入口になることを理解し、混群後の観察と防疫を新人に指導できる。"]}]},{"id":"move-preg","no":"No.25","name":"妊娠舎→交配舎・育成舎 移動","cat":"施設管理","aspects":[{"id":"list-check","name":"移動リスト照合と妊娠初期除外","kanten":"個体番号・頭数・行き先をリストで照合し、交配後35日以内の妊娠豚の混入を防げるか。","levels":["リストを見ずに動かし、妊娠初期の豚を混ぜて流産のリスクを招く。","指示があれば照合するが、35日以内の混入チェックに漏れがある。","指示があれば個体番号・頭数・行き先をひと通り照合できる。","指示がなくてもリストと照合し、35日以内の妊娠豚が混ざっていないか必ず確認する。","着床期の移動リスクを理解し、リスト照合とマーキングの要点を新人に指導できる。"]},{"id":"quiet-move","name":"斜め後ろからの静かな誘導","kanten":"母豚の斜め後ろに立ち追い板で視界をさえぎって少頭数ずつ誘導し、絶対に走らせず、止まったら待てるか。","levels":["一度に大量に追い出して走らせ、転倒・骨折の危険を招く。","指示があれば追うが、立ち位置や止まった時の対応に漏れがある。","指示があれば斜め後ろから追い板で視界をさえぎり、少頭数ずつひと通り誘導できる。","指示がなくても母豚のペースで歩かせ、止まったら小さく声をかけて待ち、横になったら無理に起こさない。","走らせると転倒・骨折につながることを理解し、静かな追い方を新人に指導できる。"]},{"id":"dest-check","name":"移動先の受け入れ準備と水・エサ確認","kanten":"移動先の豚房が空いて清掃・消毒済みか、給水ニップルから水が出るか・給餌器の位置を事前に確認し、入れた直後にも飲めているか見届けられるか。","levels":["受け入れ準備を確認せず搬入し、水が出ない豚房に入れても気づかない。","指示があれば確認するが、ニップルを押しての水確認や入れた直後の見届けに漏れがある。","指示があれば豚房の空き・清掃消毒と水・エサの位置をひと通り確認できる。","指示がなくても準備が整うまで移動を始めず、入れた直後も水が飲めているか見届ける。","受け入れ準備不足のリスクを理解し、移動先確認の要点を新人に指導できる。"]},{"id":"biosec-mat","name":"舎間移動の防疫（消毒マット）","kanten":"舎間の消毒マットの液を確認・充填し、消毒済みの長靴で他群と接触しない動線を守れるか。","levels":["消毒マットが空でも素通りし、防疫を無視した動線で移動する。","指示があればマットを通るが、液の確認・充填や動線の意識に漏れがある。","指示があればマットの液を確認し、防疫手順をひと通り守れる。","指示がなくても液を確認・充填し、他群と接触しない動線で移動する。","舎間移動と病気の持ち込みの関係を理解し、防疫手順を新人に指導できる。"]},{"id":"record-plate","name":"頭数照合と記録・プレート更新","kanten":"頭数をリストと照合し、移動日時・個体番号・移動元先を記録して豚房プレートも同時に更新できるか。","levels":["頭数も数えず記録もせず、古いプレートを残して取り違えを招く。","指示があれば記録するが、頭数照合やプレート更新に漏れがある。","指示があれば頭数を照合し、記録とプレート更新をひと通りできる。","指示がなくても照合して記録し、プレートを同時に更新して古い情報を残さない。","古い表示が取り違え・給餌ミスを招くことを理解し、記録と更新の徹底を新人に指導できる。"]}]},{"id":"scraper","no":"No.19","name":"スクレーパー動作確認","cat":"施設管理","aspects":[{"id":"safety-power","name":"電源遮断など安全手順","kanten":"確認・清掃の前に必ず電源を切り、回転部・可動部に安全に触れられるか。","levels":["電源を切らずに点検・清掃し、回転部に触れて事故の危険を招く。","指示があれば電源を切るが、徹底が甘く危険な操作が残る。","指示があれば確認・清掃前に電源をひと通り切れる。","指示がなくても必ず電源を切ってから安全に点検・清掃する。","回転部の危険を理解し、電源遮断など安全手順を新人に指導できる。"]},{"id":"visual-clear","name":"刃・通り道の目視点検と異物除去","kanten":"刃の曲がり・欠けを端から端まで照らして確認し、通り道の糞のかたまり・異物を取り除けるか。","levels":["目視点検をせず、通り道の異物も放置して詰まり・故障を招く。","指示があれば見るが、刃の端までの確認や異物除去に漏れがある。","指示があれば懐中電灯で刃と通り道をひと通り点検し、異物を除去できる。","指示がなくても刃を端から端まで照らして確認し、異物を手袋をして取り除く。","異物が詰まり・故障につながることを理解し、目視点検の着眼点を新人に指導できる。"]},{"id":"run-check","name":"試運転での動きとかき出し確認","kanten":"試運転で止まり・引っ掛かり・遅れがないかを見て、通り道に糞が残っていないか確認できるか。","levels":["動作確認をせず、途中停止や糞の残りがあっても気づかない。","指示があれば動かすが、動きの遅れやかき残しの確認に漏れがある。","指示があれば試運転してスムーズな動きとかき出しをひと通り確認できる。","指示がなくても動く部分から体を離して試運転し、いつもとの動きの違いに早く気づく。","正常時の動作音・速さを覚えて比べる意味を理解し、試運転確認のコツを新人に指導できる。"]},{"id":"wear-report","name":"チェーン・ワイヤ点検と異常時の停止・報告","kanten":"チェーン・ワイヤの張り具合を手で押して確かめ、摩耗・錆を照らして点検し、異常があれば無理に動かさず自分で修理せず報告できるか。","levels":["張り・摩耗を見ずゆるみやすり減りを放置し、糞の滞留や大きな故障を招く。","指示があれば点検するが、たるみやすり減りの見極めに漏れがある。","指示があれば張り具合と摩耗・錆をひと通り点検し、メモを残せる。","指示がなくても毎回点検し、異常があれば無理に動かさず電源を切って報告する。","早期発見が大きな故障を防ぐことを理解し、点検の着眼点と異常時対応を新人に指導できる。"]},{"id":"record-report","name":"点検結果の記録と具体的な報告","kanten":"「異常なし」でも点検記録用紙に記入し、異音の種類など異常の内容を具体的に伝えられるか。","levels":["点検しても記録を残さず、異常があっても内容を伝えない。","指示があれば記録するが、内容があいまいで抜け漏れが多い。","指示があれば異常なしを含めてひと通り記録できる。","指示がなくても毎回記録し、金属音・きしみ音など異音の種類を具体的に報告する。","具体的な報告が原因特定を早めることを理解し、記録と報告の書き方を新人に指導できる。"]}]},{"id":"fan-clean","no":"No.29","name":"ファン清掃","cat":"施設管理","aspects":[{"id":"power-off","name":"電源遮断と安全な清掃","kanten":"作業前に必ず電源を切り、モーター・配線に水をかけずに清掃できるか。","levels":["電源を切らずに清掃して回転部に接触し、モーターや配線に水をかける危険な作業をする。","指示があれば電源を切るが、水かけ回避などの徹底が甘い。","指示があれば電源を切り、羽根が完全に止まるのを待ってから作業できる。","指示がなくても電源を切り、モーターや配線を避けて安全に清掃する。","感電・巻き込みの危険を理解し、安全な清掃手順を新人に指導できる。"]},{"id":"dry-first","name":"乾いた埃払いと羽根裏の洗浄","kanten":"水をかける前にシャッター・防鳥ネットの埃を乾いたまま払い、羽根の裏側まで汚れを落とせるか。","levels":["いきなり水をかけて埃を泥にし、羽根の裏の汚れも残したままにする。","指示があれば清掃するが、乾いた埃払いの先行や羽根裏の洗浄に漏れがある。","指示があれば埃を先に払い、羽根・シャッター・ネットをひと通り洗える。","指示がなくても乾いた状態から順に清掃し、羽根裏やこびりついた汚れまで落とす。","汚れと風量低下の関係を理解し、効率のよい清掃の順序を新人に指導できる。"]},{"id":"belt-check","name":"ファンベルトの張り・劣化点検","kanten":"指で押して1〜2cm沈む張りかを確かめ、ひび割れ・摩耗・ほつれを見つけて指導係に報告できるか。","levels":["ベルトを点検せず、劣化を放置して風量低下や故障を招く。","指示があれば見るが、張り具合やひび割れ・ほつれの見極めに漏れがある。","指示があれば指で押して張りを確かめ、傷みの有無をひと通り点検できる。","指示がなくても清掃のたびに点検し、ひび割れ・摩耗・ほつれがあれば交換が必要と報告する。","ベルトの寿命が1〜2年であることを踏まえ、劣化のサインと点検を新人に指導できる。"]},{"id":"restart-verify","name":"シャッター開閉と試運転確認","kanten":"シャッターが軽く開閉するか手で確かめ、水気が切れてから試運転して回転・風・異音を確認できるか。","levels":["洗いっぱなしで確認せず、動きの重さや異音があっても放置する。","指示があれば確認するが、開閉の重さや異音の聞き分けに漏れがある。","指示があれば水気が切れてから電源を入れ、回転と風の出をひと通り確認できる。","指示がなくても開閉・回転・風・異音を確かめ、キュルキュル音などに気づけば報告する。","動きの重さや異音が風量低下・故障のサインと理解し、確認の仕方を新人に指導できる。"]},{"id":"notify-record","name":"作業の周知と清掃記録・報告","kanten":"清掃前に指導係へ一言伝えてから電源を切り、清掃日と異音・破損などの気づきを記録・報告できるか。","levels":["誰にも伝えず勝手に電源を切り、清掃日も気づきも残さない。","指示があれば伝えて記録するが、気づきの報告に抜けが多い。","指示があれば作業前に周知し、清掃日と気づきをひと通り記録できる。","指示がなくても周知してから作業し、換気設定は変えずに異音・破損を記録・報告する。","周知と記録が事故・故障防止につながることを理解し、報告の要点を新人に指導できる。"]}]},{"id":"pad-tank","no":"No.30","name":"パドタンク清掃（夏季）","cat":"施設管理","aspects":[{"id":"regular-clean","name":"定期清掃と藻・ぬめりの早期発見","kanten":"夏は週1〜2回の目安で清掃し、緑色の水・ぬめりを清掃のサインとして見逃さないか。作業前に電源を切り水を抜けるか。","levels":["清掃を怠って藻・ぬめりを発生させ、電源も切らずに作業する。","指示があれば清掃するが、頻度や電源遮断・排水の手順に漏れがある。","指示があれば電源を切り水を抜いて、ひと通り清掃できる。","指示がなくても目安の頻度で清掃し、緑色の水・ぬめりを見たら回数に関係なく清掃する。","クーリング性能と衛生の関係を理解し、定期清掃の手順とサインを新人に指導できる。"]},{"id":"soft-wash","name":"傷をつけないやさしい洗い方","kanten":"柔らかいブラシで底・角・水面の線をやさしくこすり、高圧洗浄機を使わずすすぎ水が透明になるまで洗えるか。","levels":["硬いブラシや高圧で強くこすり、タンクに傷をつけてかえって汚れやすくする。","指示があれば洗うが、力加減や底・角の洗い残しにムラがある。","指示があれば柔らかいブラシでやさしく、汚れやすい所をひと通り洗える。","指示がなくてもすすぎ水が透明になるまで洗い、高圧をかけずに仕上げる。","傷に汚れがたまる原理を理解し、タンクを傷めない洗い方を新人に指導できる。"]},{"id":"filter-pipe","name":"フィルター・ポンプ・配管の点検","kanten":"フィルターの詰まりを除いて網の目まで洗い、ポンプ・配管の水漏れ・ゆるみを点検し、破れや異常を報告できるか。","levels":["タンクだけ洗って満足し、フィルターの詰まりを放置してポンプに過負荷をかける。","指示があれば点検するが、網の目の詰まりや配管の確認に漏れがある。","指示があればフィルターを洗い、ポンプ・配管をひと通り目視点検できる。","指示がなくても毎回一緒に点検し、破れ・水漏れがあれば自分で直さず報告する。","詰まりとポンプ故障の関係を理解し、フィルター・配管点検を新人に指導できる。"]},{"id":"refill-flow","name":"張り直しと均一な水回り確認","kanten":"決められた水位まできれいな水を張り直して再稼働し、パッド全体が均一に濡れるかを見届けられるか。","levels":["水を張って電源を入れたら立ち去り、パッドに乾いた部分があっても気づかない。","指示があれば確認するが、水位やパッドの濡れ具合の確認に漏れがある。","指示があれば水位まで張り直し、循環とパッドの濡れをひと通り確認できる。","指示がなくても循環開始まで見守り、一部だけ濡れない時は詰まりを疑って報告する。","均一な濡れと冷却効果の関係を理解し、再稼働確認の要点を新人に指導できる。"]},{"id":"record-heat","name":"記録・報告と夏場の自己管理","kanten":"清掃日と気づいた異常を記録・報告し、暑い時期は自分の熱中症にも注意して作業できるか。","levels":["清掃しても記録せず、体調が悪くても無理を続けて報告しない。","指示があれば記録するが、異常の報告や水分補給に漏れがある。","指示があれば清掃日と気づきをひと通り記録・報告できる。","指示がなくても次回がわかる記録を残し、こまめに水分をとって体調の異変はすぐ伝える。","記録が清掃サイクルの維持につながることを理解し、記録と夏場の安全を新人に指導できる。"]}]},{"id":"feed-switch","no":"No.20","name":"エサスイッチ","cat":"施設管理","aspects":[{"id":"switch-position","name":"スイッチ位置と異常時の停止","kanten":"自動・手動・切の位置を確認し、ホッパー空・詰まり・異音時はすぐオフにできるか。","levels":["スイッチ位置を確認せず、ホッパー空や詰まり・異音があってもオフにしない。","指示があれば位置を確認するが、異常時の停止対応に漏れがある。","指示があれば自動・手動・切の位置をひと通り確認できる。","指示がなくても位置を確認し、ホッパー空・詰まり・異音時はすぐオフにする。","給餌設備のトラブルを理解し、スイッチ操作と異常時対応を新人に指導できる。"]},{"id":"label-stock","name":"飼料の種類・残量の事前確認","kanten":"ホッパーの飼料をラベルと照合し、のぞき窓や側面を叩いた音で残量を確かめてから運転できるか。","levels":["ラベルも残量も確認せず運転し、飼料の種類違いや空運転を招く。","指示があれば確認するが、声出し照合や残量の見極めに漏れがある。","指示があればラベル照合と残量確認をひと通りできる。","指示がなくても豚舎名と飼料名を声に出して照合し、残量を確かめてから動かす。","種類違いが消化不良を招くことを理解し、飼料確認の徹底を新人に指導できる。"]},{"id":"bridging","name":"ブリッジング詰まりの安全対処","kanten":"満杯なのに飼料が落ちない時にブリッジングを疑い、必ずスイッチを切ってから叩く・突くで対処できるか。","levels":["動かしたまま詰まりに手を出し、直らなくても報告しない。","指示があれば対処するが、先に電源を切る手順や報告に漏れがある。","指示があればスイッチを切ってから外から叩く対処をひと通りできる。","指示がなくてもブリッジングを疑って安全に対処し、直らなければ無理せず報告する。","飼料がアーチ状に固まる仕組みを理解し、安全な対処手順を新人に指導できる。"]},{"id":"trough-watch","name":"トラフ量と食べ具合の見回り","kanten":"底がうっすら見える目安でトラフ量を確かめ、残餌や切り替え中の下痢に気づいて報告できるか。","levels":["給餌後の見回りをせず、山盛り・空のトラフや残餌を放置する。","指示があれば見回るが、量の目安や糞の状態の確認に漏れがある。","指示があれば1房ずつのぞき、トラフ量と残餌をひと通り確認できる。","指示がなくても給餌後に見回り、残餌や下痢の増加に気づいてすぐ報告する。","残餌が体調不良のサインと理解し、トラフ量の目安と観察を新人に指導できる。"]},{"id":"timer-record","name":"タイマー変更後の動作確認と記録","kanten":"設定変更は決められた人が行い、タイマー変更後は動作確認し、切り替え日を記録できるか。","levels":["権限のない者が設定を変え、変更後の動作確認もせず切り替え日も記録しない。","指示があれば確認するが、動作確認や記録に漏れがある。","指示があればタイマー変更後の動作をひと通り確認できる。","指示がなくても変更後に実際に1回動かして確認し、切り替え開始日と内容を記録する。","設定変更と給餌事故の関係を理解し、動作確認と記録の徹底を新人に指導できる。"]}]},{"id":"water-check","no":"","name":"飲水器の点検","cat":"施設管理","aspects":[{"id":"flow-measure","name":"流量の確認（全ニップル）","kanten":"ニップル式の飲水器で、下にカップを置いて15秒など一定時間受けた量を1分に換算し、全ニップルの流量が肥育豚の目安に合うか確かめられるか。","levels":["流量を測らないまま、飲水器の点検を済ませたことにする。","指示があれば流量を測るが、一部のニップルだけで済ませたり、換算を間違えたりして、結果は他者まかせ。","指示があればカップで15秒など一定時間受けて1分に換算し、肥育豚の目安1.0〜1.5L/分に合うか全ニップルで確認できる。","指示がなくても毎週、全豚房の全ニップルを測り、1.0L/分未満と1.5L/分超のどちらも上長に報告する。","流量が足りないニップルがあると水の取り合いになることを理解し、一定時間で受ける測り方と換算のしかたを新人に指導できる。"]},{"id":"height-fit","name":"取り付け高さの確認","kanten":"ニップルの高さが豚の大きさ（肥育前期か後期か）に合っているか見て、高すぎ・低すぎを直したり報告したりできるか。","levels":["ニップルの高さを見ず、豚が飲みにくそうでも、そのままにして気にしない。","指示があれば高さを見るが、前期と後期の違いを意識せず、ずれていても直すのは他者まかせ。","指示があれば床から肥育前期（25〜60kg）45〜55cm、後期（60〜120kg）60〜75cmの目安と照らし、体重でどちらかを確かめて、高すぎ・低すぎのニップルを見つけられる。","指示がなくても豚の成長で合わなくなった高さに気づき、直すか上長に報告して、直した後も豚が飲めるか見る。","高すぎると小さい豚が飲めず、低すぎると水のロスが増えることを理解し、豚の肩より少し上という高さの見方を新人に指導できる。"]},{"id":"clog-leak","name":"詰まり・出っぱなしの切り分け","kanten":"水が出ない・出が悪い・出っぱなし・水が汚いときに、原因を順に切り分け、元栓・ニップル・フィルター・配管に合った対処と、漏水時の元栓閉止と報告ができるか（不具合が無ければ症状ごとの最初の行動を口頭で聞く）。","levels":["水が出ないニップルや出っぱなしの水を見ても、原因を調べず放置し、床の濡れも気にしない。","指示があれば不具合を見に行くが、原因を切り分けず、対処の判断は他者まかせ。","指示があれば元栓を確かめ、ニップルの分解清掃か交換、フィルター清掃、配管の洗い流しから原因に合う対処を選べる。漏水時は元栓を閉めて報告する。","指示がなくても床の濡れすぎの原因を調べて対処し、水の臭い・色・濁りも見て、水質の異常を上長に報告する。","症状と原因と対処の対応を理解し、元栓から順に切り分ける手順を新人に指導できる。"]},{"id":"freeze-outage","name":"凍結・断水時の対応","kanten":"凍結に気づいたらぬるま湯で解凍し（熱湯は使わない）、断水ならバケツやホースで仮設給水し、長く止まっていた豚房は止まっていた時間を上長に伝え飲ませ方の指示を受け、水が戻った後はふらつきやけいれんがないか見られるか（季節外は口頭で最初の行動を聞く）。","levels":["凍結や断水に気づかず、水が出ない豚房があっても確かめに行かない。","指示があれば水の出を見るが、解凍や仮設給水の手順が抜けたり後回しになったりして、報告も遅れる。","指示があれば、凍結はぬるま湯で解凍し熱湯は使わない。断水はバケツやホースで仮設給水するが、長く止まった房は上長に時間を伝え飲ませ方の指示を先に受ける。","指示がなくても冬は毎朝、全箇所の凍結を確かめ、水が出ない豚房へ仮設給水する。水が戻った後にふらつき・けいれん・首を反らす豚がいれば即報告する。","水が長く止まった後に一気に飲むと塩中毒が起きることと熱湯を使わない理由を理解し、止まっていた時間を伝えることと仮設給水の手順を新人に指導できる。"]},{"id":"season-record","name":"季節の点検ポイント","kanten":"今の季節に水まわりで何を見るかを答えられるか。","levels":["今の季節に水まわりで何を見るか考えず、季節に関係なくいつも同じ見方で済ませる。","指示があれば今の季節に見る点を話すが、項目が抜けたり別の季節の点検を答えたりする。","指示があれば今の季節に見る点（夏は水温・貯水タンク・配管の断熱、冬は保温材）を答えられる。","指示がなくても今の季節に見る点を実際に点検し、異常を上長に報告する。","季節で水まわりに見る点が変わる理由を理解し、新人に指導できる。"]}]},{"id":"vent-temp","no":"","name":"換気・温度管理（肥育）","cat":"施設管理","aspects":[{"id":"read-temp","name":"温度の読み方","kanten":"温度計を豚の高さに置いて朝・午後・夕方に読み、農場で決めた適正範囲と比べ、最高最低の差や計器の故障にも気づけるか。","levels":["温度計の位置も確かめず、舎内の温度を読まないまま過ごし、壊れた計器の値も疑わずに使う。","指示があれば温度を読むが、天井近くなど豚の高さでない値を使ったり、読む時間帯が抜けたりして他者まかせ。","指示があれば豚の高さ（床上30〜50cm）の温度計を朝・午後・夕方に読み、最高最低温度計の差と、農場で決めた適正範囲との比較を確認できる。","指示がなくても豚の高さ（床上30〜50cm）の温度計を朝・午後・夕方に読み、適正範囲から外れた日や昼夜差の大きい日・計器の異常を上長に報告する。","豚の高さで測る理由と計器の故障が管理を誤らせることを理解し、温度の読み方を新人に指導できる。"]},{"id":"pig-signs","name":"豚の行動で読む暑さと温度ムラ","kanten":"数字だけに頼らず、豚の呼吸・姿勢・集まり方から暑さや温度ムラの異常に気づけるか。","levels":["豚の様子を見ず、口を開けて呼吸する豚や一か所に固まる豚がいても気づかない。","指示があれば豚の様子を見るが、口呼吸や特定の場所への集中を見落とし、気づいても他者まかせにする。","指示があれば、口を開けて呼吸する豚や横たわって動かない豚は暑さの可能性、一か所に固まる豚は温度ムラの可能性と判断できる。","指示がなくても暑い日に口呼吸や横たわって動かない豚がいれば暑熱の緊急として上長に伝え、農場の手順で耳の裏に水をかけて冷やし、固まる豚は温度ムラや隙間風を疑って上長に報告する。","暑熱が命に関わること、固まりは温度ムラのサインであることを理解し、豚の見方を新人に指導できる。"]},{"id":"manual-adjust","name":"カーテン・インレットの調整","kanten":"カーテンや手動式のインレットを一気に動かさず少しずつ動かし、冷風が豚に直接当たらないよう隙間や破れも確認できるか（自動制御なら、ずれに気づいたら上長に報告）。","levels":["カーテンや手動式のインレットを天気や時間帯に関係なく放置するか、寒い朝晩に一気に全開にして豚に冷風が当たる。","指示があれば開け閉めするが、一気に動かしたり隙間や破れの確認が抜けたりして、他者まかせになる。","指示があれば朝晩や天気に合わせてカーテンや手動式のインレットを少しずつ動かして風の当たりを確かめ、隙間・破れ・カーテンの裾の密着を確認できる。","指示がなくても朝晩や天気、豚への風当たりに応じて手動のカーテンやインレットを少しずつ調整し、自動制御のずれや直せない破れ・隙間は上長に報告する。","インレットの開度が小さいと風は速く遠くへ届き大きいと遅く近くに落ちることを理解し、調整を新人に指導できる。"]},{"id":"never-stop","name":"換気を止めない判断","kanten":"寒くても最低限の換気を止めず、目のチクチクなど臭いや体感から換気不足に気づき、換気と除糞でガス対策もできるか。","levels":["寒いからとカーテンを閉め切って換気を止め、臭いや目の刺激があっても何もしない。","指示があれば換気を残すが、寒い日は閉め切りがちで臭いや目の刺激を確かめず、他者まかせになる。","指示があれば寒い日も最低限の換気を残してカーテンを閉め切らず、目がチクチクする時は換気を増やせる。","指示がなくても換気を止めない。目が痛い・涙が出る時は直ちに換気を最大にし、自動制御なら決められた人にすぐ連絡して上長に報告する。","換気を止めるとアンモニアが溜まること、硫化水素は高濃度で臭いを感じなくなること、攪拌中はピットに入らず換気を最大にすることを理解し、チクチク時の換気増と除糞優先を新人に指導できる。"]},{"id":"fan-failure-first","name":"ファン故障時の初動","kanten":"ファンの異常に気づき、ブレーカーを確認し、羽根に近づく前に電源を切って完全停止を確かめてからベルトと異物を見て、直せなければ報告して代替換気を確保できるか。","levels":["ファンが止まっても風や音の変化に気づかず放置するか、回っているファンに手や物を近づける。","指示があればファンを見るが、ブレーカーの確認や電源を切る手順が抜け、代替換気や報告を他者まかせにする。","指示があればブレーカーを確認し、ベルトや羽根の異物を見る前に電源を切って完全に止まるのを確かめ、直せなければ上長に報告できる。","指示がなくても風や音、臭い、豚の呼吸で異常に気づき、ブレーカー確認後に電源を切り完全停止を確かめてからベルトと異物を見て上長に報告し、カーテンや扉を開けて代替換気を確保し、周辺の豚をこまめに見る。","ファンが一台でも止まれば周辺の豚に影響が出ること、電源を切って完全に止まってから触れる理由を理解し、故障時の初動を新人に指導できる。"]}]},{"id":"vent-controller","no":"","name":"換気設定確認（ウインドレス）","cat":"施設管理","aspects":[{"id":"read-record","name":"設定値の読み取りと記録","kanten":"コントローラーの設定温度・換気ステージ・最低換気量・タイマー（ヒーターがある場合はその設定も）を画面で読み取り、用紙に正確に記録できるか（読み取りの正確さを見る）。","levels":["コントローラーの設定を見ず記録もしないため、今どんな設定になっているか分からない。","指示があれば画面を見るが、項目の読み落としが残り、記録は他者まかせ。","指示があれば、設定温度・換気ステージ・最低換気量・タイマー（ヒーターがあればその設定も）を画面から読み取り、用紙に転記できる。","指示がなくても全項目を漏れなく読み、前週の記録と画面値の食い違いに気づき、用紙か（農場の決まりで認められていれば）画面の撮影で記録に残す。","設定が換気の出方を決めることを理解し、読み取りと記録の手順を新人に指導できる。"]},{"id":"verify-actual","name":"設定と実際の照合","kanten":"画面の設定と、今のステージで動くはずのファン・シャッター・インレットの状態を見比べ、画面の温度表示と手持ちの温度計の差にも気づけるか。","levels":["画面の表示どおりに動いていると思い込み、ファンやインレットの実際の動きを見に行かない。","指示があればファンを見に行くが、シャッターやインレットの開き具合の確認が抜け、ずれは他者まかせ。","指示があれば回転部に触れず、今のステージで回るはずのファンが回りシャッターが開いているか、止まるファンのシャッターが閉じているか、インレットの開きを確認できる。","指示がなくても設定と実際を見比べ、インレットの開きが画面の設定と合うか、画面の温度表示と手持ちの温度計の差も確かめ、ずれを上長に報告する。","表示と実際がずれることがある理由を理解し、照合のポイントを新人に指導できる。"]},{"id":"change-rule","name":"変更の権限と相談","kanten":"設定の変更は決められた人だけが行うと理解し、変更が必要と思ったときに自分で触らず、上長または決められた人に相談できるか。","levels":["寒い暑いと感じて自分の判断でコントローラーの設定を触り、誰にも相談しない。","指示があれば触らないが、変更が必要と思っても上長または決められた人に相談せず放置する。","指示があれば、設定を自分では変えず、変更が必要と思う時は上長または決められた人に相談できる。","指示がなくてもコントローラーを触らず、変更が必要と感じたら自分から決められた人に伝え、変更は決められた人に委ねる。","換気不足で有害ガスや湿気がたまり、呼吸器の病気につながる理由を理解し、変更は決められた人に任せて上長または決められた人に相談する流れを新人に指導できる。"]},{"id":"weekly-review","name":"毎週の設定記録と見直し提案","kanten":"今週の設定記録に頭数の増減と体重帯の変化をそろえて毎週上長に渡し、設定記録を見て見直し時期だと自分から言えるか（当日の記録用紙と口頭で見る）。","levels":["一度決めた設定は変わらないと考え、頭数や体重帯の変化を記録に添えず、上長にも渡さない。","指示があれば設定記録を渡すが、頭数の増減や体重帯の変化が抜けたり、渡すのが遅れたりする。","指示があれば、今週の設定記録と頭数・体重帯を用紙にそろえて渡せ、口頭でも内容を説明できる。","指示がなくても毎週、頭数・体重帯をそろえた設定記録を上長に渡し、農場が決めた見直し時期に当たると自分から伝える。","自動換気でも設定の見直しに事実の記録が要る理由を理解し、何を書き添えて渡すかを新人に指導できる。"]},{"id":"power-backup","name":"停電時の対応","kanten":"停電のとき、全体か一部かとブレーカーの確認・報告・発電機での換気ファンと給水ポンプ優先・発電機が使えないときの農場の手順に定めた代替換気ができるか。","levels":["停電が起きても対応せず、換気ファンが止まったままでも放置する。","指示があればブレーカーを見るが、報告や発電機の手順が抜け、換気の確保は他者まかせ。","指示があれば全体停電か一部か、ブレーカーが落ちているかを確認して上長に報告し、発電機の起動手順と換気ファン・給水ポンプ優先を説明できる。","指示がなくても停電時にすぐ報告し、訓練を受けた人なら発電機を起動し、そうでなければ決められた人を呼び、使えない時は農場の手順に定めた代替換気を行う。","夏の停電は換気が最優先で、短い時間で豚が危険になる理由を理解し、発電機の毎月の試運転・燃料確認を含め新人に指導できる。"]}]},{"id":"density-grouping","no":"","name":"密度管理・群分け（肥育）","cat":"施設管理","aspects":[{"id":"area-calc","name":"面積から上限頭数を出す","kanten":"農場で決めた体重帯ごとの必要面積で豚房の面積を割り、小数点以下を切り捨てて、入れてよい上限頭数を出せるか。","levels":["豚房の面積も体重帯ごとの必要面積も確かめず、頭数が増えても入れられるだけ入れてしまう。","指示があれば豚房の面積を確かめて割るが、体重帯の選び方を誤ったり、結果の確認を他者まかせにしたりする。","指示があれば、自分の担当の豚房の面積を農場で決めた体重帯の必要面積で割り、小数点以下を切り捨てた上限頭数を出せる。","指示がなくても体重帯が変わる頃に、担当する全部の豚房の上限頭数を出し直して、結果を上長に伝える。","体重が増えると必要面積も増えることを理解し、面積と頭数から上限を出す方法を新人に指導できる。"]},{"id":"crowd-signs","name":"過密の兆候を見抜く","kanten":"尾かじり・耳かじり、けんか、エサ箱や飲水器の渋滞、糞で汚れた豚、皮膚の傷、全頭が同時に横になれないなど過密の兆候に気づき、兆候のある豚房を上長に報告できるか。","levels":["尾かじり・けんか・エサ箱の渋滞があっても、いつものことと見過ごし、豚房の混み具合を見ない。","指示があれば豚房を見るが、兆候の一部しか拾えず、報告は他者まかせ。","指示があれば、かじり・けんか・エサ箱や飲水器の渋滞・糞汚れ・皮膚の傷・全頭が同時に横になれないかを豚房ごとに確かめ、上長に報告できる。","指示がなくても見回りのたびに兆候を確かめ、兆候が出ている豚房の番号と様子を上長に報告する。","過密も兆候の原因の一つだと理解し、主な兆候の見方を新人に指導できる。"]},{"id":"pen-count-fit","name":"移動後の頭数を現物で確かめる","kanten":"移動後の豚房ごとの頭数が、決まっている上限頭数の内かを、豚房の豚を実際に数えて確かめ、超えていれば上長に伝えられるか。","levels":["移動したあとの豚房の頭数を確かめず、上限を超えていても気にしない。","指示があれば移動後の豚房を見るが、上限頭数と見比べず、超えていても伝えるのは他者まかせ。","指示があれば、移動後の移動元・移動先の豚房の頭数を現物で数え、上限頭数の内に収まっているか言える。","指示がなくても移動のたびに、移動元・移動先の頭数を現物で確かめ、上限を超える豚房があれば上長に伝える。","移動で片方が過密になり得る理由を理解し、移動後に現物で頭数を確かめる手順を新人に指導できる。"]},{"id":"split-judge","name":"分ける案を比べて上長に相談","kanten":"過密を見たとき、空き豚房へ移す案と出荷が近い豚を先に出す案を比べ、放置せず上長に案を出して相談できるか。新しい群を作るときは、移動を最小限の回数にして夕方〜夜に行う案を添える。","levels":["過密に気づいても「仕方ない」と放置し、誰にも相談しない。","指示があれば相談するが、どう分ければよいかは考えず、空き豚房の有無や出荷予定も確かめない。","指示があれば、空き豚房へ移すか出荷が近い豚を先に出すかを比べて案を言える。新しい群を作る時は、移動を最小限の回数で夕方〜夜に行う案を添える。","指示がなくても過密の豚房に気づいた時点で、空き豚房と出荷予定を確かめて案を作り、案を添えて上長に相談する。新しい群を作る時は移動を最小限の回数で夕方〜夜に行う案を添える。","放置が尾かじりや成長遅延につながることを理解し、「暗い時間は闘争が減る」と説明しながら分け方の選び方を新人に指導できる。"]},{"id":"count-record","name":"豚房の頭数を数えて照合","kanten":"豚房の頭数を実際に数えて記録と照合し、合わない時はその日のうちに上長に伝えられるか。","levels":["豚房の頭数を数えず、記録の頭数をそのまま信じて、ずれていても確かめない。","指示があれば豚房の頭数を数えるが、数え間違いが多く、記録と照合せず、合わない時の確認は他者まかせ。","指示があれば、豚房の頭数を実際に数えて記録の頭数と照合し、合わない時は上長に伝えられる。","指示がなくても豚房の頭数を数えて記録と照合し、合わなければその日のうちに記入漏れ・数え間違い・脱柵を確かめて上長に伝える。","頭数が実際とずれると過密の判断を誤り原因の特定も難しくなることを理解し、数えて照合する手順を新人に指導できる。"]}]},{"id":"daily-report","no":"No.05","name":"日報記入","cat":"記録管理","aspects":[{"id":"accurate-timely","name":"その場での正確な記録","kanten":"記憶頼りのまとめ書きを避け、その場で事実と数字を正確に記録できるか。","levels":["記憶頼りで後からまとめ書きし、数値の単位ズレなど不正確な記録をする。","指示があれば記録するが、まとめ書きや単位ズレが多い。","指示があればその場で事実と数字をひと通り正確に記録できる。","指示がなくてもその場で正確に記録し、単位や数値を確かめる。","記録の正確さが早期発見・改善に不可欠と理解し、正確な記入を新人に指導できる。"]},{"id":"shared-rule-use","name":"共通ルールでの記入と活用","kanten":"全員が同じルールで書き、書くだけで終わらせず見返して活用できるか。治療豚情報を漏らさないか。","levels":["自己流で書き、治療豚の薬剤名・投与量・開始日を記入せず休薬管理を抜けさせる。","指示があれば共通ルールで書くが、活用や治療豚情報の記入に漏れがある。","指示があれば共通ルールに沿ってひと通り記入できる。","指示がなくても共通ルールで書き、治療豚情報を漏らさず、記録を見返して活用する。","記録の共有と活用の意義を理解し、共通ルールと活用方法を新人に指導できる。"]},{"id":"headcount-balance","name":"頭数変動の検算","kanten":"前日頭数＋入舎−転出−死亡−出荷（淘汰を含む）＝当日頭数の式で検算し、合わないとき当日中に原因を調べられるか。","levels":["頭数変動を書かず、計算が合わなくても気にせず放置する。","指示があれば頭数を書くが、検算をせず、不一致も他者に指摘されるまで気づかない。","指示があれば式で検算し、合わないことに自分で気づける。","指示がなくても毎日検算し、合わないときは当日中に記入漏れ・数え間違いなどの原因を調べる。","先延ばしが原因特定を難しくすると理解し、検算と当日中の原因調査を新人に指導できる。"]},{"id":"detail-findings","name":"死亡・異常の具体的な記述","kanten":"死亡・異常を「死亡1頭」で済ませず、場所・番号・時間・症状まで具体的に書けるか。","levels":["死亡や異常があっても書かない、または「特に問題なし」で済ませて放置する。","指示があれば書くが、「なんか具合が悪そう」式のあいまいな表現が多く項目に抜けがある。","指示があれば場所・個体番号・時間・症状をひと通り具体的に書ける。","指示がなくても推定体重や外見の様子まで書き、残餌増加などの小さな気づきも記録する。","記述が後の原因究明の手がかりになると理解し、具体的な書き方を新人に指導できる。"]},{"id":"trend-report","name":"前日比較と急変の報告","kanten":"前日までの日報と数字を比べ、死亡や治療頭数の急変・設備不具合を上長へ報告できるか。","levels":["過去の日報と比べず、死亡数が急に増えても気づかず報告もしない。","指示があれば比べるが、急変の見落としが多く、報告するかは他者まかせ。","指示があれば前日までの数字と比べ、急に変わった項目を報告できる。","指示がなくても毎日比較し、急変や設備不具合を報告した相手まで日報に残す。","週ごとの推移を見て対策につなげる意義を理解し、比較と報告の要点を新人に指導できる。"]}]},{"id":"plate","no":"No.07","name":"プレート作成","cat":"記録管理","aspects":[{"id":"update","name":"最新状態への更新と旧プレート処理","kanten":"情報を最新に保ち、分娩後の作成忘れや、差し替え時の古いプレートの残存を防げるか。","levels":["分娩後に作成し忘れ、差し替え時も古いプレートを廃棄せず誤情報を残す。","指示があれば更新するが、作成忘れや旧プレート処理に漏れがある。","指示があれば情報をひと通り最新に更新できる。","指示がなくても分娩後すぐ作成し、差し替え時は古いプレートを確実に廃棄する。","情報の鮮度が個体管理に直結すると理解し、更新と旧プレート処理を新人に指導できる。"]},{"id":"readable","name":"誰にでも分かる表記・色分けルールの遵守","kanten":"誰が見ても分かる表記にし、農場の色分け・略語ルールに従い、自分の判断で色や略語を作らないか。","levels":["担当者ごとに書式が異なり、自分の判断で色や略語を作って後任者が判読できない。","指示があれば書くが、表記の統一や色分けルールの適用に漏れがある。","指示があれば決められた書式と色分けルールに沿ってひと通り作成できる。","指示がなくても誰でも分かる統一表記で書き、迷う略語は勝手に作らず指導係に確認する。","表記統一の意義を理解し、分かりやすいプレート作成を新人に指導できる。"]},{"id":"source-copy","name":"記録を見ながらの転記と読み合わせ","kanten":"記憶で書かず日報・治療記録・母豚カードを見て写し、書いた後に数字を指差しで照合できるか。","levels":["記憶だけで書いて番号や日付を間違え、照合もせず放置する。","指示があれば記録を見て写すが、読み合わせを省きがちで間違いに気づかない。","指示があれば記録を見ながら写し、書いた後に数字を1つずつ照合できる。","指示がなくても必ず記録を見て転記し、食い違いはその場で直すか上司に報告する。","転記ミスが作業ミスにつながると理解し、記録を見て写す習慣と照合を新人に指導できる。"]},{"id":"withdrawal-card","name":"治療カードの休薬情報記入","kanten":"治療カードに薬剤名・休薬期間・出荷可能日まで書き切り、治療中と目立たせられるか。","levels":["治療カードを作らない、または休薬情報を書かず、休薬中の豚を見分けられなくする。","指示があれば書くが、出荷可能日の記入漏れや目立たせ方の不足が多い。","指示があれば症状・薬剤名・休薬期間・出荷可能日までひと通り書ける。","指示がなくても休薬が明ける日付まで必ず書き切り、治療中と一目で分かるよう目立たせる。","休薬情報が食の安全に直結すると理解し、治療カードの書き方を新人に指導できる。"]},{"id":"attach-safety","name":"取り付け位置と誤飲防止","kanten":"通路側から読め汚れにくい高さに付け、タイの切れ端やペンのキャップを豚房に落とさないか。","levels":["豚がかじれる位置に付けたり、切れ端を豚房に落としたりしても気にしない。","指示があれば付けるが、高さや向きにムラがあり、切れ端の回収も他者まかせ。","指示があれば通路側から読める高さに付け、切れ端やキャップを回収できる。","指示がなくても読みやすく汚れにくい位置を選び、豚が飲み込む物を残さないか確かめる。","誤飲の危険と読みやすさの両立を理解し、安全な取り付け方を新人に指導できる。"]}]},{"id":"tagging","no":"No.21","name":"タグ付け","cat":"記録管理","aspects":[{"id":"position-asepsis","name":"正しい位置と装着前消毒","kanten":"決められた位置・向きに正しく付け、装着前に器具と耳を消毒できるか。","levels":["装着位置・向きが不統一で読み取りにくく、器具・耳の消毒もしない。","指示があれば付けるが、位置の統一や消毒に漏れがある。","指示があれば決められた位置に、消毒してひと通り装着できる。","指示がなくても位置・向きを統一し、装着前に器具と耳を消毒する。","読み取りやすさと感染防止を理解し、正しい装着と消毒を新人に指導できる。"]},{"id":"reattach","name":"脱落・破損時の再装着","kanten":"脱落・破損を見つけ次第付け直し、個体不明のまま管理を続けないか。","levels":["タグ付け忘れや脱落後の再装着をせず、個体不明のまま出荷しトレーサビリティを断つ。","指示があれば付け直すが、脱落の発見や再装着に漏れがある。","指示があれば脱落・破損をひと通り付け直せる。","指示がなくても脱落・破損を見つけ次第付け直し、個体不明を作らない。","トレーサビリティの重要性を理解し、脱落時の再装着徹底を新人に指導できる。"]},{"id":"number-prep","name":"番号順の準備と頭数照合","kanten":"タグを番号順にそろえ、腹の子豚の頭数と番号を数えて飛び・重複に装着前に気づけるか。","levels":["タグを数えず用意し、番号の飛びや重複に気づかないまま装着する。","指示があれば並べるが、頭数との照合を省きがちで間違いを他者に指摘される。","指示があれば番号順に並べ、頭数と番号が合っているか装着前に確認できる。","指示がなくても予備を含めて準備し、飛び・重複を装着前に見つけて対処する。","番号の乱れが記録の混乱を招くと理解し、準備と照合の手順を新人に指導できる。"]},{"id":"restraint-attach","name":"保定と一回での確実な装着","kanten":"子豚をしっかり保定し、プライヤーを一気に握り込んで番号が読める状態に装着できるか。","levels":["保定が不十分なまま装着し、途中で止まったタグや読めないタグを放置する。","指示があれば装着するが、握りが中途半端で留まりのムラが多く、確認は他者まかせ。","指示があれば保定して一気に装着し、確実に留まって番号が読めるか確認できる。","指示がなくても確実に装着し、保定が難しいときは自分から先輩と2人で行う。","暴れによる位置ズレやけがの防止を理解し、保定と装着のコツを新人に指導できる。"]},{"id":"record-observe","name":"その場記録と装着後の観察","kanten":"装着直後に個体番号・装着日・母豚番号をメモし、24〜48時間は耳の腫れと哺乳を確認できるか。","levels":["記録を残さず、装着後の耳の腫れや哺乳の様子も見ない。","指示があれば記録するが、後からまとめて記憶で書き、装着後の確認も抜けが多い。","指示があればその場でメモし、日報に正確に書き写し、装着後の見回りで耳を確認できる。","指示がなくてもその場で記録して見直し、腫れ・化膿や哺乳不良に気づけば報告する。","番号間違いが休薬管理をずらす危険を理解し、その場記録と観察を新人に指導できる。"]}]},{"id":"farrow-schedule","no":"No.32","name":"分娩予定記入","cat":"記録管理","aspects":[{"id":"calc","name":"妊娠日齢の統一計算","kanten":"妊娠日齢の数え方を統一し、交配日から114〜115日後を正確に計算できるか。","levels":["交配日の記録が抜け、日齢の数え方も不統一で分娩予定を計算できない。","指示があれば計算するが、数え方の統一や幅の考慮に漏れがある。","指示があれば交配日から予定日をひと通り計算できる。","指示がなくても統一した数え方で114〜115日後を正確に計算する。","計算のズレが準備に与える影響を理解し、統一した数え方を新人に指導できる。"]},{"id":"rewrite","name":"再交配時の書き直しと母豚観察","kanten":"交配・再交配のたびに書き直し、予定日だけで判断せず母豚の様子も確認できるか。","levels":["再交配時に修正記入を忘れ、予定日だけで判断して母豚の様子を見ない。","指示があれば書き直すが、修正漏れや観察不足がある。","指示があれば交配・再交配のたびにひと通り書き直せる。","指示がなくても再交配時に必ず書き直し、母豚の様子も合わせて確認する。","書き直し漏れがスケジュール混乱を招くと理解し、記入と観察の徹底を新人に指導できる。"]},{"id":"date-verify","name":"カレンダーでの日付再確認","kanten":"計算した日付をカレンダーで指さし確認し、月またぎなどの1日ズレを防げるか。","levels":["計算しっぱなしで確認せず、月またぎの1日ズレに気づかず放置する。","指示があれば確認するが、指さし確認を省きがちでズレの見落としがある。","指示があればカレンダーで指さしして再確認し、早見表があれば優先して使える。","指示がなくても月またぎや31日がない月を意識して再確認し、ズレはその場で直す。","1日のズレが分娩準備を狂わせると理解し、再確認のやり方を新人に指導できる。"]},{"id":"board-plan","name":"予定表への記入と週単位の見える化","kanten":"予定表に母豚番号と予定日を書き、週ごとの分娩頭数と分娩舎への移動日まで見えるようにできるか。","levels":["母豚カードにしか書かず、予定表への記入も移動日の逆算もしない。","指示があれば予定表に書くが、記入漏れが多く週ごとの頭数が読み取れない。","指示があれば予定表に母豚番号と予定日を書き、移動日を逆算して記入できる。","指示がなくても週ごとの頭数が見える形に整え、移動日が休日や大きな作業と重ならないか確かめる。","週の頭数が舎と人手の計画の土台と理解し、予定表の作り方を新人に指導できる。"]},{"id":"check-count","name":"鑑定日の記入と頭数突き合わせ","kanten":"再発情チェック・妊娠鑑定の日も予定表に書き、母豚カードと予定表の頭数を数えて突き合わせられるか。","levels":["鑑定日を書かず、頭数の突き合わせもせず、書きもれ・消しもれを放置する。","指示があれば書くが、鑑定日の記入や頭数照合に抜けが多く、不一致も他者まかせ。","指示があれば再発情チェック・妊娠鑑定の日を記入し、頭数を数えて突き合わせできる。","指示がなくても両方の頭数を合うまで確認し、不一致の原因（書きもれ・消しもれ）を自分で見つけて直す。","不受胎の早期発見につながる仕組みと理解し、鑑定日記入と突き合わせを新人に指導できる。"]}]},{"id":"cull-ship","no":"No.22","name":"廃豚出荷（母豚出し）","cat":"出荷管理","aspects":[{"id":"cull-select","name":"リスト照合とマーキング","kanten":"廃豚リストと耳標番号を上長と照合し、対象豚に見分けやすくマーキングして取り違えを防げるか。","levels":["リストと耳標を照合せずマーキングも曖昧で、対象外の豚と取り違えても気づかない。","指示があれば照合・マーキングするが、耳標の読み違いや印の不明瞭さが残り、確認は他者まかせ。","指示があればリストと耳標を1頭ずつ突き合わせ、背中に大きくはっきりマーキングできる。","指示がなくても上長とリストを確認してから照合・マーキングし、番号の不一致に気づけばその場で確かめる。","取り違え・誤出荷が起きやすい場面を理解し、照合とマーキングの手順を新人に指導できる。"]},{"id":"welfare-law","name":"歩様確認と法令遵守","kanten":"歩けない・立てない豚は出荷せず、出荷前に体調・歩様を確認し、絶食時も水を止めないか。","levels":["歩けない豚を出荷し、体調・歩様の確認も絶食時の給水も怠る。","指示があれば確認するが、歩様の見極めや給水管理に漏れがある。","指示があれば体調・歩様をひと通り確認して出荷できる。","指示がなくても歩けない豚を除外し、絶食時も水を止めずに安全に出荷する。","と畜場法・輸送指針を理解し、アニマルウェルフェアに配慮した出荷を新人に指導できる。"]},{"id":"withdrawal-double","name":"休薬期間のダブルチェック","kanten":"投薬記録を正本に、全対象豚の休薬期間経過を2人でダブルチェックし、「たぶん大丈夫」で出さないか。","levels":["投薬記録を見ずに「たぶん大丈夫」で出荷しようとし、休薬期間中の豚が混ざっても気づかない。","指示があれば記録を見るが、確認が1人だけになったり対象豚の一部を見落としたりする。","指示があれば投薬記録に基づき、全対象豚の休薬期間経過を2人で確認できる。","指示がなくてもダブルチェックを徹底し、記憶で決めず、疑わしい豚はその場で上長に確認して出荷から外す。","休薬期間中の出荷が法律違反であることを理解し、記録に基づくダブルチェックの方法を新人に指導できる。"]},{"id":"fast-notify","name":"絶食開始と通路・積み込み場所の準備","kanten":"前日夕方の給餌停止で絶食を始め（目安は出荷12〜18時間前）、通路と積み込み場所の清掃・障害物や滑る場所の確認まで準備できるか。","levels":["絶食を始めず満腹のまま出荷させようとし、通路の準備もせずに豚を通す。","指示があれば準備するが、絶食開始の時期がずれたり、通路の障害物や滑る場所を見落としたりする。","指示があれば前日夕方に給餌を止め、通路と積み込み場所を清掃して仕切り板・追い込み板を用意できる。","指示がなくても出荷12〜18時間前を目安に絶食を管理し、通路を自分で歩いて滑りやすい所がないか確かめてから作業に入る。","絶食が輸送中の糞尿を減らし処理をスムーズにする理由を理解し、出荷前日の準備を新人に指導できる。"]},{"id":"load-verify-disinfect","name":"積み込み・頭数照合と出荷後消毒","kanten":"追い込み板で静かに積み込み、頭数・耳標を出荷伝票と照合して記録し、車両が触れた場所を消毒できるか。","levels":["豚を追い回して積み込み、頭数照合も出荷後の消毒もせず放置する。","指示があれば積み込むが、伝票との照合や車両が触れた場所の消毒に抜けが多い。","指示があれば静かに積み込み、頭数・耳標を伝票と照合し、通路と積み込み場所を消毒できる。","指示がなくても照合の不一致をその場で解消してから出発させ、記録と車両接触部の消毒まで自分で完結する。","出荷トラックが病気を持ち込むリスクを理解し、積み込みから消毒までの流れを新人に指導できる。"]}]},{"id":"cull-move","no":"No.23","name":"育成舎へ廃豚移動","cat":"出荷管理","aspects":[{"id":"move-pre-check","name":"移動前の照合と歩様確認","kanten":"耳標をリストと照合し、1頭ずつ立たせて歩様を見て、歩けない・呼吸が荒い豚を移動から外し報告できるか。","levels":["照合も歩様確認もせずに追い始め、歩けない豚を無理に動かして放置する。","指示があれば確認するが、耳標の照合や歩様の見極めに漏れがあり、報告は他者まかせ。","指示があればリストと1頭ずつ照合し、歩様を確認して異常な豚を移動から外し報告できる。","指示がなくても移動前の確認を徹底し、治療中・休薬期間中の豚が混ざっていないかも指導係と確認する。","歩けない豚を動かす危険と出荷できない理由を理解し、移動前確認のやり方を新人に指導できる。"]},{"id":"route-setup","name":"移動ルートと受け入れ豚房の準備","kanten":"受け入れ豚房の空きと給水を確かめ、扉・ゲートで一本道を作り、通路の障害物・滑る場所を先に片付けられるか。","levels":["準備をせずに追い始め、豚が抜け出したり滑って転んだりしても気にしない。","指示があれば準備するが、扉の閉め忘れや滑る場所の見落としが多い。","指示があれば扉・ゲートを先に全部セットし、障害物と滑る場所を片付けてから豚を通せる。","指示がなくても受け入れ豚房の空きと給水まで確かめ、ルートを自分で歩いて危険箇所を先に直す。","転倒・脱走が起きやすい箇所を理解し、ルート準備の段取りを新人に指導できる。"]},{"id":"drive-safety","name":"追い板の使い方と自身の安全確保","kanten":"追い板で後ろ斜めから3〜5頭ずつ静かに追い、興奮したら待ち、自分の逃げ道を常に確保できるか。","levels":["叩く・大声・追い回しで豚を暴れさせ、壁際に立って挟まれそうになっても気づかない。","指示があれば追い板を使うが、一度に動かす頭数が多すぎたり、立ち位置が危なかったりする。","指示があれば3〜5頭ずつ静かに追い、逃げ道を確保した立ち位置で移動できる。","指示がなくても豚が興奮したら無理せず10〜15分待って再開し、突進には追い板を盾にして安全によける。","豚の視界をさえぎって方向をつくる原理を理解し、安全な追い方を新人に指導できる。"]},{"id":"isolation-move","name":"他群との接触回避（隔離）","kanten":"廃豚を他群と接触させず、柵ごしに鼻が触れ合わない空き豚房を選び、感染を広げない移動ができるか。","levels":["他群と鼻が触れ合う豚房に平気で入れ、廃豚を他の群のそばに置いても気にしない。","指示があれば他群から離すが、柵ごしの鼻の接触までは意識が回らない。","指示があれば他の豚と柵ごしに鼻が触れ合わない空き豚房を選び、他群と接触させずに移動できる。","指示がなくても移動の時間帯（夕方〜夜はけんかが減る）など農場の決まりを確かめて動き、接触の恐れがあれば先に指導係に相談する。","柵ごしの接触や共用通路の糞が感染拡大のもとになることを理解し、廃豚の隔離の考え方を新人に指導できる。"]},{"id":"finish-record-disinfect","name":"収容後の確認・記録と消毒","kanten":"扉を確実に閉めて給水を確かめ、耳標・頭数をその場で記録し、通路清掃と追い板・長靴の消毒までできるか。","levels":["扉や給水を確かめず、記録も残さず、通路の糞や使った追い板もそのまま放置する。","指示があれば行うが、ニップル給水の確認や消毒に抜けが多く、記録も後回しにする。","指示があれば扉・給水を確認し、耳標・頭数をその場で記録し、追い板と長靴を消毒できる。","指示がなくても記録をリストと照合して数を合わせ、通路の清掃・消毒までを移動作業の一部として完結する。","廃豚から他群へ病気が広がる経路を理解し、収容後の確認から消毒までの流れを新人に指導できる。"]}]},{"id":"body-measure","no":"","name":"体測","cat":"出荷管理","aspects":[{"id":"scale-prep","name":"体重計の設置とゼロ点・道具の準備","kanten":"体重計（台秤）を平らな場所に置いてゼロ点を確かめ、追い板・記録用紙・マーキングスプレーをそろえてから測り始められるか。","levels":["体重計を傾いた場所に置き、ゼロ点も見ず道具も不足したまま測り始める。","指示があれば設置するが、ゼロ点の確認や道具のそろえ忘れが多く、校正は他者まかせ。","指示があれば平らな場所に設置してゼロ点を確認し、追い板・記録用紙・スプレーをそろえて測り始められる。","指示がなくても測る前に設置場所とゼロ点を確かめ、道具を整え、校正が必要そうなら上長に伝える。","体重計がずれると出荷判断や増体の計算まで狂うことを理解し、設置とゼロ点確認の手順を新人に指導できる。"]},{"id":"calm-handling","name":"豚の誘導と扱い（ストレス・けが防止）","kanten":"追い板で静かに誘導し、追い回さず無理に押し込まずに体重計へ乗せ、豚にも自分にもけがをさせず測れるか。","levels":["大声で追い回し、無理に押し込んで豚を興奮させ、豚や自分にけがをさせかねない扱いをする。","指示があれば静かに誘導するが、焦ると追い回したり押し込んだりして、通路や追い板の使い方にムラがある。","指示があれば追い板で誘導し、体重計に静かに乗せて、落ち着いてから測り、静かに出せる。","指示がなくても豚が興奮したら一度待ち、通路の障害物を除いて、豚にも自分にもけがが出ない位置で誘導する。","体重測定が豚にとってストレスであることを理解し、静かに扱うコツと安全な立ち位置を新人に指導できる。"]},{"id":"weigh-estimate","name":"計測と推定メジャー・目視推定の使い分け","kanten":"動かなくなってから体重計の数値を読み、体重計がない時は胸囲と体長のメジャーによる推定を目安として使い分けられるか。","levels":["豚が動いている最中に数値を読み、体重計があっても目視だけで決めて、推定値を正確な体重のように扱う。","指示があれば測るが、読むタイミングがばらつき、推定メジャーの当て方も不確か。","指示があれば豚が動かなくなったところで数値を読み、体重計がなければ胸囲と体長を測って目安の体重を出せる。","指示がなくても測る前に目視で体重を予想して実測と比べ、メジャー推定はあくまで目安として出荷の最終判断には体重計の値を使う。","目視・メジャー推定・実測の精度の違いを理解し、使い分けと目視推定の上達のコツを新人に指導できる。"]},{"id":"ship-judge","name":"出荷適期の判定（休薬確認と選別）","kanten":"出荷候補の豚について投薬記録で休薬期間が完了しているかを確かめ、測った体重を出荷適体重110〜120kgなどの基準に当てはめて、出荷候補・軽量豚・重量豚に分けて上長に報告できるか。","levels":["投薬記録も体重の基準も確かめず、休薬期間中の豚や足りない豚も区別せず、自分だけで決めて出荷に回す。","指示があれば投薬記録を見て基準と比べるが、休薬期間の確認や軽量豚・重量豚の見落としが多く、報告も他者まかせ。","指示があれば投薬記録で休薬期間の完了を確かめて、完了していない豚を出荷候補から外し、110〜120kgを出荷候補、90kg未満（同日齢比較）を軽量豚、120kg超を重量豚に分け、結果を報告できる。","指示がなくても出荷候補の休薬期間を投薬記録でダブルチェックし、休薬期間が確認できない豚は出荷しない。契約や出荷先の基準も確認して選別し、軽量豚は別管理と原因確認、重量豚は優先出荷を上長へ提案し、足りない豚の出荷は相談する。","休薬期間中の豚を出荷すると法律違反になり農場全体の出荷停止につながること、軽すぎても重すぎても減額や脂肪過多になることを理解し、休薬確認と選別の考え方を新人に指導できる。"]},{"id":"record-variance","name":"記録と群のばらつき・遅れ豚の確認","kanten":"体重を記録し、群内のばらつきを見て、小さい豚の原因（病気・寄生虫・いじめ・採食）を確かめられるか。","levels":["記録を残さず、群に小さい豚がいても気にせず、体重のばらつきも見ない。","指示があれば記録するが、記入漏れが多く、小さい豚がいても原因まで見ない。","指示があれば体重を記録し、群内のばらつきを確認して、極端に小さい豚を報告できる。","指示がなくても測定後すぐ記録し、小さい豚は病気・寄生虫・いじめ・エサに届いていないかを確かめ、跛行などの異常があれば報告する。","記録が増体の計算と出荷計画の土台であることを理解し、記入とばらつき確認の見方を新人に指導できる。"]}]},{"id":"ship-fin","no":"","name":"出荷","cat":"出荷管理","aspects":[{"id":"ship-criteria-plan","name":"出荷基準の確認と1週間前からの準備","kanten":"体重110〜120kg（契約による）・170〜180日齢（目安）・休薬確認の開始（7日前）・歩行可能で重い外傷がないという出荷基準を確かめ、7日前の候補選定から前日の最終選別までの段取りに沿って動けるか。","levels":["基準を確かめず見た目だけで出荷候補を決め、段取りも知らないまま前日や当日になって慌てる。","指示があれば基準を見て候補を挙げるが、日齢や外傷の確認が抜け、7日前・3日前などの段取りは他者まかせ。","指示があれば体重・日齢・健康状態・外傷を基準と照らして候補を選び、7日前の選定、3日前の最終確認、前日の最終選別の流れに沿って動ける。","指示がなくても基準を満たすか自分で確かめて候補を選び、段取りの各日に何をするか把握して、頭数の確定や業者連絡が必要な時期を上長に伝える。","基準が契約や出荷先で変わること、準備が遅れると出荷が乱れることを理解し、1週間前からの段取りを新人に指導できる。"]},{"id":"ship-withdrawal-confirm","name":"投薬記録での休薬完了の確認と逆算","kanten":"出荷予定日から逆算し、注射・飼料添加・飲水投与を含む投薬記録（獣医師の指示書がある場合はその休薬期間）で全対象豚の休薬期間の完了を確かめ、出荷当日朝に2人でダブルチェックし、確認できない豚は出荷せず上長に確認できるか。","levels":["投薬記録を見ずに出荷する豚を決め、休薬期間中の豚が混ざっていても気づかない。","指示があれば投薬記録を見るが、一部の豚や薬剤の確認が抜け、確認は1人だけで済ませる。","指示があれば出荷7日前から確認を始めて出荷予定日から休薬期間を逆算し、投薬記録で全対象豚の休薬完了を確かめ、当日朝にもう一度確認できる。","指示がなくても出荷予定の豚に投薬が必要になったらその場で休薬終了日を出して出荷予定日と比べ、かかる場合は出荷日の変更を上長に相談し、出荷予定日と休薬終了日を豚房に表示し、当日朝は2人でダブルチェックして、記録を正本に、休薬の完了が確認できない豚は出荷せず、その場で上長に確認して出荷から外す。","休薬期間中の出荷が法律違反で農場全体の出荷停止につながることを理解し、逆算カレンダーの使い方とダブルチェックの方法を新人に指導できる。"]},{"id":"ship-eve-prep","name":"前日の準備（絶食・マーキング・通路）と当日朝の歩様確認","kanten":"前日に最終選別した豚へ見分けやすくマーキングし、前日夕方から給餌を止め（当日朝も与えず）、水は止めず、出荷通路を清掃して障害物を除き、当日朝に歩けない豚や具合の悪い豚を外せるか。","levels":["マーキングも通路の準備もせず、水まで止めてしまい、歩けない豚も出荷に回す。","指示があれば準備するが、マーキングが不明瞭だったり通路の障害物を見落としたりし、歩様の確認は他者まかせ。","指示があれば前日に対象豚へはっきりマーキングし、前日夕方から給餌を止め（当日朝も与えず）水は出し続け、通路を清掃し、当日朝に歩様・呼吸・外観を確認できる。","指示がなくても水を止めないことを確かめ、通路を自分で見て回って障害物を除き、当日朝に歩けない豚や明らかに具合が悪い豚を出荷から外して上長に伝える。","絶食の目的と、脱水が肉質低下と動物福祉の問題になることを理解し、前日の準備と当日朝の確認を新人に指導できる。"]},{"id":"ship-calm-loading","name":"静かな誘導と積み込み（肉質と事故の防止）","kanten":"追い板で豚の視界を限りながら静かにゆっくり誘導し、1回に3〜5頭ずつ、滑り止めを確かめたスロープで転倒や挟まれを防いで積み込め、夏は早朝、冬は凍結に気を配れるか。","levels":["追い回し、叩き、多頭数を一度に押し込んで、転倒や挟まれが起きても気にしない。","指示があれば追い板で誘導するが、焦ると追い回したり多頭数を一度に動かしたりし、スロープの滑りやすさを見落とす。","指示があれば追い板で静かに誘導し、1回に3〜5頭ずつ、滑り止めを確かめたスロープから転倒や挟まれに注意して積み込める。","指示がなくても豚のペースに合わせ、興奮した豚がいれば待ち、電気ショッカーは最小限にとどめる。夏は早朝・車内の換気、冬は凍結箇所の滑り止めまで気を配る。","追い回しや暑熱のストレスがPSE肉、長いストレスがDFD肉につながることを理解し、静かな積み込みのコツを新人に指導できる。"]},{"id":"ship-count-record","name":"頭数の照合・出荷伝票と出荷記録・残留個体の確認","kanten":"積み込んだ頭数を数えて出荷伝票と照合し、頭数・農場名・日付を記入し、出荷先・オス・メスの内訳・体重・運搬車の情報・体調に不安のある個体を出荷記録に残し、出荷後の豚房に残った豚がいないか確かめられる、出荷後に積み込み場所と通路を清掃・消毒できるか。","levels":["頭数を数えず伝票も記録も残さず、出荷後の豚房も見ないまま作業を終える。","指示があれば数えて記入するが、伝票との不一致や記録項目の抜けが多く、出荷後の豚房の確認を忘れる。","指示があれば積み込んだ頭数を伝票と照合し、頭数・農場名・日付を記入して出荷記録に必要な項目（日付・出荷先・頭数・体重・運搬業者と車両番号）を残し、出荷後に豚房に残った豚がいないか確かめ、積み込み場所と通路を清掃・消毒できる。","指示がなくても不一致はその場で原因を確かめてから出発させ、オス・メスの内訳や体調に不安のある個体の特記事項まで記録し、日報にも記入して積み込み場所の外縁部にトラックを留め農場の奥まで入れないよう気を配り、残留個体なしを自分で確認する。","投薬記録と出荷記録の両方がそろって休薬の証拠になり、残留個体がいると頭数が合わなくなることを理解し、照合と記録の書き方を新人に指導できる。"]}]}],"presets":[{"id":"stall-house","name":"ストール舎","works":["sow-vaccine","standing-check","feeding-daily","preg-check"]},{"id":"farrowing-house","name":"分娩舎","works":["sow-vaccine","castration","farrow-assist","disinfect"]},{"id":"nursery-house","name":"子豚舎","works":["five-s","treatment","disinfect","carcass"]},{"id":"finishing-house","name":"肥育舎","works":["feeding-daily","feed-adjust-fin","disinfect","five-s"]},{"id":"ai-house","name":"AI舎","works":["disinfect","five-s","semen-check","semen-mix"]}]};
const ASPECT_SHEET = '種目';
const PERSON_SHEET = '受験者別（自動）';
const FARMSUM_SHEET = '農場別（自動）';
const PERSON_KEY = 'HSS_PERSON_TAB_ID';
const ASPECT_KEY = 'HSS_ASPECT_TAB_ID';
const FARMSUM_KEY = 'HSS_FARM_TAB_ID';
const PERSON_AUTO_MAX_ROWS = 20000;   // 評価者タブの合計行がこれを超えたら、submit・delete では作り直さない（op=persons だけ）
const ASPECT_HEAD = ['作業No', '作業名', '作業ID', '種目ID', '種目名', '観点', 'Lv1', 'Lv2', 'Lv3', 'Lv4', 'Lv5', '反映'];
const ASPECT_NOTE = '使い方\n' +
  '・種目名・観点・Lv1〜Lv5 の文を直し、右端の「反映」にチェックを入れる\n' +
  '・反映にチェックした行のうち、原文と違う欄だけがアプリに出る（空欄・原文と同じ欄は変わらない）\n' +
  '・種目は5つ固定。ID（作業ID・種目ID）は変えない。行の追加・削除はしない\n' +
  '・元に戻すには、原文を貼り直すか、チェックを外す';

function setup() {
  const ss = SpreadsheetApp.getActive();
  let ws = ss.getSheetByName(WORKS_SHEET) || ss.insertSheet(WORKS_SHEET);
  ws.clear();
  ws.getRange(1, 1, 1, 3).setValues([['No', '作業名', 'カテゴリ']]).setFontWeight('bold');
  ws.getRange(2, 1, WORKS.length, 3).setValues(WORKS);
  ws.setFrozenRows(1);
  ws.autoResizeColumns(1, 3);

  let rs = ss.getSheetByName(ROSTER_SHEET);
  if (!rs) {
    rs = ss.insertSheet(ROSTER_SHEET, 0);
    const head = ['農場', '被評価者'];
    for (let i = 1; i <= ROSTER_MAX_WORKS; i++) head.push('作業' + i);
    head.push('旧名');
    rs.getRange(1, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#e6f2ee');
    rs.setFrozenRows(1);
    rs.setColumnWidth(1, 110);
    rs.setColumnWidth(2, 180);
  }
  // 名簿の初期データ（Seed.js＝git管理外。社員名を公開リポジトリに置かないため）。受験者タブが空のときだけ入れる
  const c0 = rosterCols_(rs);
  if (typeof ROSTER_SEED !== 'undefined' && rs.getLastRow() < 2 && ROSTER_SEED.length && c0.farm === 0 && c0.name === 1) {
    const w = rs.getLastColumn();
    rs.getRange(2, 1, ROSTER_SEED.length, w).setValues(ROSTER_SEED.map(r => { const a = r.slice(0, w); while (a.length < w) a.push(''); return a; }));
  }
  // 作業列（見出し「作業1」〜「作業N」）だけにプルダウン。「作業メモ」など備考の列にはかけない（前の版でかけた分は外す）
  const cols = rosterCols_(rs);
  const rule = SpreadsheetApp.newDataValidation()
    .requireValueInRange(ws.getRange(2, 2, WORKS.length, 1), true)
    .setAllowInvalid(false).build();
  cols.works.forEach(c => rs.getRange(2, c + 1, 300, 1).setDataValidation(rule));
  cols.loose.forEach(c => rs.getRange(2, c + 1, 300, 1).setDataValidation(null));
  // 農場のプルダウン（正本=農場一覧タブ。無い・空の時だけ、名簿の初期データ→受験者タブにある農場＋所属未確定で作る）
  if (cols.farm >= 0) {
    const fs = farmsSheet_(rs, cols);
    const frule = SpreadsheetApp.newDataValidation()
      .requireValueInRange(fs.getRange(2, 1, 200, 1), true)
      .setAllowInvalid(false).build();
    rs.getRange(2, cols.farm + 1, 300, 1).setDataValidation(frule);
  }
  rs.getRange(1, cols.name + 1).setNote(ROSTER_NOTE);
  buildSummary_(true);   // 集計タブ（全評価者タブを1本の式で並べる）を作る・作り直す
  ensureAspectSheet_();   // 種目タブ（編集済みの行は上書きしない・無い種目だけ末尾に追記）
  try { updatePersonTabs_(true, false); } catch (err) { /* 受験者別・農場別が作れなくても setup は成功 */ }
  return 'setup OK';
}
function farmsSheet_(rs, cols) {
  const ss = SpreadsheetApp.getActive();
  let fs = ss.getSheetByName(FARMS_SHEET);
  if (!fs) fs = ss.insertSheet(FARMS_SHEET);
  if (fs.getLastRow() >= 2) return fs;   // 管理者が直した一覧は上書きしない
  fs.getRange(1, 1, 1, 1).setValues([['農場']]).setFontWeight('bold').setBackground('#e6f2ee');
  fs.setFrozenRows(1);
  const names = [];
  const add = v => { const f = String(v || '').trim(); if (f && f !== UNASSIGNED && names.indexOf(f) < 0) names.push(f); };
  if (typeof ROSTER_SEED !== 'undefined' && ROSTER_SEED.length) ROSTER_SEED.forEach(r => add(r[0]));
  else if (rs.getLastRow() >= 2) rs.getRange(2, cols.farm + 1, rs.getLastRow() - 1, 1).getDisplayValues().forEach(r => add(r[0]));
  names.push(UNASSIGNED);
  fs.getRange(2, 1, names.length, 1).setValues(names.map(f => [f]));
  return fs;
}

function doGet(e) {
  const action = (e && e.parameter && e.parameter.action) || 'ping';
  if (action === 'roster') {
    if (!authOk_(e.parameter.k)) return json_({ ok: false, version: CODE_VERSION, capabilities: API_CAPABILITIES, error: 'auth' });
    // 受験者タブが無い（名前の変更・取り違え）のと、タブはあるが空なのを区別する（アプリは前回の名簿を残す）
    const roster = readRoster_();
    if (!roster) return json_({ ok: false, version: CODE_VERSION, capabilities: API_CAPABILITIES, error: 'no roster sheet' });
    const res = { ok: true, version: CODE_VERSION, capabilities: API_CAPABILITIES, roster: roster };
    try { res.done = readDone_(); } catch (err) { /* 要約が読めなくても名簿は返す（アプリはこの端末の記録だけで数える） */ }
    try { res.aspects = readAspectOverrides_(); } catch (err) { /* 種目タブが読めなければ aspects を付けない（アプリは前回の上書きを保つ） */ }
    return json_(res);
  }
  if (action === 'admin') return admin_(e);
  return json_({ ok: true, version: CODE_VERSION, capabilities: API_CAPABILITIES });
}

/* 管理用の入口: GET ?action=admin&token=… で setup() を実行し、（農場共通）行を足りない農場だけ補う。
   ADMIN_TOKEN と COMMON_SEED（[[農場, [作業名…]], …]）は git 管理外の Seed.js にだけ置く。無ければこの入口は常に拒否 */
function admin_(e) {
  const tok = String((e && e.parameter && e.parameter.token) || '');
  const adm = secret_('ADMIN_TOKEN');
  if (TENANT_MODE && !adm.prop) return json_({ ok: false, error: 'forbidden' });   // テナント版: プロパティ未設定・例外は拒否
  if (adm.v.length < (adm.prop ? MIN_ADMIN.prop : MIN_ADMIN.seed)) return json_({ ok: false, error: 'forbidden' });
  if (tok !== adm.v) { noteFail_(); return json_({ ok: false, error: 'forbidden' }); }
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return json_({ ok: false, error: 'busy' });
  try {
    if (e.parameter.op === 'check') return json_({ ok: true, version: CODE_VERSION, check: checkSummary_(), authFails: failCount_() });   // 読むだけ（集計タブの式の結果を検算）
    if (e.parameter.op === 'persons') return json_({ ok: true, version: CODE_VERSION, persons: updatePersonTabs_(true, false) });   // setup せず受験者別・農場別だけ更新
    if (e.parameter.op === 'narrow' && e.parameter.dry === '1') return json_({ ok: true, version: CODE_VERSION, narrow: narrowRows_(false) });   // 書かずに結果だけ返す
    const r = setup();
    // op=narrow: 個人別の作業を区分メモの区分名1つに置き換える（2026-11-09 試験区分の絞り込み）。元の作業は控えタブに残す
    if (e.parameter.op === 'narrow') return json_({ ok: true, version: CODE_VERSION, setup: r, narrow: narrowRows_(true), persons: updatePersonTabs_(true, false) });
    // op=common: 既存の（農場共通）行の作業も COMMON_SEED に置き換える（試験区分の変更用）。置き換え前の作業を応答で返す（共通行に人の名前は無い）
    if (e.parameter.op === 'common') {
      const rep = typeof COMMON_SEED !== 'undefined' ? setCommonRows_(COMMON_SEED) : [];
      return json_({ ok: true, version: CODE_VERSION, setup: r, commonReplaced: rep, commonAdded: typeof COMMON_SEED !== 'undefined' ? addCommonRows_(COMMON_SEED) : [] });
    }
    const added = typeof COMMON_SEED !== 'undefined' ? addCommonRows_(COMMON_SEED) : [];
    return json_({ ok: true, version: CODE_VERSION, setup: r, commonAdded: added, check: checkSummary_() });
  } finally {
    lock.releaseLock();
  }
}
/* 2026-11-09 受験者タブの K 列（区分メモ）→ 試験区分名。ここに無いメモ（フリー等）の人は変えない */
const NARROW_SHEET = '作業割当の控え';
const NARROW_MAP = { 'ストール': 'ストール舎', 'ストール舎': 'ストール舎', '分娩舎': '分娩舎', '子豚舎': '子豚舎', '肥育': '肥育舎', '肥育舎': '肥育舎', 'AI舎': 'AI舎', 'AI': 'AI舎' };
/* 作業が入っている人の行を、区分メモの区分名1つ（作業1）にする。作業2以降は空。実施済みの記録には触らない。
   apply=false は書かない。書く前に元の作業を控えタブへ1行ずつ残す。すでに区分名だけの行は数えるだけ（2回実行しても控えは増えない） */
function narrowRows_(apply) {
  const ss = SpreadsheetApp.getActive(), rs = ss.getSheetByName(ROSTER_SHEET);
  if (!rs || rs.getLastRow() < 2) return { error: 'no-roster' };
  const c = rosterCols_(rs), w = rs.getLastColumn();
  if (c.farm < 0 || !c.works.length) return { error: 'no-columns' };
  const head = rs.getRange(1, 1, 1, w).getDisplayValues()[0].map(v => String(v || '').normalize('NFKC').trim());
  let mc = head.findIndex(h => /^区分/.test(h));
  if (mc < 0 && w > c.works[c.works.length - 1] + 1 && !head[c.works[c.works.length - 1] + 1]) mc = c.works[c.works.length - 1] + 1;   // 見出しの無いメモ列（作業8の右隣）
  if (mc < 0) return { error: 'no-memo-column', head: head };
  const vals = rs.getRange(2, 1, rs.getLastRow() - 1, w).getDisplayValues();
  const out = { memoCol: mc + 1, changed: {}, already: 0, empty: 0, skipped: [] };
  const todo = [];
  vals.forEach((r, i) => {
    const name = String(r[c.name] || '').trim();
    if (!name || isCommonName_(name)) return;
    const works = c.works.map(k => String(r[k] || '').trim()).filter(Boolean);
    if (!works.length) { out.empty++; return; }
    const memo = String(r[mc] || '').normalize('NFKC').trim(), pr = NARROW_MAP[memo];
    if (!pr || !resolveWorkCell_(pr)) { out.skipped.push({ row: i + 2, name: name, farm: r[c.farm], memo: memo, works: works.length }); return; }
    if (works.length === 1 && works[0] === pr) { out.already++; return; }
    out.changed[pr] = (out.changed[pr] || 0) + 1;
    todo.push({ row: i + 2, pr: pr, r: r, works: c.works.map(k => r[k]) });
  });
  if (!apply || !todo.length) return out;
  let bk = ss.getSheetByName(NARROW_SHEET);
  if (!bk) { bk = ss.insertSheet(NARROW_SHEET); bk.getRange(1, 1, 1, 4 + c.works.length).setValues([['控えた日時', '行', '農場', '被評価者'].concat(c.works.map((_, j) => '作業' + (j + 1)))]); }
  const at = new Date().toISOString();
  todo.forEach(t => bk.getRange(bk.getLastRow() + 1, 1, 1, 4 + t.works.length).setValues([[at, t.row, t.r[c.farm], t.r[c.name]].concat(t.works.map(v => "'" + v))]));
  todo.forEach(t => c.works.forEach((k, j) => rs.getRange(t.row, k + 1, 1, 1).setValues([[j === 0 ? t.pr : '']])));
  return out;
}
/* （農場共通）行の名前か。アプリの isCommonRow（js/sync.js）と同じ: 全角半角・空白をそろえ、括弧の種類（【】［］など）は問わない */
function isCommonName_(v) {
  const s = String(v || '').normalize('NFKC').replace(/\s+/g, '');
  return s.replace(/[\[\]（）()【】〔〕［］「」『』<>＜＞{}]/g, '') === '農場共通';
}
/* 既存の（農場共通）行のうち、seed にある農場の行の作業列を seed の作業に置き換える（人の行・seed に無い農場の行は触らない）。
   戻り値 [{farm, before:[作業…], after:[作業…]}] */
function setCommonRows_(seed) {
  const rs = SpreadsheetApp.getActive().getSheetByName(ROSTER_SHEET);
  if (!rs || rs.getLastRow() < 2) return [];
  const c = rosterCols_(rs);
  if (c.farm < 0 || !c.works.length) return [];
  const nf = v => String(v || '').normalize('NFKC').replace(/\s+/g, '');
  const want = {};
  (seed || []).forEach(([farm, works]) => {
    if (!farm) return;
    const a = (works || []).slice(0, c.works.length);
    if ((works || []).length > a.length) a.cut = works.slice(a.length);   // 作業列が足りず入らない作業（応答で知らせる）
    want[nf(farm)] = a;
  });
  const w = rs.getLastColumn(), vals = rs.getRange(2, 1, rs.getLastRow() - 1, w).getDisplayValues(), out = [];
  vals.forEach((r, i) => {
    if (!isCommonName_(r[c.name])) return;
    const nw = want[nf(r[c.farm])];
    if (!nw) return;
    const before = c.works.map(k => String(r[k] || '').trim()).filter(Boolean);
    c.works.forEach((k, j) => rs.getRange(i + 2, k + 1, 1, 1).setValues([[nw[j] || '']]));
    out.push({ farm: r[c.farm], before: before, after: nw, ...(want[nf(r[c.farm])].cut ? { cut: want[nf(r[c.farm])].cut } : {}) });
  });
  return out;
}
/* （農場共通）行が無い農場にだけ追記する（既存の行・人の行は触らない）。追記した農場名を返す */
function addCommonRows_(seed) {
  const rs = SpreadsheetApp.getActive().getSheetByName(ROSTER_SHEET);
  if (!rs) return [];
  const c = rosterCols_(rs);
  if (c.farm < 0) return [];
  const nf = v => String(v || '').normalize('NFKC').replace(/\s+/g, '');
  const has = new Set();
  if (rs.getLastRow() > 1) {
    const w = rs.getLastColumn();
    rs.getRange(2, 1, rs.getLastRow() - 1, w).getDisplayValues().forEach(r => {
      if (isCommonName_(r[c.name])) has.add(nf(r[c.farm]));
    });
  }
  const w = rs.getLastColumn(), out = [];
  (seed || []).forEach(([farm, works]) => {
    if (!farm || has.has(nf(farm))) return;
    const row = new Array(w).fill('');
    row[c.farm] = farm; row[c.name] = '（農場共通）';
    (works || []).slice(0, c.works.length).forEach((wk, i) => { row[c.works[i]] = wk; });
    rs.getRange(rs.getLastRow() + 1, 1, 1, w).setValues([row]);
    has.add(nf(farm)); out.push(farm);
  });
  return out;
}

function doPost(e) {
  let body;
  try { body = JSON.parse(e.postData.contents); } catch (err) { return json_({ ok: false, error: 'bad json' }); }
  const action = body && body.action;
  if (action !== 'submit' && action !== 'delete') return json_({ ok: false, error: 'unknown action' });
  if (!authOk_(body.k)) return json_({ ok: false, error: 'auth' });
  const isDelete = action === 'delete';
  if (!isDelete && !(body.record && typeof body.record === 'object')) return json_({ ok: false, error: 'no record' });
  if (isDelete && !cleanId_(body.id)) return json_({ ok: false, error: 'no id' });
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return json_({ ok: false, error: 'busy' });
  try {
    if (isDelete) {
      const id = cleanId_(body.id);
      // 戻した（revive）後に、戻すより前に出された削除が遅れて届いた: その削除は古い＝戻した行を消さない。
      // 「前に出された」＝削除の合図が戻しの合図と違い、かつ削除を出した時刻（at）が戻した時刻（rvAt）より前。
      // 戻した後に出された削除（別の端末・別の流れでも）は消す
      const rr = String(PropertiesService.getDocumentProperties().getProperty(REV_KEY + id) || '').split('|'), lastRev = rr[0] || '', lastAt = rr[1] || '';
      const dtok = String(body.rv || '').replace(/[^\w\-]/g, ''), dat = String(body.at || '');
      if (lastRev && dtok !== lastRev && dat && lastAt && dat < lastAt) return json_({ ok: true, id: String(body.id), deleted: 0, staleDelete: true });
      const del = deleteRecord_(id, '削除');
      // 削除の印（墓標 '~del:'+合図の一覧）: 削除の後に遅れて届いた同じ記録の送信で、行を生き返らせない。
      // 合図（rv）＝端末がその記録を「戻した」ときに付けるランダムな値。削除はその時点の合図を持ってくる＝その合図の送信はもう通さない。
      // 時刻は使わない（端末どうしの時計のずれで判定を誤らない）。合図は増えるだけ（古い削除が後から届いても、殺した合図は消えない）
      try {
        const pp = PropertiesService.getDocumentProperties();
        const dead = String(pp.getProperty(DEAD_KEY + id) || '').split(',').filter(Boolean);   // 殺した合図は別のキーに残し続ける（戻しが成功して墓標が外れても消えない）
        const tok = String(body.rv || '').replace(/[^\w\-]/g, '');
        if (tok && dead.indexOf(tok) < 0) { dead.push(tok); pp.setProperty(DEAD_KEY + id, dead.slice(-200).join(',')); }
        pp.deleteProperty(REV_KEY + id);
        pp.setProperty(VER_KEY + id, '~del');
      } catch (err) { /* 印が書けなくても削除は成功 */ }
      try { updatePersonTabs_(false, true); } catch (err) { /* 受験者別・農場別が更新できなくても削除の応答は変えない */ }
      return json_({ ok: true, id: String(body.id), deleted: del });
    }
    // 版（端末の更新時刻）: シートに新しい版が既にあれば、古い版（古いバックアップの復元・遅れて届いた再送）で上書きしない
    const rid = cleanId_(body.record.id), ver = String(body.record.ver || ''), props = PropertiesService.getDocumentProperties();
    const have = rid ? String(props.getProperty(VER_KEY + rid) || '') : '';
    // 削除済みの記録は書かない（遅れて届いた再送で生き返らせない）。
    // 書き戻すのは、端末が削除より後にバックアップから「戻した」記録（revive と、墓標の rv より新しい戻した時刻 rv）だけ
    const tomb = /^~del/.test(have), tok = String(body.record.rv || '').replace(/[^\w\-]/g, '');
    const dead = rid ? String(props.getProperty(DEAD_KEY + rid) || '').split(',').filter(Boolean) : [];
    // 殺した合図の戻しは、墓標の有無に関係なく通さない（削除の後に遅れて届いた戻しの送信）
    if (body.record.revive === true && tok && dead.indexOf(tok) >= 0) return json_({ ok: true, id: String(body.record.id), rows: 0, stale: 'deleted' });
    if (tomb && !(body.record.revive === true && tok)) return json_({ ok: true, id: String(body.record.id), rows: 0, stale: 'deleted' });
    if (ver && have && !tomb && have > ver) return json_({ ok: true, id: String(body.record.id), rows: 0, stale: true, sheetVer: have });
    const n = writeRecord_(body.record);
    if (rid) { if (ver) props.setProperty(VER_KEY + rid, ver); else props.deleteProperty(VER_KEY + rid); }
    if (rid && body.record.revive === true && tok) props.setProperty(REV_KEY + rid, tok + '|' + String(body.record.rvAt || ''));   // 戻した合図を控える（これより前に出された削除を見分ける）   // 版の無い送信でも墓標は外す（書いた行と印を食い違わせない）
    let dups = [];
    try { dups = findDups_(body.record); } catch (err) { /* 重複の確認に失敗しても書き込みは成功 */ }
    try { updatePersonTabs_(false, true); } catch (err) { /* 受験者別・農場別が更新できなくても書き込みの応答は変えない */ }
    return json_({ ok: true, id: String(body.record.id), rows: n, dups: dups });
  } catch (err) {
    return json_({ ok: false, error: String(err && err.message || err) });
  } finally {
    lock.releaseLock();
  }
}

/* 見出し行から列を決める。「被評価者」「農場」「作業1〜作業N」「旧名/別名」。見出しが無い旧形式は A=被評価者・B以降=作業
   作業列は見出しが「作業」+数字の列だけ（全角数字・空白も可）。「作業メモ」などは読まない（loose=プルダウンを外す列） */
function rosterCols_(rs) {
  const w = Math.max(2, rs.getLastColumn());
  const head = rs.getRange(1, 1, 1, w).getDisplayValues()[0].map(v => String(v || '').normalize('NFKC').trim());
  const name = head.indexOf('被評価者');
  if (name < 0) return { name: 0, farm: -1, alias: -1, works: head.map((_, i) => i).filter(i => i > 0), loose: [] };
  const isWork = h => /^作業\s*\d+$/.test(h);
  return {
    name: name, farm: head.indexOf('農場'),
    alias: head.findIndex(h => /^(旧名|別名)/.test(h)),
    works: head.map((h, i) => isWork(h) ? i : -1).filter(i => i >= 0),
    loose: head.map((h, i) => /^作業/.test(h) && !isWork(h) ? i : -1).filter(i => i >= 0),
  };
}
function readRoster_() {
  const rs = SpreadsheetApp.getActive().getSheetByName(ROSTER_SHEET);
  if (!rs) return null;
  if (rs.getLastRow() < 2) return [];
  const cols = rosterCols_(rs);
  const vals = rs.getRange(2, 1, rs.getLastRow() - 1, Math.max(2, rs.getLastColumn())).getDisplayValues();
  const out = [];
  vals.forEach(r => {
    const name = String(r[cols.name] || '').trim();
    if (!name) return;
    const farm = cols.farm >= 0 ? String(r[cols.farm] || '').trim() : '';
    const works = cols.works.map(i => String(r[i] || '').trim()).filter(Boolean);
    const o = { name: name, farm: farm, works: works };
    if (cols.alias >= 0) {
      const al = String(r[cols.alias] || '').split(/[、,，\/／;；\n]/).map(v => v.trim()).filter(v => v && v !== name);
      if (al.length) o.aliases = al;
    }
    out.push(o);
  });
  return out;
}

/* 評価者タブ（台帳に載ったタブ）の記録を記録IDごとに要約する＝どの端末で採点しても「済・途中・残り」を同じに数える（Z19-3）。
   返すのは 記録ID・評価日・被評価者・農場・作業名だけ（点数・コメント・所感・評価者名は返さない） */
function ymd_(v) {
  if (v instanceof Date) return Utilities.formatDate(v, 'Asia/Tokyo', 'yyyy-MM-dd');
  const m = /^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/.exec(String(v || '').replace(/^'/, '').trim());
  return m ? m[1] + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[3]).slice(-2) : '';
}
function readDone_() {
  const ss = SpreadsheetApp.getActive();
  const ids = evalTabIds_(ss), byId = {}, out = [];
  ss.getSheets().forEach(sh => {
    const nm = sh.getName();
    if (isReserved_(nm) || sh.getLastRow() < 2) return;
    if (ids.indexOf(String(sh.getSheetId())) < 0) return;
    if (String(sh.getRange(1, 1).getValues()[0][0]) !== HEAD[0]) return;
    const rows = sh.getRange(2, 1, sh.getLastRow() - 1, HEAD.length).getValues();
    rows.forEach(r => {
      const id = String(r[0] || '').trim(), wn = String(r[6] || '').replace(/^'/, '').trim();
      if (!id || !wn) return;
      let o = byId[id];
      if (!o) {
        o = byId[id] = { id: id, date: ymd_(r[1]), name: String(r[3] || '').replace(/^'/, '').trim(), farm: String(r[4] || '').replace(/^'/, '').trim(), works: [] };
        out.push(o);
      }
      if (o.works.indexOf(wn) < 0) o.works.push(wn);
    });
  });
  return out.filter(o => o.name && o.date);
}

/* シート名に使えない文字を置換・予約タブ名と衝突させない */
function sheetNameFor_(evaluator) {
  let s = String(evaluator || '').replace(/[\[\]\*\?\/\\:]/g, '_').replace(/^'+|'+$/g, '').trim().slice(0, 90);
  if (!s) s = '評価者不明';
  if (isReserved_(s) || s === SUMMARY_SHEET) s = '評価者_' + s;   // 受験者・作業一覧・農場一覧・削除ログ・集計の名前は使わない
  return s;
}
/* 数式インジェクション対策（=,+,-,@ で始まる文字列は先頭に ' ） */
function safe_(v) {
  if (v == null) return '';
  const s = String(v).slice(0, 5000);
  return /^[=+\-@\t\r]/.test(s) ? "'" + s : s;
}
function avg_(arr) {
  const v = arr.filter(x => typeof x === 'number' && isFinite(x));
  return v.length ? Math.round(v.reduce((a, b) => a + b, 0) / v.length * 100) / 100 : '';
}

function cleanId_(v) { return String(v || '').replace(/[^a-zA-Z0-9_\-]/g, '_'); }
/* 評価者タブの目印＝GAS が作ったタブの sheetId の台帳（文書プロパティ）。
   A1=記録ID だけで決めると、管理者が複製したタブ・値を貼った控え・集計タブ（A1 に見出しを出す式）まで
   「評価者タブ」とみなして再送・削除のたびに行を消してしまう（G17-1）。複製タブは sheetId が変わるので台帳に載らない。
   台帳がまだ無い時（この版を入れた直後・文書を複製した時）だけ、見出し14列が HEAD と一致し式でないタブを登録する（移行） */
const EVAL_TABS_KEY = 'HSS_EVAL_TAB_IDS';
function isReserved_(nm) { return nm === NARROW_SHEET || nm === ROSTER_SHEET ||nm === WORKS_SHEET || nm === FARMS_SHEET || nm === DELLOG_SHEET || nm === ASPECT_SHEET || nm === PERSON_SHEET || nm === FARMSUM_SHEET; }
function isEvalHead_(sh) {
  if (sh.getLastColumn() < HEAD_BASE.length) return false;
  const rg = sh.getRange(1, 1, 1, HEAD_BASE.length);
  const v = rg.getValues()[0], f = rg.getFormulas()[0];
  return HEAD_BASE.every((h, i) => String(v[i]) === h && !f[i]);
}
function evalTabIds_(ss) {
  const props = PropertiesService.getDocumentProperties();
  const raw = props.getProperty(EVAL_TABS_KEY);
  let ids = null;
  if (raw) { try { const a = JSON.parse(raw); if (Array.isArray(a)) ids = a.map(String); } catch (e) { ids = null; } }
  if (!ids) {
    // 移行: 前の版の GAS が作った評価者タブを登録する。名前が「〜のコピー」「Copy of 〜」のタブ（Sheets の複製）は除く
    ids = ss.getSheets().filter(sh => {
      const nm = sh.getName();
      return !isReserved_(nm) && !/(の)?コピー(\s*\d+)?$|^Copy of /i.test(nm) && isEvalHead_(sh);
    }).map(sh => String(sh.getSheetId()));
    props.setProperty(EVAL_TABS_KEY, JSON.stringify(ids));
  }
  return ids;
}
function addEvalTab_(ss, sh) {
  const ids = evalTabIds_(ss);
  const id = String(sh.getSheetId());
  if (ids.indexOf(id) >= 0) return;
  const live = {};
  ss.getSheets().forEach(s => { live[String(s.getSheetId())] = 1; });
  const next = ids.filter(x => live[x]).concat([id]);   // 消されたタブの番号は捨てる
  PropertiesService.getDocumentProperties().setProperty(EVAL_TABS_KEY, JSON.stringify(next));
}
function isEvalTab_(ss, sh) { return evalTabIds_(ss).indexOf(String(sh.getSheetId())) >= 0; }

/* 記録IDの行を、評価者タブ（台帳に載ったタブ）すべてから消す。評価者名が変わった記録も取りこぼさない。
   複製・控え・集計のタブは台帳に無いので触らない */
/* keep(row)=true の行はログに写さない（同じ内容の再送で削除ログを膨らませない） */
function deleteRecord_(id, why, keep) {
  let n = 0;
  const logRows = [];
  const ss = SpreadsheetApp.getActive();
  const ids = evalTabIds_(ss);
  ss.getSheets().forEach(sh => {
    const nm = sh.getName();
    if (isReserved_(nm) || sh.getLastRow() < 2) return;
    if (ids.indexOf(String(sh.getSheetId())) < 0) return;
    if (String(sh.getRange(1, 1).getValues()[0][0]) !== HEAD[0]) return;   // 見出しを消された台帳のタブも触らない
    const rows = sh.getRange(2, 1, sh.getLastRow() - 1, 1).getValues();
    const w = Math.min(sh.getLastColumn(), HEAD.length);
    for (let i = rows.length - 1; i >= 0; i--) if (String(rows[i][0]) === id) {
      const v = sh.getRange(i + 2, 1, 1, w).getValues()[0];
      while (v.length < HEAD.length) v.push('');
      for (let j = 0; j < v.length; j++) if (typeof v[j] === 'string') v[j] = safe_(v[j]);   // getValues は先頭の ' を落とす＝写す時にもう一度付ける（数式として動かさない）
      if (!(keep && keep(v))) logRows.push([Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd HH:mm:ss'), why || '', nm].concat(v));
      sh.deleteRow(i + 2); n++;
    }
  });
  if (logRows.length) { try { delLog_(ss, logRows.reverse()); } catch (err) { /* ログが書けなくても削除は続ける */ } }
  return n;
}

function writeRecord_(rec) {
  const id = cleanId_(rec.id);
  if (!id) throw new Error('no id');
  const ss = SpreadsheetApp.getActive();
  // 同じ記録IDの既存行を、全ての評価者タブから消す（編集・再送で重複させない。
  // 評価者名の表記を直した端末から編集して送り直しても、前の評価者タブに古い行を残さない）
  // 同じ内容（作業・種目・点・コメント・所感・やり直し元が同じ）の行は再送なのでログに残さない
  const sameKey_ = r => [r[3], r[4], r[6], r[7], r[8] === '' ? '' : Number(r[8]), r[9], r[12], r[14]].map(String).join('\u0001');
  const newKeys = {};
  (Array.isArray(rec.works) ? rec.works.slice(0, 50) : []).forEach(w => (Array.isArray(w.items) ? w.items.slice(0, 20) : []).forEach(it => {
    const n = it.score == null || it.score === '' ? NaN : Number(it.score), sc = n >= 1 && n <= 5 ? n : '';
    newKeys[sameKey_([id, '', '', safe_(rec.evaluatee), safe_(rec.farm), '', safe_(w.workName), safe_(it.aspect), sc, safe_(it.comment), '', '', safe_(rec.overall), '', cleanIds_(rec.redoOf)])] = 1;
  }));
  deleteRecord_(id, '上書き', v => !!newKeys[sameKey_(v)]);
  const base = sheetNameFor_(rec.evaluator);
  let name = base, sh = ss.getSheetByName(name);
  // 同じ名前のタブが評価者タブでない時（管理者が作った別のタブ）は書き込まない＝「〜_記録」「〜_記録2」…へ
  for (let k = 1; sh && !isEvalTab_(ss, sh); k++) {
    if (isEvalHead_(sh)) { addEvalTab_(ss, sh); break; }   // 台帳から漏れた評価者タブ（見出し一致）は登録し直す
    name = base.slice(0, 85) + '_記録' + (k > 1 ? k : '');
    sh = ss.getSheetByName(name);
  }
  let added = false;
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.getRange(1, 1, 1, HEAD.length).setValues([HEAD]).setFontWeight('bold').setBackground('#e6f2ee');
    sh.setFrozenRows(1);
    addEvalTab_(ss, sh);
    added = true;
  } else if (String(sh.getRange(1, HEAD.length).getValues()[0][0]) !== HEAD[HEAD.length - 1]) {
    sh.getRange(1, HEAD.length).setValues([[HEAD[HEAD.length - 1]]]).setFontWeight('bold').setBackground('#e6f2ee');   // 前の版で作ったタブに「やり直し元」の見出し
  }
  const works = Array.isArray(rec.works) ? rec.works.slice(0, 50) : [];
  const allScores = [];
  const sc_ = v => { const n = v == null || v === '' ? NaN : Number(v); return n >= 1 && n <= 5 ? n : NaN; };   // 空欄（null）を0点にしない
  works.forEach(w => (w.items || []).forEach(it => allScores.push(sc_(it.score))));
  const sessAvg = avg_(allScores);
  const redoOf = cleanIds_(rec.redoOf);
  const now = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd HH:mm:ss');
  const rows = [];
  works.forEach(w => {
    const items = Array.isArray(w.items) ? w.items.slice(0, 20) : [];
    const wAvg = avg_(items.map(it => sc_(it.score)));
    items.forEach(it => {
      const sc = sc_(it.score);
      rows.push([id, safe_(rec.date), safe_(rec.evaluator), safe_(rec.evaluatee), safe_(rec.farm), safe_(w.category), safe_(w.workName),
        safe_(it.aspect), (sc >= 1 && sc <= 5) ? sc : '', safe_(it.comment), wAvg, sessAvg, safe_(rec.overall), now, redoOf]);
    });
  });
  if (rows.length) sh.getRange(sh.getLastRow() + 1, 1, rows.length, HEAD.length).setValues(rows);
  if (added) { try { buildSummary_(false); } catch (err) { /* 集計が作れなくても記録の書き込みは成功として返す */ } }   // 新しい評価者タブを集計の式に足す
  return rows.length;
}
function cleanIds_(v) {
  const a = (Array.isArray(v) ? v : String(v == null ? '' : v).split(/[\s,、]+/)).map(cleanId_).filter(x => x && !/^_+$/.test(x));
  return a.filter((x, i) => a.indexOf(x) === i).join(' ');
}

/* ==============================================================
   集計タブ（Z20-2）: 全評価者タブ（台帳に載ったタブ）の行を1本の式で縦に並べ、今の農場とやり直しの採否を足す。
   - A3 = LET+FILTER+CHOOSECOLS（空行を除く＝2人目以降の評価者の行が1000行目あたりに飛ばない）
   - P3 = 今の農場（受験者タブの被評価者 → 農場。見つからなければ旧名の列で「、」区切りの完全一致 → 無ければ記録時の農場）
   - Q3 = 採否（どこかの行の「やり直し元」にこの記録IDがあれば「やり直し前」、それ以外は「採用」）
   式はタブの名前・受験者タブの列の位置から GAS が組む。setup と、GAS が評価者タブを新しく作った時に作り直す。
   作り直すのは GAS 自身が作った集計タブ（文書プロパティ HSS_SUMMARY_TAB_ID）だけ。同じ名前の別タブがあれば触らない
   ============================================================== */
function colL_(i) { let s = '', n = i + 1; while (n > 0) { const m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); } return s; }
function qName_(nm) { return "'" + String(nm).replace(/'/g, "''") + "'"; }
function summaryFormulas_(ss) {
  const ids = evalTabIds_(ss), last = colL_(HEAD.length - 1);
  const tabs = ss.getSheets().filter(sh => ids.indexOf(String(sh.getSheetId())) >= 0 && !isReserved_(sh.getName())).map(sh => sh.getName());
  const out = { tabs: tabs };
  out.data = tabs.length ? '=LET(d,{' + tabs.map(n => qName_(n) + '!A2:' + last).join(';') + '},IFERROR(FILTER(d,CHOOSECOLS(d,1)<>""),""))' : '';
  const rs = ss.getSheetByName(ROSTER_SHEET);
  const c = rs ? rosterCols_(rs) : null;
  const R = ci => qName_(ROSTER_SHEET) + '!$' + colL_(ci) + '$2:$' + colL_(ci);
  let farm = 'e';
  if (c && c.farm >= 0) {
    const alias = c.alias >= 0
      ? 'XLOOKUP(TRUE,ARRAYFORMULA(ISNUMBER(FIND("、"&n&"、","、"&REGEXREPLACE(' + R(c.alias) + '&"","\\s*[、,，/／;；\\n]\\s*","、")&"、"))),' + R(c.farm) + ',e)'
      : 'e';
    // 同じ名前が2農場にいる時に先の行の農場を返さないよう、まず 名前＋記録時の農場 で引く → 名前だけ → 旧名 → 記録時の農場
    // LAMBDA の中では (範囲=n)*(範囲=e) が配列として評価されず全行 #N/A になる（10-06 実シートで確認）→ 配列に強い FILTER で引き、無ければ従来の引き方
    farm = 'IFERROR(INDEX(FILTER(' + R(c.farm) + ',' + R(c.name) + '=n,' + R(c.farm) + '=e),1),XLOOKUP(n,' + R(c.name) + ',' + R(c.farm) + ',' + alias + '))';
  }
  out.farm = '=MAP(D3:D,E3:E,LAMBDA(n,e,IF(n="",,' + farm + ')))';
  out.use = '=MAP(A3:A,LAMBDA(id,IF(id="",,IF(COUNTIF(O3:O,"*"&id&"*"),"やり直し前","採用"))))';
  return out;
}
function buildSummary_(create) {
  const ss = SpreadsheetApp.getActive(), props = PropertiesService.getDocumentProperties();
  let sh = ss.getSheetByName(SUMMARY_SHEET);
  const mine = props.getProperty(SUMMARY_KEY);
  if (sh && String(sh.getSheetId()) !== mine) return 'skip: 同じ名前の別タブ';   // 管理者が作ったタブは触らない
  if (!sh) {
    if (!create) return 'skip: 集計タブなし';   // 消された集計タブは setup の時だけ作り直す
    sh = ss.insertSheet(SUMMARY_SHEET);
    props.setProperty(SUMMARY_KEY, String(sh.getSheetId()));
  }
  const f = summaryFormulas_(ss);
  sh.clear();
  sh.getRange(1, 1).setValues([['集計（自動・手で直さない。setup と評価者タブが増えた時に GAS が作り直す）。採否が「採用」の行だけを数える（やり直し前＝やり直しで置き換わった前回）']]);
  sh.getRange(2, 1, 1, HEAD.length + 2).setValues([HEAD.concat(['今の農場', '採否'])]).setFontWeight('bold').setBackground('#e6f2ee');
  sh.setFrozenRows(2);
  if (f.data) {
    sh.getRange(3, 1).setFormula(f.data);
    sh.getRange(3, HEAD.length + 1).setFormula(f.farm);
    sh.getRange(3, HEAD.length + 2).setFormula(f.use);
  }
  // 日付が数字（シリアル値）に見えないよう、評価日（B）と送信日時（N）に表示の書式を付ける
  const nrow = Math.max(sh.getMaxRows() - 2, 1);
  sh.getRange(3, 2, nrow, 1).setNumberFormat('yyyy-mm-dd');
  sh.getRange(3, 14, nrow, 1).setNumberFormat('yyyy-mm-dd hh:mm:ss');
  return 'summary OK: ' + f.tabs.length + ' tabs';
}

/* 同じ人（被評価者＋農場）・同じ作業を、別の記録（やり直しの関係にない）が採点していれば、その作業名を返す（別の端末の二重採点の検知） */
function findDups_(rec) {
  const id = cleanId_(rec.id), redo = cleanIds_(rec.redoOf).split(' ').filter(Boolean);
  const ss = SpreadsheetApp.getActive(), ids = evalTabIds_(ss);
  const works = {}; (Array.isArray(rec.works) ? rec.works : []).forEach(w => { works[String(w.workName || '')] = 1; });
  // 名前・農場はアプリと同じそろえ方（全角空白・連続空白・全角半角）。日付は前後14日以内だけ（前回の試験・練習の記録で誤って警告しない）
  const nk = v => String(v == null ? '' : v).normalize('NFC').replace(/[\s\u3000]+/g, ' ').trim(), nf = v => String(v || '').normalize('NFKC').replace(/\s+/g, '');
  const dn = v => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(v instanceof Date ? Utilities.formatDate(v, 'Asia/Tokyo', 'yyyy-MM-dd') : String(v || '')); return m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) / 864e5 : NaN; };
  const ee = nk(rec.evaluatee), farm = nf(rec.farm), d0 = dn(rec.date), out = {}, redoneBy = {};
  const rows = [];
  ss.getSheets().forEach(sh => {
    if (ids.indexOf(String(sh.getSheetId())) < 0 || sh.getLastRow() < 2) return;
    sh.getRange(2, 1, sh.getLastRow() - 1, HEAD.length).getValues().forEach(r => rows.push(r));
  });
  rows.forEach(r => String(r[14] || '').split(/\s+/).filter(Boolean).forEach(x => { redoneBy[x] = 1; }));   // やり直しで置き換わった記録は数えない
  rows.forEach(r => {
    const rid = String(r[0]);
    if (rid === id || redo.indexOf(rid) >= 0 || redoneBy[rid] || redoneBy[id]) return;
    const dd = dn(r[1]);
    if (nk(r[3]) === ee && nf(r[4]) === farm && works[String(r[6])] && !(Math.abs(dd - d0) > 14)) out[String(r[6])] = 1;
  });
  return Object.keys(out);
}
/* 削除・上書きで消える行の控え（日時・理由・元のタブ＋元の15列）。タブが無ければ作る */
function delLog_(ss, rows) {
  let sh = ss.getSheetByName(DELLOG_SHEET);
  if (!sh) {
    sh = ss.insertSheet(DELLOG_SHEET);
    sh.getRange(1, 1, 1, HEAD.length + 3).setValues([['消した日時', '理由', '元のタブ'].concat(HEAD)]).setFontWeight('bold').setBackground('#fdecea');
    sh.setFrozenRows(1);
  }
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, HEAD.length + 3).setValues(rows);
}
/* 集計タブの検算（読むだけ）: 式の結果（P=今の農場・Q=採否）を、同じ規則で GAS 側でも計算して突き合わせる。
   返すのは件数と食い違いの行番号だけ（名前・点数は返さない） */
function checkSummary_() {
  const ss = SpreadsheetApp.getActive(), sh = ss.getSheetByName(SUMMARY_SHEET);
  if (!sh) return { summary: 'none' };
  const n = Math.max(0, sh.getLastRow() - 2), W = HEAD.length + 2;
  const v = n ? sh.getRange(3, 1, n, W).getDisplayValues() : [];
  const P = rosterPeople_(), c = P.c;
  const redo = {};
  v.forEach(r => String(r[14] || '').split(/\s+/).filter(Boolean).forEach(id => { redo[id] = 1; }));
  // 今の農場の期待値は受験者別と同じ人の特定（personOf_）で求める
  const want = r => {
    if (!c || c.farm < 0) return r[4];
    const p = personOf_(r[3], r[4], P);
    return p ? p.farmRaw : r[4];
  };
  const errs = [], farmBad = [], useBad = [];
  let use = 0, before = 0;
  v.forEach((r, i) => {
    if (r.some(x => /^#(N\/A|REF|VALUE|NAME|ERROR|DIV)/.test(String(x)))) errs.push(i + 3);
    if (!r[0]) return;
    if (r[HEAD.length] !== want(r)) farmBad.push(i + 3);
    const u = redo[r[0]] ? 'やり直し前' : '採用';
    if (r[HEAD.length + 1] !== u) useBad.push(i + 3);
    if (u === '採用') use++; else before++;
  });
  return { rows: v.filter(r => r[0]).length, adopted: use, beforeRedo: before, errorRows: errs.slice(0, 20), farmMismatch: farmBad.slice(0, 20), useMismatch: useBad.slice(0, 20),
    errorSample: errs.length ? (() => { const r = v[errs[0] - 3]; const j = r.findIndex(x => /^#/.test(String(x))); return { col: j + 1, value: r[j], note: String(sh.getRange(errs[0], j + 1).getNote() || '') }; })() : null,
    formulaFarm: n ? String(sh.getRange(3, HEAD.length + 1).getFormula()) : '' };
}
/* ==============================================================
   種目タブ（roster.aspects）: 5種目の文言をシートで直す。A〜D=キー（作業No・作業名・作業ID・種目ID）、E=種目名、F=観点、G〜K=Lv1〜Lv5、L=反映（チェックボックス）
   ・反映が TRUE（真偽値のチェックだけ。文字列 "TRUE" は採用しない）の行のうち、空欄でなく、埋め込みカタログの日本語原文と違う欄だけを roster に載せる
   ・種目は (作業ID, 種目ID) で特定する（行の位置・種目名は使わない）
   ============================================================== */
let CAT_IDX_ = null;
function catIdx_() {
  if (CAT_IDX_) return CAT_IDX_;
  const works = CATALOG.works || [], byId = new Map();
  works.forEach(w => { byId.set(w.id, w); });
  CAT_IDX_ = { works: works, byId: byId, presets: CATALOG.presets || [] };
  return CAT_IDX_;
}
function wkey_(v) { return String(v == null ? '' : v).normalize('NFKC').replace(/\s+/g, '').toLowerCase(); }
function nkey_(v) { return String(v == null ? '' : v).normalize('NFC').replace(/[\s　]+/g, ' ').trim(); }
function fkey_(v) { return String(v == null ? '' : v).normalize('NFKC').replace(/\s+/g, ''); }
function catalogAspects_() {
  const out = [];
  catIdx_().works.forEach(w => (w.aspects || []).forEach(a => {
    const lv = (a.levels || []).slice(0, 5); while (lv.length < 5) lv.push('');
    out.push({ w: w.id, a: a.id, no: w.no || '', wName: w.name, name: a.name || '', kanten: a.kanten || '', levels: lv });
  }));
  return out;
}
function ensureAspectSheet_() {
  const ss = SpreadsheetApp.getActive(), list = catalogAspects_();
  let sh = ownedTab_(ss, ASPECT_SHEET, ASPECT_KEY, true);   // 同名の別タブ（管理者が作ったもの・旧評価者タブ）には書かない
  if (!sh) return 0;
  if (sh.getLastRow() < 1 || !sh.getRange(1, 1).getValues()[0][0]) {
    sh.getRange(1, 1, 1, ASPECT_HEAD.length).setValues([ASPECT_HEAD]).setFontWeight('bold').setBackground('#e6f2ee');
    sh.setFrozenRows(1);
  }
  const have = {};
  if (sh.getLastRow() >= 2) sh.getRange(2, 3, sh.getLastRow() - 1, 2).getValues().forEach(r => { have[String(r[0]).trim() + '\u0001' + String(r[1]).trim()] = 1; });
  const add = list.filter(x => !have[x.w + '\u0001' + x.a]).map(x => [x.no, x.wName, x.w, x.a, x.name, x.kanten].concat(x.levels, [false, JSON.stringify([x.name, x.kanten].concat(x.levels))]));
  if (!sh.getRange(1, ASPECT_HEAD.length + 1).getValues()[0][0]) sh.getRange(1, ASPECT_HEAD.length + 1).setValues([['初期値(触らない)']]);
  if (add.length) sh.getRange(sh.getLastRow() + 1, 1, add.length, ASPECT_HEAD.length + 1).setValues(add);   // 既存の行は上書きしない・無い種目だけ末尾へ
  sh.getRange(2, 12, Math.max(sh.getLastRow() - 1, 1), 1).setDataValidation(SpreadsheetApp.newDataValidation().requireCheckbox().build());
  sh.getRange(1, 5).setNote(ASPECT_NOTE);
  try {
    const ps = sh.getProtections(SpreadsheetApp.ProtectionType.RANGE);
    if (!ps || !ps.length) sh.getRange(1, 1, sh.getMaxRows(), 4).protect().setWarningOnly(true).setDescription('キー列（作業No・作業名・作業ID・種目ID）。直さない');
  } catch (err) { /* 保護が付けられなくても続ける */ }
